ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=this_cafeteria;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD
# Leave these blank for local development: Blob upload / Service Bus publish / email
# send all fail soft (log a warning) or are simply not exercised without them, except
# checkout receipts, which require Storage__BlobEndpoint and Communication__SenderAddress.
Azure__ManagedIdentity__ClientId=
Azure__Storage__BlobEndpoint=
Azure__Storage__ReceiptsContainerName=receipts
Azure__ServiceBus__FullyQualifiedNamespace=
Azure__ServiceBus__WalletStatusQueueName=wallet-status
Azure__ServiceBus__OrderProcessingQueueName=order-processing
Azure__Communication__ConnectionString=
Azure__Communication__SenderAddress=
Authentication__AdminEmail=admin@example.local
Authentication__AdminPassword=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=this_cafeteria
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# Ethereum Sepolia CoffeeCoin
Blockchain__Network__NetworkName=Ethereum Sepolia
Blockchain__Network__ChainId=11155111
Blockchain__Network__ChainIdHex=0xaa36a7
Blockchain__Network__RpcUrl=https://ethereum-sepolia-rpc.publicnode.com
Blockchain__Network__CurrencyName=Sepolia ETH
Blockchain__Network__CurrencySymbol=ETH
Blockchain__Network__CurrencyDecimals=18
Blockchain__Network__ExplorerUrl=https://sepolia.etherscan.io/
Blockchain__Network__PaymentTokenContract=0xYOUR_SEPOLIA_ERC20_PAYMENT_TOKEN
Blockchain__Network__CoffeeCoinContract=0xYOUR_SEPOLIA_COFFEECOIN_CONTRACT
Blockchain__Network__MarketplaceWallet=0xYOUR_CAFE_PAYMENT_WALLET
CoffeeCoinOwner__PrivateKey=
