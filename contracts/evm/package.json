    "esbuild": "0.25.12",
    "hardhat": "3.8.0",
    "pg": "^8.22.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "viem": "2.55.5"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@metamask/delegation-abis": "0.11.0",
    "@metamask/delegation-core": "0.2.0",
    "@metamask/delegation-deployments": "0.12.0",
