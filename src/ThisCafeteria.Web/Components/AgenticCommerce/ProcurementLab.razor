@page "/procurement-lab"
@layout StakingLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Application.Services
@using ThisCafeteria.Domain.Entities
@using ThisCafeteria.Web.Services.Blockchain
@inject IAgenticJobService JobService
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject ISmartAccountService SmartAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject IOptions<BlockchainNetworkOptions> ChainOptions
@inject NavigationManager Navigation
@inject ILogger<ProcurementLab> Logger

@* Two states, not one. The lab used to render the full marketing hero —
   protocol list, 44rem headline, full-width robot station — above the console
   for a connected wallet too, which pushed the permission/agent/job panels an
   entire screen down and made a working tool read as a landing page. The hero
   is now the signed-out state only; a connected wallet gets a console header
   (command bar, compact title, the station demoted to a status strip, and the
   KPI rail) and the panels start near the fold.

   Both states are organised around one question — "what do I do now?". The
   page used to answer it nowhere: it was named after protocol layers (authority
   / identity / escrow projection), its only button said "create test mission"
   without saying what a mission is, and its empty states reported absence
   instead of offering the next move. So the spine is now the four-step escrow
   lifecycle, told in plain words and pixel actors (buyer → vault → courier →
   inspector): the hero teaches it before asking for a wallet, .pl-next names
   the single next action for the connected wallet, and .pl-flow keeps the map
   on screen with live counts. Protocol names survive as kickers and fine
   print — they are the credential, not the instruction. *@
<div class="procurement-lab @(IsConnected ? "procurement-lab--console" : "procurement-lab--intro")" data-page-theme-color="#100D0B">
    @* The lab is the ship around the shared GlobalScene, not a replacement for
       it. Transparent observation windows keep the same stars, planets,
       Andromeda, and chain badges alive across navigation. The two clipped
       window layers occasionally carry a crew robot past the hull; the frame
       always paints above them, so the cameo never crosses into the cabin. *@
    <div class="pl-cabin" aria-hidden="true">
        <span class="pl-cabin__window pl-cabin__window--port">
            <span class="pl-cabin__visitor pl-cabin__visitor--port"></span>
        </span>
        <span class="pl-cabin__window pl-cabin__window--starboard">
            <span class="pl-cabin__visitor pl-cabin__visitor--starboard"></span>
        </span>
    </div>

  <div class="procurement-lab__inner">
    @if (!IsConnected)
    {
        @* Hero: what this place does, in one sentence a first-time visitor can
           act on, then the four steps, then the connect action. The protocol
           string used to BE the headline; it is a kicker now. *@
        <section class="pl-hero" aria-labelledby="pl-hero-title">
            <div class="pl-hero__copy">
                <p class="pl-hero__protocols" aria-label="Featuring ERC-4337, ERC-8004, ERC-7683, ERC-8183">
                    <span aria-hidden="true">
                        @{ var protoIdx = 0; }
                        @foreach (var word in ProtocolsText.Split(' '))
                        {
                            <span class="pl-proto__word">
                                @foreach (var ch in word)
                                {
                                    <span class="pl-proto__char" style="--i: @protoIdx;">@ch</span>
                                    protoIdx++;
                                }
                            </span>
                        }
                    </span>
                </p>
                <h1 id="pl-hero-title">Let a robot do the buying.</h1>
                <p class="pl-hero__lede">
                    You post a job, the payment waits in escrow, and it is released only once
                    the delivery is signed off. Four steps, on @SelectedChainAccessor.SelectedChain.ShortName,
                    with test funds.
                </p>
            </div>

            @FlowTrack

            <div class="pl-hero__action">
                <button type="button" class="pl-cta" disabled="@_isConnecting" @onclick="ConnectWalletAsync">
                    @(_isConnecting ? "Connecting…" : "Connect wallet to start")
                </button>
                <p class="pl-hero__action-note">
                    Connecting only proves the address is yours. Nothing is signed, spent or
                    approved until you press a button that says so.
                </p>
                @if (!string.IsNullOrWhiteSpace(_connectError))
                {
                    <p class="pl-hero__connect-error" role="alert">@_connectError</p>
                }
            </div>

            <div class="pl-hero__scene">
                @StationScene
            </div>
        </section>
    }
    else
    {
        @* Just the way back out. The chain name and wallet address used to open
           the console on their own line, but the site header already names the
           chain, the lede names it again, and "Signed in as" in the rail below
           carries the address — three restatements of context nobody asked for
           above the work itself. *@
        <header class="pl-commandbar">
            <nav class="pl-commandbar__nav" aria-label="Account">
                <a href="staking">Yield</a>
                <a href="profile">Profile <span aria-hidden="true">↗</span></a>
            </nav>
        </header>

        <section class="pl-console" aria-labelledby="pl-console-title">
            <div class="pl-console__copy">
                <h1 id="pl-console-title">Procurement lab.</h1>
                <p class="pl-console__lede">Escrowed missions on @SelectedChainAccessor.SelectedChain.ShortName. Test funds only.</p>
            </div>

            @* The station is not decoration here: the buyer reads the installed
               permission, the inspector's controls light up when a job is
               awaiting evaluation. Demoted to a strip beside the copy so it
               stays a status readout rather than a billboard. *@
            <div class="pl-console__station">
                @StationScene
            </div>
        </section>
    }

    @if (IsConnected && _loading)
    {
        <section class="projection-empty projection-empty--loading" role="status"><div class="projection-empty__pulse"></div><p>Loading…</p></section>
    }
    else if (IsConnected)
    {
        @* The whole point of the redesign: exactly one recommended action,
           named in plain words, with what it will do and what it will cost
           spelled out before the wallet opens. Every branch below is one state
           of the escrow lifecycle. *@
        <section class="pl-next @(_isWorking ? "is-working" : null)" aria-labelledby="pl-next-title">
            @{
                var pending = NextActionableJob;
                // The step you are ABOUT to take: one past where the mission currently sits.
                // With no missions at all, that is step 1 — posting one. With missions that are
                // all waiting on someone else, no step is yours, so the badge is dropped.
                var step = pending is not null ? StageNumber(pending.Status) + 1
                    : Jobs?.Any(job => !IsTerminal(job.Status)) == true ? 0
                    : 1;
            }
            <div class="pl-next__actor">
                <span class="pl-sprite @NextSpriteClass" aria-hidden="true"></span>
                @if (step > 0)
                {
                    <span class="pl-next__step">Step @step of 4</span>
                }
            </div>

            <div class="pl-next__copy">
                @if (pending is null && Jobs is { Count: > 0 } && Jobs.All(job => IsTerminal(job.Status)))
                {
                    <h2 id="pl-next-title">All settled.</h2>
                    <p class="pl-next__body">Nothing is waiting on you.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-cta pl-cta--sm" disabled="@_isWorking" @onclick="CreateTestJob">
                            @(_isWorking ? "Waiting for your wallet…" : "Create another mission")
                        </button>
                    </div>
                }
                else if (pending is null && Jobs is { Count: > 0 })
                {
                    var waiting = Jobs.First(job => !IsTerminal(job.Status));
                    <h2 id="pl-next-title">Waiting on the @CounterpartyRole(waiting).</h2>
                    <p class="pl-next__body">Mission @MissionLabel(waiting) comes back to you when they act.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-btn pl-btn--sm pl-btn--ghost" disabled="@_isWorking" @onclick="ReloadJobs">Refresh</button>
                    </div>
                }
                else if (pending is null)
                {
                    <h2 id="pl-next-title">Create your first mission.</h2>
                    <p class="pl-next__body">One signature posts the job. You play all three roles, so you can walk the four steps alone.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-cta pl-cta--sm" disabled="@_isWorking" @onclick="CreateTestJob">
                            @(_isWorking ? "Waiting for your wallet…" : "Create a test mission")
                        </button>
                    </div>
                    <p class="pl-next__note">Test network — no real money.</p>
                }
                else if (pending.Status == "Open")
                {
                    <h2 id="pl-next-title">Fund mission @MissionLabel(pending).</h2>
                    <p class="pl-next__body">10 test tokens go into escrow. Only the inspector's decision moves them out.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-cta pl-cta--sm" disabled="@_isWorking" @onclick="() => FundJob(pending)">
                            @(_isWorking ? "Waiting for your wallet…" : "Fund the escrow")
                        </button>
                    </div>
                    <p class="pl-next__note">Two signatures.</p>
                }
                else if (pending.Status == "Funded")
                {
                    <h2 id="pl-next-title">Deliver mission @MissionLabel(pending).</h2>
                    <p class="pl-next__body">You are the courier. Filing the proof hands the decision to the inspector.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-cta pl-cta--sm" disabled="@_isWorking" @onclick="() => SubmitJob(pending)">
                            @(_isWorking ? "Waiting for your wallet…" : "File the proof")
                        </button>
                    </div>
                }
                else
                {
                    <h2 id="pl-next-title">Review mission @MissionLabel(pending).</h2>
                    <p class="pl-next__body">You are the inspector. Approve pays the courier; reject refunds the buyer.</p>
                    <div class="pl-next__actions">
                        <button type="button" class="pl-cta pl-cta--sm" disabled="@_isWorking" @onclick="() => CompleteJob(pending)">
                            @(_isWorking ? "Waiting for your wallet…" : "Approve & pay")
                        </button>
                        <button type="button" class="pl-btn pl-btn--sm pl-btn--reject" disabled="@_isWorking" @onclick="() => RejectJob(pending)">Reject</button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_activityNote))
                {
                    <p class="pl-next__activity" role="status">@_activityNote</p>
                }
            </div>
        </section>

        @* ── Dashboard ──────────────────────────────────────────────────
           A board, not a briefing. The rail counts what sits on each step,
           the mission list is one row per mission with a pixel progress bar,
           and everything that used to be prose — role addresses, hashes,
           panel introductions — is either a glyph or folded into "details".
           Nothing here is a paragraph you have to read to act. *@
        <ol class="pl-rail" aria-label="Missions by step">
            @foreach (var railStep in Lifecycle)
            {
                var here = Jobs?.Count(job => StageKey(job.Status) == railStep.Key) ?? 0;
                <li class="pl-rail__step @(here > 0 ? "is-occupied" : null)">
                    <span class="pl-sprite pl-sprite--@railStep.Sprite pl-sprite--sm" aria-hidden="true"></span>
                    <span class="pl-rail__label">@railStep.Number. @railStep.Label</span>
                    <span class="pl-rail__count">@here</span>
                </li>
            }
        </ol>

        <section class="pl-panel pl-panel--board" aria-labelledby="pl-board-title">
            <div class="pl-panel__bar">
                <h2 id="pl-board-title">Missions</h2>
                <div class="pl-panel__tools">
                    <span class="pl-panel__count">@(Jobs?.Count ?? 0)</span>
                    <button type="button" class="pl-btn pl-btn--sm pl-btn--ghost" disabled="@_isWorking" @onclick="ReloadJobs">Refresh</button>
                </div>
            </div>

            @if (Jobs is null)
            {
                <p class="pl-panel__empty">Loading…</p>
            }
            else if (!Jobs.Any())
            {
                <p class="pl-panel__empty">
                    <span class="pl-sprite pl-sprite--buyer pl-sprite--sm" aria-hidden="true"></span>
                    None yet.
                </p>
            }
            else
            {
                <div class="mission-list">
                    @foreach (var job in Jobs)
                    {
                        <article class="mission @(IsMyTurn(job) ? "mission--mine" : null)">
                            <span class="pl-sprite pl-sprite--@StageSprite(job.Status)" aria-hidden="true"></span>

                            <div class="mission__top">
                                <span class="mission__num">#@job.JobId.ToString("D4")</span>
                                <span class="mission__state @StatusClass(job.Status)">@ShortStatus(job.Status)</span>
                                <span class="mission__amount" title="Held in escrow">
                                    <img src="images/coffee-coin-pixel.png" alt="" width="16" height="16" />@(job.Budget > 0 ? job.Budget.ToString("0.##") : "—")
                                </span>
                            </div>

                            <div class="mission__bottom">
                                <span class="mission__bar" role="img" aria-label="Step @StageNumber(job.Status) of 4">
                                    @foreach (var barStep in Lifecycle)
                                    {
                                        <span class="mission__seg is-@StepState(job.Status, barStep.Key)"></span>
                                    }
                                </span>
                                <span class="mission__turn @(IsMyTurn(job) ? "is-yours" : null)">@ShortWaiting(job)</span>
                                <details class="mission__more">
                                    <summary>details</summary>
                                    <dl class="mission__roles">
                                        <div>
                                            <dt><span class="pl-sprite pl-sprite--buyer pl-sprite--xs" aria-hidden="true"></span>Buyer</dt>
                                            <dd>
                                                @RoleAddress(job.JobId, "client", job.ClientAddress)
                                                @if (IsMe(job.ClientAddress)) { <span class="mission__you">you</span> }
                                            </dd>
                                        </div>
                                        <div>
                                            <dt><span class="pl-sprite pl-sprite--courier pl-sprite--xs" aria-hidden="true"></span>Courier</dt>
                                            <dd>
                                                @RoleAddress(job.JobId, "provider", job.ProviderAddress)
                                                @if (IsMe(job.ProviderAddress)) { <span class="mission__you">you</span> }
                                            </dd>
                                        </div>
                                        <div>
                                            <dt><span class="pl-sprite pl-sprite--inspector pl-sprite--xs" aria-hidden="true"></span>Inspector</dt>
                                            <dd>
                                                @RoleAddress(job.JobId, "evaluator", job.EvaluatorAddress)
                                                @if (IsMe(job.EvaluatorAddress)) { <span class="mission__you">you</span> }
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>Chain</dt>
                                            <dd>@job.ChainKey</dd>
                                        </div>
                                        <div>
                                            <dt>Updated</dt>
                                            <dd>@job.UpdatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</dd>
                                        </div>
                                        <div>
                                            <dt title="Hash of the job description, recorded on-chain">Fingerprint</dt>
                                            <dd>
                                                @if (string.IsNullOrWhiteSpace(job.DescriptionCommitment))
                                                {
                                                    <code>not recorded</code>
                                                }
                                                else
                                                {
                                                    <button type="button" class="pl-copy @(_copiedKey == $"job-{job.JobId}-commit" ? "is-copied" : null)" title="Copy @job.DescriptionCommitment" @onclick='() => Copy($"job-{job.JobId}-commit", job.DescriptionCommitment)'><code>@ShortCommitment(job.DescriptionCommitment)</code><span class="pl-copy__flag">Copied</span></button>
                                                }
                                            </dd>
                                        </div>
                                    </dl>
                                </details>
                            </div>

                            <div class="mission__act">
                                @if (job.Status == "Open" && IsMe(job.ClientAddress))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--fund" disabled="@_isWorking" @onclick="() => FundJob(job)">Fund</button>
                                    @if (CanAgentFund(job))
                                    {
                                        <span class="pl-sprite pl-sprite--key pl-sprite--xs" title="A robot holds a key scoped to this escrow" aria-label="A robot holds a key scoped to this escrow"></span>
                                    }
                                }
                                @if (job.Status == "Funded" && IsMe(job.ProviderAddress))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--submit" disabled="@_isWorking" @onclick="() => SubmitJob(job)">Deliver</button>
                                }
                                @if (job.Status == "Submitted" && IsMe(job.EvaluatorAddress))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--complete" disabled="@_isWorking" @onclick="() => CompleteJob(job)">Pay</button>
                                    <button class="pl-btn pl-btn--sm pl-btn--reject" disabled="@_isWorking" @onclick="() => RejectJob(job)">Refund</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="pl-dash-row">
            <section class="pl-panel" aria-labelledby="pl-robots-title">
                <div class="pl-panel__bar">
                    <h2 id="pl-robots-title">Robots</h2>
                    <span class="pl-panel__count">@(Agents?.Count ?? 0)</span>
                </div>
                @if (Agents is null)
                {
                    <p class="pl-panel__empty">Loading…</p>
                }
                else if (!Agents.Any())
                {
                    <p class="pl-panel__empty">
                        <span class="pl-sprite pl-sprite--scout pl-sprite--sm" aria-hidden="true"></span>
                        None registered — you can play every role yourself.
                    </p>
                }
                else
                {
                    <ul class="robot-grid">
                        @foreach (var agent in Agents)
                        {
                            <li class="robot-chip @(agent.IsActive ? "is-active" : null)">
                                <span class="pl-sprite pl-sprite--scout pl-sprite--sm" aria-hidden="true"></span>
                                <strong>#@agent.AgentId</strong>
                                <button type="button" class="pl-copy @(_copiedKey == $"agent-{agent.AgentId}" ? "is-copied" : null)" title="Copy @agent.OwnerAddress" @onclick='() => Copy($"agent-{agent.AgentId}", agent.OwnerAddress)'>@ShortAddress(agent.OwnerAddress)<span class="pl-copy__flag">Copied</span></button>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* Optional feature, so it gets a chip, not a chapter: the key sprite
               plus one short line per state. *@
            <section class="pl-panel" aria-labelledby="pl-key-title">
                <div class="pl-panel__bar">
                    <h2 id="pl-key-title">Robot key</h2>
                    @if (_activeEpoch is not null)
                    {
                        <span class="state-pill state-pill--active"><span class="state-pill__dot"></span>installed</span>
                    }
                </div>

                @if (!_modularStackConfigured)
                {
                    <p class="pl-panel__empty">
                        <span class="pl-sprite pl-sprite--key pl-sprite--sm" aria-hidden="true"></span>
                        Not available on @SelectedChainAccessor.SelectedChain.ShortName — you sign everything yourself.
                    </p>
                }
                else if (_modularAccountAddress is null)
                {
                    <p class="pl-panel__empty">
                        <span class="pl-sprite pl-sprite--key pl-sprite--sm" aria-hidden="true"></span>
                        No smart account yet — <a href="profile">register one</a> to let a robot pay for you.
                    </p>
                }
                else if (_activeEpoch is null)
                {
                    <p class="pl-panel__empty">
                        <span class="pl-sprite pl-sprite--key pl-sprite--sm" aria-hidden="true"></span>
                        No robot holds a key. You sign everything yourself.
                    </p>
                }
                else
                {
                    <dl class="mission__roles">
                        <div><dt>Robot</dt><dd>@RoleAddress(-1, "agent", _activeEpoch.AgentAddress)</dd></div>
                        <div><dt>Account</dt><dd>@RoleAddress(-1, "delegator", _activeEpoch.DelegatorAddress)</dd></div>
                        <div><dt>Expires</dt><dd>@_activeEpoch.ValidBeforeUtc.ToLocalTime().ToString("MMM d, HH:mm")</dd></div>
                        <div><dt title="Each call is fixed on-chain by target, selector and calldata, and usable once">Calls</dt><dd>@_activeEpoch.Grants.Count</dd></div>
                    </dl>
                    <div class="mission__act">
                        <button class="pl-btn pl-btn--sm pl-btn--reject" disabled="@_isRevoking" @onclick="RevokeAgentPermissionAsync">
                            @(_isRevoking ? "Revoking…" : "Revoke")
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_permissionNotice))
                    {
                        <p class="pl-panel__note">@_permissionNotice</p>
                    }
                }
            </section>
        </div>
    }
  </div>
</div>

@code {
    private const string ProtocolsText = "Featuring ERC-4337 · ERC-8004 · ERC-7683 · ERC-8183";

    /// <summary>
    /// One definition of the escrow lifecycle, used three ways: the teaching
    /// track in the hero, the live map in the console, and the progress strip
    /// inside every mission card. Keeping them literally the same list is what
    /// makes "step 2 of 4" in the next-step card mean anything.
    /// </summary>
    private sealed record LifecycleStep(int Number, string Key, string Label, string ShortLabel, string Sprite, string Blurb);

    private static readonly LifecycleStep[] Lifecycle =
    [
        new(1, "Open", "Post the mission", "Posted", "buyer",
            "The buyer creates the job on-chain and names who will deliver it and who will sign it off."),
        new(2, "Funded", "Lock the payment", "Funded", "vault",
            "The payment moves into escrow. Everyone can see it is there; nobody can take it out."),
        new(3, "Submitted", "Deliver the work", "Delivered", "courier",
            "The courier robot does the job and files its proof of delivery against the escrow."),
        new(4, "Terminal", "Release or refund", "Settled", "inspector",
            "The inspector approves and the escrow pays the courier — or rejects, and the buyer is refunded."),
    ];

    private List<AgentDirectoryEntry>? Agents;
    private List<AgenticJobProjection>? Jobs;
    private string? _walletAddress;
    private bool _loading = true;
    private string? _copiedKey;
    private bool _isWorking;
    private string? _activityNote;

    private bool IsConnected => _walletAddress is not null;

    private bool IsMe(string? address) =>
        !string.IsNullOrWhiteSpace(address) && string.Equals(_walletAddress, address, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The single mission whose next move is mine, in lifecycle order. This is
    /// the whole navigation model of the page: if this is non-null the console
    /// tells you to act on it, and if it is null it tells you what you are
    /// waiting for instead.
    /// </summary>
    private AgenticJobProjection? NextActionableJob =>
        Jobs?.FirstOrDefault(job => job.Status == "Open" && IsMe(job.ClientAddress))
        ?? Jobs?.FirstOrDefault(job => job.Status == "Funded" && IsMe(job.ProviderAddress))
        ?? Jobs?.FirstOrDefault(job => job.Status == "Submitted" && IsMe(job.EvaluatorAddress));

    private bool IsMyTurn(AgenticJobProjection job) => job.Status switch
    {
        "Open" => IsMe(job.ClientAddress),
        "Funded" => IsMe(job.ProviderAddress),
        "Submitted" => IsMe(job.EvaluatorAddress),
        _ => false,
    };

    private string NextSpriteClass
    {
        get
        {
            var pending = NextActionableJob;
            if (pending is null) return "pl-sprite--buyer";
            return pending.Status switch
            {
                "Open" => "pl-sprite--vault",
                "Funded" => "pl-sprite--courier",
                _ => "pl-sprite--inspector",
            };
        }
    }

    private static string MissionLabel(AgenticJobProjection job) => $"#{job.JobId:D4}";

    private static string CounterpartyRole(AgenticJobProjection job) => job.Status switch
    {
        "Open" => "buyer",
        "Funded" => "courier",
        "Submitted" => "inspector",
        _ => "chain",
    };

    /// <summary>Three words at most: whose move it is. The board has no room for a sentence.</summary>
    private string ShortWaiting(AgenticJobProjection job) => job.Status switch
    {
        "Open" => IsMe(job.ClientAddress) ? "your move" : "waiting on buyer",
        "Funded" => IsMe(job.ProviderAddress) ? "your move" : "waiting on courier",
        "Submitted" => IsMe(job.EvaluatorAddress) ? "your move" : "waiting on inspector",
        "Completed" => "paid out",
        "Rejected" => "refunded",
        "Expired" => "expired",
        _ => string.Empty,
    };

    /// <summary>The actor who owns the mission's current step, drawn instead of named.</summary>
    private static string StageSprite(string? status) => status switch
    {
        "Open" => "buyer",
        "Funded" => "courier",
        "Submitted" => "inspector",
        "Completed" => "coin",
        _ => "vault",
    };

    /// <summary>
    /// The teaching track, signed-out only: four steps with a sentence each.
    /// The connected dashboard shows the same four steps as .pl-rail — sprite,
    /// name, count — because by then you need the board, not the lesson.
    /// </summary>
    private RenderFragment FlowTrack => @<ol class="pl-flow" aria-label="How a mission works">
        @foreach (var step in Lifecycle)
        {
            <li class="pl-flow__step">
                <span class="pl-flow__head">
                    <span class="pl-sprite pl-sprite--@step.Sprite" aria-hidden="true"></span>
                    <span class="pl-flow__num" aria-hidden="true">@step.Number</span>
                </span>
                <h3 class="pl-flow__title">@step.Label</h3>
                <p class="pl-flow__blurb">@step.Blurb</p>
            </li>
        }
    </ol>;

    /// <summary>
    /// The robot command bridge, rendered by both states — full width under the
    /// marketing hero when signed out, and as a compact bridge beside the
    /// console copy when connected. One definition keeps both views aligned.
    /// </summary>
