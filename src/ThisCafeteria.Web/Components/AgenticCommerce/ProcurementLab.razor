    // --- Session-key authority state ---
    // The Lab is where procurement actually happens, so which authority is about to sign belongs
    // here rather than only on the profile page: a job funded by a scoped agent and one funded by
    // the owner's own wallet are very different acts, and the difference was previously invisible.
    private string? _modularAccountAddress;
    private AgentPermissionEpochInfo? _activeEpoch;
    private bool _isRevoking;
    private string? _permissionNotice;

    private bool _modularStackConfigured
    {
        get
        {
            var deployment = SelectedChainAccessor.SelectedChain.Deployment;
            return !string.IsNullOrWhiteSpace(deployment.EntryPoint)
                && !string.IsNullOrWhiteSpace(deployment.ModularAccountFactory)
                && !string.IsNullOrWhiteSpace(deployment.DelegationManager);
        }
    }

    /// <summary>
    /// True when the installed permission actually authorises funding THIS job.
    ///
    /// Deliberately strict: a permission is scoped by exact target and selector, so an epoch that
    /// exists is not the same as an epoch that covers this escrow. Showing "agent may fund this"
    /// for a permission that would revert on-chain would be worse than showing nothing.
    /// </summary>
    private bool CanAgentFund(AgenticJobProjection job)
    {
        if (_activeEpoch is null) return false;

        var escrow = SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow;
        if (string.IsNullOrWhiteSpace(escrow)) return false;

        return _activeEpoch.Grants.Any(grant =>
            string.Equals(grant.TargetAddress, escrow, StringComparison.OrdinalIgnoreCase));
    }

    private async Task LoadPermissionStateAsync()
    {
        _modularAccountAddress = null;
        _activeEpoch = null;

        if (string.IsNullOrWhiteSpace(_walletAddress) || !_modularStackConfigured) return;

        try
        {
            var chainKey = SelectedChainAccessor.SelectedChainKey;
            var accounts = await SmartAccountService.DiscoverAccountsAsync(chainKey, _walletAddress);
            var modular = accounts.FirstOrDefault(a => a.AccountType == SmartAccountType.ModularHybridDeleGator);
            if (modular is null) return;

            _modularAccountAddress = modular.AccountAddress;
            _activeEpoch = await SmartAccountService.GetActivePermissionEpochAsync(chainKey, modular.AccountAddress);
        }
        catch (NotSupportedException)
        {
            // Chain has no modular stack configured; the unconfigured branch already explains this.
        }
        catch (Exception exception)
        {
            // Permission state is contextual, not load-bearing: the projections below must still
            // render if this lookup fails.
            Logger.LogWarning(exception, "Could not load agent permission state for {WalletAddress} on {ChainKey}.", _walletAddress, SelectedChainAccessor.SelectedChainKey);
        }
    }

    private async Task RevokeAgentPermissionAsync()
    {
        _isRevoking = true;
        _permissionNotice = null;
        StateHasChanged();

        try
        {
            await SmartAccountService.RevokeSessionPermissionsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress!);
            await LoadPermissionStateAsync();

            // RevokeSessionPermissionsAsync only marks the epoch revoked once the chain agrees the
            // nonce has moved past it, so a still-present epoch here means the on-chain revocation
            // has not happened yet — say so rather than implying the permission is gone.
            _permissionNotice = _activeEpoch is null
                ? "Agent permission revoked."
                : "Sponsorship was revoked, but the on-chain permission epoch is still current. It stays usable until your account advances the NonceEnforcer epoch on-chain.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to revoke agent permissions for {WalletAddress} on {ChainKey}.", _walletAddress, SelectedChainAccessor.SelectedChainKey);
            _permissionNotice = "Could not revoke the agent permission. Try again shortly.";
        }
        finally
        {
            _isRevoking = false;
            StateHasChanged();
        }
    }

    private async Task Copy(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
        catch
        {
            // Clipboard is unavailable outside a secure context; fail quietly.
            return;
        }
        _copiedKey = key;
        StateHasChanged();
        await Task.Delay(1200);
        if (_copiedKey == key)
        {
            _copiedKey = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// A copyable role address.
    ///
    /// Written as a Razor template, not a hand-built RenderTreeBuilder: elements
    /// emitted by a builder never receive this component's CSS-isolation scope
    /// attribute, so none of the scoped .pl-copy rules applied to them and the
    /// "Copied" confirmation — which those rules keep hidden and positioned —
    /// rendered as literal text after every address on the page.
    /// </summary>
    private RenderFragment RoleAddress(long jobId, string role, string? address)
    {
        if (string.IsNullOrWhiteSpace(address))
        {
            return @<span class="job-card__unassigned">Not assigned</span>;
        }

        var key = $"job-{jobId}-{role}";
        return @<button type="button"
                        class="pl-copy @(_copiedKey == key ? "is-copied" : null)"
                        title="Copy @address"
                        @onclick="() => Copy(key, address)">@ShortAddress(address)<span class="pl-copy__flag">Copied</span></button>;
    }

    private IJSObjectReference? _agenticCommerce;
    private IJSObjectReference? _stakingModule;
    private bool _isConnecting;
    private string? _connectError;

    /// <summary>
    /// Same wallet-auth flow as the /staking connect button: MetaMask signs the
    /// challenge, the server issues the wallet session, and a full reload picks
    /// up the new wallet_address claim for this circuit.
    /// </summary>
    private async Task ConnectWalletAsync()
    {
        _isConnecting = true;
        _connectError = null;

        try
        {
            var chain = ChainOptions.Value;
            _stakingModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/coffeeStaking.js");
            var wallet = await _stakingModule.InvokeAsync<string>(
                "connectWalletForStaking",
                new
                {
                    chainId = chain.ChainId,
                    chainIdHex = chain.ChainIdHex,
                    networkName = chain.NetworkName,
                    rpcUrl = chain.RpcUrl,
                    currencyName = chain.CurrencyName,
                    currencySymbol = chain.CurrencySymbol,
                    currencyDecimals = chain.CurrencyDecimals,
                    explorerUrl = chain.ExplorerUrl,
                    isWalletAuthenticated = _walletAddress is not null
                });

            if (!string.IsNullOrWhiteSpace(wallet))
            {
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            }
        }
        catch (Exception exception)
        {
            _connectError = exception.Message;
        }
        finally
        {
            _isConnecting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _agenticCommerce = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/agenticCommerce.js");
        }
    }

    /// <summary>
    /// Every on-chain action goes through here so the page can say what it is
    /// doing. Before, a click opened MetaMask and then the UI sat unchanged for
    /// three seconds whether you signed, rejected, or the call reverted — the
    /// single most common way to think the lab was broken.
    /// </summary>
    private async Task RunOnChain(string busyNote, Func<Task> action)
    {
        if (_agenticCommerce is null || _walletAddress is null) return;

        _isWorking = true;
        _activityNote = busyNote;
        StateHasChanged();

        try
        {
            await action();
            _activityNote = "Transaction sent. Waiting for the chain to confirm it…";
            StateHasChanged();

            // The reconciliation worker writes the projection, so the new state is not readable the
            // instant the transaction lands. One short wait plus an explicit Refresh beats polling.
            await Task.Delay(3000);
            await ReloadJobs();
            _activityNote = "Done. If the mission below has not moved yet, press Refresh in a moment.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "On-chain action failed for {WalletAddress} on {ChainKey}.", _walletAddress, SelectedChainAccessor.SelectedChainKey);
            _activityNote = "Cancelled or failed — nothing changed on-chain. You can try again.";
        }
        finally
        {
            _isWorking = false;
            StateHasChanged();
        }
    }

    private Task CreateTestJob() => RunOnChain(
        "Sign the transaction in your wallet to post the mission…",
        async () =>
        {
            var contract = SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow;
            // Provider = me, Evaluator = me, so a single wallet can walk the whole lifecycle.
            await _agenticCommerce!.InvokeVoidAsync("createJob", contract, _walletAddress, _walletAddress, "Test agentic commerce job");
        });

    private Task FundJob(AgenticJobProjection job) => RunOnChain(
        "Sign both transactions in your wallet to move the tokens into escrow…",
        async () =>
        {
            var chain = SelectedChainAccessor.SelectedChain;
            var contract = chain.Deployment.AgenticEscrow;
            var token = chain.Deployment.PaymentToken;

            // Budget is 0 by default on a freshly created job; 10 is the test amount.
            await _agenticCommerce!.InvokeVoidAsync("setBudget", contract, job.OnChainJobId, 10);
            await _agenticCommerce.InvokeVoidAsync("fundJob", contract, token, job.OnChainJobId, 10);
        });

    private Task SubmitJob(AgenticJobProjection job) => RunOnChain(
        "Sign the transaction in your wallet to file the proof of delivery…",
        () => _agenticCommerce!.InvokeVoidAsync("submitEvidence", SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow, job.OnChainJobId, "IPFS_HASH_HERE").AsTask());

    private Task CompleteJob(AgenticJobProjection job) => RunOnChain(
        "Sign the transaction in your wallet to release the escrow…",
        () => _agenticCommerce!.InvokeVoidAsync("completeJob", SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow, job.OnChainJobId).AsTask());

    private Task RejectJob(AgenticJobProjection job) => RunOnChain(
        "Sign the transaction in your wallet to reject and refund…",
        () => _agenticCommerce!.InvokeVoidAsync("rejectJob", SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow, job.OnChainJobId).AsTask());

    private async Task ReloadJobs()
    {
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        // ?preview=connected renders the console state with fixture data and no
        // wallet — the only way to see and verify it without MetaMask. Same flag
        // and same contract as YieldPanel's: read-only, display state only, no
        // chain calls and no writes. Append &fixtures=1 for a populated board
        // (one mission on each step) instead of the first-run empty state.
        if (Navigation.Uri.Contains("preview=connected", StringComparison.Ordinal))
        {
            _walletAddress = "0x9d53d4900000000000000000000000000000eceb";
            Agents = [];
            Jobs = Navigation.Uri.Contains("fixtures=1", StringComparison.Ordinal) ? PreviewJobs() : [];
            _loading = false;
            return;
        }

        var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _walletAddress = authentication.User.FindFirst("wallet_address")?.Value;
        Agents = await JobService.GetAgentsAsync(SelectedChainAccessor.SelectedChainKey);
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        await LoadPermissionStateAsync();
        _loading = false;
    }

    /// <summary>Display-only fixtures for ?preview=connected&amp;fixtures=1. Never persisted.</summary>
    private List<AgenticJobProjection> PreviewJobs()
    {
        var chainKey = SelectedChainAccessor.SelectedChainKey;
        AgenticJobProjection Make(long id, string status, string? provider = null) => new()
        {
            JobId = id,
            OnChainJobId = id,
            ChainKey = chainKey,
            Status = status,
            Budget = status == "Open" ? 0m : 10m,
            ClientAddress = _walletAddress!,
            ProviderAddress = provider ?? _walletAddress!,
            EvaluatorAddress = _walletAddress!,
            DescriptionCommitment = "0x8f2ac41d9b5e77c0a3d6e1b4f0928cd7e5a1b6c3",
            UpdatedAtUtc = DateTime.UtcNow.AddMinutes(-id),
        };

        return
        [
            Make(1, "Open"),
            Make(2, "Funded", "0x4b19aa7700000000000000000000000000001f0c"),
            Make(3, "Completed"),
        ];
    }

    private static bool IsTerminal(string? status) => status is "Completed" or "Rejected" or "Expired";
    private static string ShortStatus(string? status) => status switch { "Completed" => "paid", "Rejected" => "refunded", "Expired" => "expired", "Submitted" => "delivered", "Funded" => "funded", _ => "posted" };
    private static string StatusClass(string? status) => status switch { "Completed" => "state-pill--complete", "Rejected" or "Expired" => "state-pill--attention", "Submitted" => "state-pill--submitted", "Funded" => "state-pill--funded", _ => "state-pill--open" };
    private static string StageKey(string? status) => status switch { "Funded" => "Funded", "Submitted" => "Submitted", "Completed" or "Rejected" or "Expired" => "Terminal", _ => "Open" };
    private static int StageNumber(string? status) => status switch { "Funded" => 2, "Submitted" => 3, "Completed" or "Rejected" or "Expired" => 4, _ => 1 };
    private static string StepState(string? status, string step) {
        var current = StageNumber(status);
        var target = step == "Open" ? 1 : step == "Funded" ? 2 : step == "Submitted" ? 3 : 4;
        return target < current ? "complete" : target == current ? "current" : "pending";
    }
    private static string ShortAddress(string? address) => string.IsNullOrWhiteSpace(address) ? "Not assigned" : address.Length >= 12 ? $"{address[..6]}…{address[^4..]}" : address;
    private static string ShortCommitment(string? value) => string.IsNullOrWhiteSpace(value) ? "not recorded" : value.Length > 24 ? $"{value[..12]}…{value[^8..]}" : value;
}
