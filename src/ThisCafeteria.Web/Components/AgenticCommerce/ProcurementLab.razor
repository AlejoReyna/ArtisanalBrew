@page "/procurement-lab"
@layout StakingLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Application.Services
@using ThisCafeteria.Domain.Entities
@using ThisCafeteria.Web.Services.Blockchain
@inject IAgenticJobService JobService
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject ISmartAccountService SmartAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject IOptions<BlockchainNetworkOptions> ChainOptions
@inject NavigationManager Navigation
@inject ILogger<ProcurementLab> Logger

<div class="procurement-lab" data-page-theme-color="#171714">
    @* Full-screen sky: sparse pixel stars and coffee-colored planets span the whole
       page behind the content. Decorative only. *@
    <div class="pl-sky" aria-hidden="true">
        <span class="pl-star pl-star--one"></span>
        <span class="pl-star pl-star--two"></span>
        <span class="pl-star pl-star--three"></span>
        <span class="pl-star pl-star--four"></span>
        <span class="pl-star pl-star--five"></span>
        <span class="pl-star pl-star--six"></span>
        <span class="pl-star pl-star--seven"></span>
        <span class="pl-star pl-star--eight"></span>
        <img class="pl-sky__planet pl-sky__planet--one" src="images/pl-planet.png" alt="" />
        <img class="pl-sky__planet pl-sky__planet--two" src="images/pl-planet-ringed.png" alt="" />
    </div>

  <div class="procurement-lab__inner">
    @* Hero: centered editorial copy, robot escrow station, action, then mission
       telemetry. Decorative pixel work is hidden from screen readers; the lifecycle
       is told by the robots and the live panels below — no workflow bar. *@
    <section class="pl-hero" aria-labelledby="pl-hero-title">
        <div class="pl-hero__copy">
            <h1 id="pl-hero-title">Scoped agents. Protected payments.</h1>
            <p class="pl-hero__lede">
                Track registered agents, limited permissions, and escrowed procurement jobs
                across the selected chain.
            </p>
        </div>

        <div class="pl-hero__scene">
            <div class="pl-scene" role="img" aria-label="Pixel robots run a coffee escrow station in space: a scout searches for supplier planets, a buyer authorizes payment at a terminal, a courier carries a crate to the locked vault, and an inspector scans a delivered crate.">
                @if (_loading)
                {
                    <img class="pl-scene__satellite" src="images/pl-satellite.png" alt="" />
                    <span class="pl-signal pl-signal--one"></span>
                    <span class="pl-signal pl-signal--two"></span>
                    <span class="pl-signal pl-signal--three"></span>
                }

                <span class="pl-scene__deck" aria-hidden="true"></span>

                <span class="pl-scene__actor pl-scene__actor--scout" aria-hidden="true"></span>
                <span class="pl-scene__activity pl-scene__activity--scout" aria-hidden="true">Scanning suppliers</span>
                <span class="pl-scene__scout-signal" aria-hidden="true">
                    <span></span><span></span><span></span>
                </span>

                <span class="pl-scene__actor pl-scene__actor--buyer @(_activeEpoch is not null ? "is-live" : "is-locked")" aria-hidden="true"></span>
                <span class="pl-scene__activity pl-scene__activity--buyer @(_activeEpoch is not null ? "is-live" : "is-locked")" aria-hidden="true">
                    @(_activeEpoch is not null ? "Authorizing" : "Awaiting key")
                </span>
                @if (_activeEpoch is not null)
                {
                    <img class="pl-scene__key" src="images/pl-key.png" alt="" />
                }

                <div class="pl-scene__vault">
                    <span class="pl-scene__vault-glow" aria-hidden="true"></span>
                    <img src="images/pl-vault.png" alt="" />
                </div>

                <span class="pl-scene__actor pl-scene__actor--courier" aria-hidden="true"></span>
                <span class="pl-scene__activity pl-scene__activity--courier" aria-hidden="true">Delivering crate</span>

                <span class="pl-scene__actor pl-scene__actor--inspector" aria-hidden="true"></span>
                <span class="pl-scene__activity pl-scene__activity--inspector" aria-hidden="true">Inspecting proof</span>
                <span class="pl-scene__scan" aria-hidden="true"></span>
                <span class="pl-scene__controls @(Jobs?.Any(job => job.Status == "Submitted") == true ? "is-live" : null)" aria-hidden="true">
                    <span class="pl-scene__control pl-scene__control--approve">✓</span>
                    <span class="pl-scene__control pl-scene__control--return">✗</span>
                </span>
            </div>
        </div>

        <div class="pl-hero__action">
            @if (_walletAddress is null)
            {
                <button type="button" class="pl-cta" disabled="@_isConnecting" @onclick="ConnectWalletAsync">
                    @(_isConnecting ? "Connecting…" : "Connect MetaMask")
                </button>
                @if (!string.IsNullOrWhiteSpace(_connectError))
                {
                    <p class="pl-hero__connect-error" role="alert">@_connectError</p>
                }
            }
            else
            {
                <button type="button" class="pl-cta" @onclick="CreateTestJob">
                    Create test mission — wallet signed
                </button>
            }
        </div>
    </section>

    @if (_walletAddress is null)
    {
    }
    else if (_loading)
    {
        <section class="projection-empty projection-empty--loading" role="status"><div class="projection-empty__pulse"></div><p>Loading the selected chain projection…</p></section>
    }
    else
    {
        <section class="projection-panel projection-panel--permission">
            <div class="projection-panel__heading">
                <div><span class="panel-kicker">Authority layer · ERC-4337 session keys</span><h2>Agent permissions</h2></div>
                @if (_activeEpoch is not null)
                {
                    <span class="state-pill state-pill--active"><span class="state-pill__dot"></span>Permission available</span>
                }
            </div>

            @if (!_modularStackConfigured)
            {
                <p class="panel-note">
                    @SelectedChainAccessor.SelectedChain.ShortName has no modular (session-key capable) account stack deployed,
                    so agent-delegated funding is unavailable here. Funding falls back to signing with your own wallet.
                </p>
            }
            else if (_modularAccountAddress is null)
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">⬡</span>
                    <p class="panel-empty__lede">No modular account registered on this chain.</p>
                    <p class="panel-empty__hint">Register one from your profile to let a scoped agent fund jobs on your behalf.</p>
                </div>
            }
            else if (_activeEpoch is null)
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">◇</span>
                    <p class="panel-empty__lede">No agent permission is installed.</p>
                    <p class="panel-empty__hint">
                        Your modular account @ShortAddress(_modularAccountAddress) exists, but has granted no agent any authority.
                        Every action below is signed by your own wallet.
                    </p>
                </div>
            }
            else
            {
                <dl class="job-card__roles">
                    <div><dt>Delegating account</dt><dd>@RoleAddress(-1, "delegator", _activeEpoch.DelegatorAddress)</dd></div>
                    <div><dt>Authorised agent</dt><dd>@RoleAddress(-1, "agent", _activeEpoch.AgentAddress)</dd></div>
                    <div><dt>Expires</dt><dd>@_activeEpoch.ValidBeforeUtc.ToLocalTime().ToString("MMM d, HH:mm")</dd></div>
                    <div><dt>Scoped calls</dt><dd>@_activeEpoch.Grants.Count</dd></div>
                </dl>
                <p class="panel-note">
                    The agent may make exactly these calls and nothing else — target, selector, and calldata are fixed on-chain,
                    each usable once. Gas may be sponsored; that never widens what the agent can spend.
                </p>
                <div class="job-card__actions">
                    <button class="pl-btn pl-btn--sm pl-btn--reject" disabled="@_isRevoking" @onclick="RevokeAgentPermissionAsync">
                        @(_isRevoking ? "Revoking…" : "Revoke agent permission")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_permissionNotice))
                {
                    <p class="panel-note">@_permissionNotice</p>
                }
            }
        </section>

        <div class="procurement-lab__grid">
            <section class="projection-panel">
                <div class="projection-panel__heading"><div><span class="panel-kicker">Identity layer</span><h2>Agent directory</h2></div><span class="panel-count">@(Agents?.Count ?? 0)</span></div>
            @if (Agents == null)
            {
                <p class="panel-note">Loading agents…</p>
            }
            else if (!Agents.Any())
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">⬡</span>
                    <p class="panel-empty__lede">No agents indexed yet.</p>
                    <p class="panel-empty__hint">Run the seeder or register an agent through the escrow contract to populate the identity layer.</p>
                </div>
            }
            else
            {
                <ul class="agent-list">
                    @foreach (var agent in Agents)
                    {
                        <li class="agent-list__item">
                            <span class="agent-avatar" style="--pl-hue:@(agent.AgentId * 47 % 360)">@(agent.AgentId % 100)</span>
                            <div class="agent-list__id">
                                <strong>Agent #@agent.AgentId</strong>
                                <button type="button" class="pl-copy agent-list__addr @(_copiedKey == $"agent-{agent.AgentId}" ? "is-copied" : null)" title="Copy @agent.OwnerAddress" @onclick='() => Copy($"agent-{agent.AgentId}", agent.OwnerAddress)'>@ShortAddress(agent.OwnerAddress)<span class="pl-copy__flag">Copied</span></button>
                            </div>
                            <span class="state-pill @(agent.IsActive ? "state-pill--active" : "state-pill--idle")">
                                <span class="state-pill__dot"></span>@(agent.IsActive ? "Active" : "Inactive")
                            </span>
                        </li>
                    }
                </ul>
            }
            </section>

            <section class="projection-panel projection-panel--jobs">
                <div class="projection-panel__heading"><div><span class="panel-kicker">Escrow projection</span><h2>My procurement state</h2></div><span class="panel-count">@(Jobs?.Count ?? 0)</span></div>
            @if (Jobs == null)
            {
                <p class="panel-note">Loading jobs…</p>
            }
            else if (!Jobs.Any())
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">◇</span>
                    <p class="panel-empty__lede">No missions on record for this wallet.</p>
                    <p class="panel-empty__hint">Create a test mission above to watch it move through the open → funded → submitted → settled escrow lifecycle.</p>
                </div>
            }
            else
            {
                <div class="job-list">
                    @foreach (var job in Jobs)
                    {
                        <article class="job-card">
                            <div class="job-card__topline"><div><span class="job-card__id">JOB @job.JobId.ToString("D4")</span><h3>@StatusTitle(job.Status)</h3></div><span class="state-pill @StatusClass(job.Status)">@job.Status</span></div>
                            <div class="job-card__meta"><span>Budget <strong>@job.Budget.ToString("0.##")</strong></span><span>Chain <strong>@job.ChainKey</strong></span><span>Updated <strong>@job.UpdatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</strong></span></div>
                            <div class="job-flow" aria-label="Job @job.JobId lifecycle">
                                @foreach (var step in LifecycleSteps)
                                {
                                    var state = StepState(job.Status, step.Key);
                                    <div class="job-flow__step @state">
                                        <span class="job-flow__marker">@(state == "complete" ? "✓" : step.Number.ToString())</span>
                                        <span class="job-flow__label">@step.Label</span>
                                    </div>
                                }
                            </div>
                            <dl class="job-card__roles">
                                <div><dt>Client</dt><dd>@RoleAddress(job.JobId, "client", job.ClientAddress)</dd></div>
                                <div><dt>Provider</dt><dd>@RoleAddress(job.JobId, "provider", job.ProviderAddress)</dd></div>
                                <div><dt>Evaluator</dt><dd>@RoleAddress(job.JobId, "evaluator", job.EvaluatorAddress)</dd></div>
                            </dl>
                            <div class="job-card__commitment">
                                <span>Commitment</span>
                                @if (string.IsNullOrWhiteSpace(job.DescriptionCommitment))
                                {
                                    <code>not recorded</code>
                                }
                                else
                                {
                                    <button type="button" class="pl-copy job-card__commitment-code @(_copiedKey == $"job-{job.JobId}-commit" ? "is-copied" : null)" title="Copy @job.DescriptionCommitment" @onclick='() => Copy($"job-{job.JobId}-commit", job.DescriptionCommitment)'><code>@ShortCommitment(job.DescriptionCommitment)</code><span class="pl-copy__flag">Copied</span></button>
                                }
                            </div>
                        
                            <div class="job-card__actions">
                                @if (job.Status == "Open" && string.Equals(_walletAddress, job.ClientAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--fund" @onclick="() => FundJob(job)">Fund job</button>
                                    @if (CanAgentFund(job))
                                    {
                                        <span class="state-pill state-pill--active" title="Agent @_activeEpoch!.AgentAddress holds a recorded permission scoped to this escrow">
                                            <span class="state-pill__dot"></span>Permission recorded for this escrow
                                        </span>
                                    }
                                    else if (_activeEpoch is not null)
                                    {
                                        <span class="state-pill state-pill--idle" title="The installed permission is not scoped to this job">
                                            <span class="state-pill__dot"></span>Wallet-signed only
                                        </span>
                                    }
                                }
                                @if (job.Status == "Funded" && string.Equals(_walletAddress, job.ProviderAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--submit" @onclick="() => SubmitJob(job)">Submit evidence</button>
                                }
                                @if (job.Status == "Submitted" && string.Equals(_walletAddress, job.EvaluatorAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--complete" @onclick="() => CompleteJob(job)">Complete job</button>
                                    <button class="pl-btn pl-btn--sm pl-btn--reject" @onclick="() => RejectJob(job)">Reject job</button>
                                }
                            </div>

                        </article>
                    }
                </div>
            }
            </section>
        </div>
    }
  </div>
</div>

@code {
    private static readonly (int Number, string Key, string Label)[] LifecycleSteps =
    [ (1, "Open", "Open"), (2, "Funded", "Funded"), (3, "Submitted", "Submitted"), (4, "Terminal", "Settled") ];
    private List<AgentDirectoryEntry>? Agents;
    private List<AgenticJobProjection>? Jobs;
    private string? _walletAddress;
    private bool _loading = true;
    private string? _copiedKey;

    // --- Session-key authority state ---
    // The Lab is where procurement actually happens, so which authority is about to sign belongs
    // here rather than only on the profile page: a job funded by a scoped agent and one funded by
    // the owner's own wallet are very different acts, and the difference was previously invisible.
    private string? _modularAccountAddress;
    private AgentPermissionEpochInfo? _activeEpoch;
    private bool _isRevoking;
    private string? _permissionNotice;

    private bool _modularStackConfigured
    {
        get
        {
            var deployment = SelectedChainAccessor.SelectedChain.Deployment;
            return !string.IsNullOrWhiteSpace(deployment.EntryPoint)
                && !string.IsNullOrWhiteSpace(deployment.ModularAccountFactory)
                && !string.IsNullOrWhiteSpace(deployment.DelegationManager);
        }
    }

    /// <summary>
    /// True when the installed permission actually authorises funding THIS job.
    ///
    /// Deliberately strict: a permission is scoped by exact target and selector, so an epoch that
    /// exists is not the same as an epoch that covers this escrow. Showing "agent may fund this"
    /// for a permission that would revert on-chain would be worse than showing nothing.
    /// </summary>
    private bool CanAgentFund(AgenticJobProjection job)
    {
        if (_activeEpoch is null) return false;

        var escrow = SelectedChainAccessor.SelectedChain.Deployment.AgenticEscrow;
        if (string.IsNullOrWhiteSpace(escrow)) return false;

        return _activeEpoch.Grants.Any(grant =>
            string.Equals(grant.TargetAddress, escrow, StringComparison.OrdinalIgnoreCase));
    }

    private async Task LoadPermissionStateAsync()
    {
        _modularAccountAddress = null;
        _activeEpoch = null;

        if (string.IsNullOrWhiteSpace(_walletAddress) || !_modularStackConfigured) return;

        try
        {
            var chainKey = SelectedChainAccessor.SelectedChainKey;
            var accounts = await SmartAccountService.DiscoverAccountsAsync(chainKey, _walletAddress);
            var modular = accounts.FirstOrDefault(a => a.AccountType == SmartAccountType.ModularHybridDeleGator);
            if (modular is null) return;

            _modularAccountAddress = modular.AccountAddress;
            _activeEpoch = await SmartAccountService.GetActivePermissionEpochAsync(chainKey, modular.AccountAddress);
        }
        catch (NotSupportedException)
        {
            // Chain has no modular stack configured; the unconfigured branch already explains this.
        }
        catch (Exception exception)
        {
            // Permission state is contextual, not load-bearing: the projections below must still
            // render if this lookup fails.
            Logger.LogWarning(exception, "Could not load agent permission state for {WalletAddress} on {ChainKey}.", _walletAddress, SelectedChainAccessor.SelectedChainKey);
        }
    }

    private async Task RevokeAgentPermissionAsync()
    {
        _isRevoking = true;
        _permissionNotice = null;
        StateHasChanged();

        try
        {
            await SmartAccountService.RevokeSessionPermissionsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress!);
            await LoadPermissionStateAsync();

            // RevokeSessionPermissionsAsync only marks the epoch revoked once the chain agrees the
            // nonce has moved past it, so a still-present epoch here means the on-chain revocation
            // has not happened yet — say so rather than implying the permission is gone.
            _permissionNotice = _activeEpoch is null
                ? "Agent permission revoked."
                : "Sponsorship was revoked, but the on-chain permission epoch is still current. It stays usable until your account advances the NonceEnforcer epoch on-chain.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to revoke agent permissions for {WalletAddress} on {ChainKey}.", _walletAddress, SelectedChainAccessor.SelectedChainKey);
            _permissionNotice = "Could not revoke the agent permission. Try again shortly.";
        }
        finally
        {
            _isRevoking = false;
            StateHasChanged();
        }
    }

    private async Task Copy(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
        catch
        {
            // Clipboard is unavailable outside a secure context; fail quietly.
            return;
        }
        _copiedKey = key;
        StateHasChanged();
        await Task.Delay(1200);
        if (_copiedKey == key)
        {
            _copiedKey = null;
            StateHasChanged();
        }
    }

    private RenderFragment RoleAddress(long jobId, string role, string? address) => builder =>
    {
        if (string.IsNullOrWhiteSpace(address))
        {
            builder.AddContent(0, "Not assigned");
            return;
        }
        var key = $"job-{jobId}-{role}";
        builder.OpenElement(1, "button");
        builder.AddAttribute(2, "type", "button");
        builder.AddAttribute(3, "class", _copiedKey == key ? "pl-copy is-copied" : "pl-copy");
        builder.AddAttribute(4, "title", $"Copy {address}");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => Copy(key, address)));
        builder.AddContent(6, ShortAddress(address));
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "pl-copy__flag");
        builder.AddContent(9, "Copied");
        builder.CloseElement();
        builder.CloseElement();
    };

    private IJSObjectReference? _agenticCommerce;
    private IJSObjectReference? _stakingModule;
    private bool _isConnecting;
    private string? _connectError;

    /// <summary>
    /// Same wallet-auth flow as the /staking connect button: MetaMask signs the
    /// challenge, the server issues the wallet session, and a full reload picks
    /// up the new wallet_address claim for this circuit.
    /// </summary>
    private async Task ConnectWalletAsync()
    {
        _isConnecting = true;
        _connectError = null;

        try
        {
            var chain = ChainOptions.Value;
            _stakingModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/coffeeStaking.js");
            var wallet = await _stakingModule.InvokeAsync<string>(
                "connectWalletForStaking",
                new
                {
                    chainId = chain.ChainId,
                    chainIdHex = chain.ChainIdHex,
                    networkName = chain.NetworkName,
                    rpcUrl = chain.RpcUrl,
                    currencyName = chain.CurrencyName,
                    currencySymbol = chain.CurrencySymbol,
                    currencyDecimals = chain.CurrencyDecimals,
                    explorerUrl = chain.ExplorerUrl,
                    isWalletAuthenticated = _walletAddress is not null
                });

            if (!string.IsNullOrWhiteSpace(wallet))
            {
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            }
        }
        catch (Exception exception)
        {
            _connectError = exception.Message;
        }
        finally
        {
            _isConnecting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _agenticCommerce = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/agenticCommerce.js");
        }
    }

    private async Task CreateTestJob()
    {
        if (_agenticCommerce == null || _walletAddress == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        // Provider = me, Evaluator = me, for testing
        await _agenticCommerce.InvokeVoidAsync("createJob", contract, _walletAddress, _walletAddress, "Test agentic commerce job");
        
        // Wait briefly for tx to process and worker to pick it up (in a real app we'd wait for the tx receipt or use polling)
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task FundJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        var token = chain.Deployment.PaymentToken;
        
        // We first need to set budget since it's 0 by default. Let's just set it to 10 for testing.
        await _agenticCommerce.InvokeVoidAsync("setBudget", contract, job.OnChainJobId, 10);
        await _agenticCommerce.InvokeVoidAsync("fundJob", contract, token, job.OnChainJobId, 10);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task SubmitJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("submitEvidence", contract, job.OnChainJobId, "IPFS_HASH_HERE");
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task CompleteJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("completeJob", contract, job.OnChainJobId);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task RejectJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("rejectJob", contract, job.OnChainJobId);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task ReloadJobs()
    {
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _walletAddress = authentication.User.FindFirst("wallet_address")?.Value;
        Agents = await JobService.GetAgentsAsync(SelectedChainAccessor.SelectedChainKey);
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        await LoadPermissionStateAsync();
        _loading = false;
    }

    private static bool IsTerminal(string? status) => status is "Completed" or "Rejected" or "Expired";
    private static string StatusTitle(string? status) => status switch { "Completed" => "Payment released", "Rejected" => "Refunded by evaluator", "Expired" => "Expired / refunded", "Submitted" => "Evidence submitted", "Funded" => "Awaiting delivery", _ => "Open proposal" };
    private static string StatusClass(string? status) => status switch { "Completed" => "state-pill--complete", "Rejected" or "Expired" => "state-pill--attention", "Submitted" => "state-pill--submitted", "Funded" => "state-pill--funded", _ => "state-pill--open" };
    private static string StepState(string? status, string step) {
        var current = status switch { "Funded" => 2, "Submitted" => 3, "Completed" or "Rejected" or "Expired" => 4, _ => 1 };
        var target = step == "Open" ? 1 : step == "Funded" ? 2 : step == "Submitted" ? 3 : 4;
        return target < current ? "complete" : target == current ? "current" : "pending";
    }
    private static string ShortAddress(string? address) => string.IsNullOrWhiteSpace(address) ? "Not assigned" : address.Length >= 12 ? $"{address[..6]}…{address[^4..]}" : address;
    private static string ShortCommitment(string? value) => string.IsNullOrWhiteSpace(value) ? "not recorded" : value.Length > 24 ? $"{value[..12]}…{value[^8..]}" : value;
}
