@page "/procurement-lab"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Application.Services
@using ThisCafeteria.Domain.Entities
@using ThisCafeteria.Web.Services.Blockchain
@inject IAgenticJobService JobService
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<div class="procurement-lab" data-page-theme-color="#171714">
  <div class="procurement-lab__inner">
    <div class="procurement-lab__header">
        <div class="procurement-lab__intro">
            <span class="procurement-lab__eyebrow">Agentic commerce · live projection</span>
            <h1>Procurement Lab</h1>
            <p>Inspect the state currently known to ArtisanalBrew. This view reads persisted projections — it does not manufacture on-chain progress.</p>
        </div>

        <div class="procurement-lab__aside">
            <div class="procurement-lab__source" title="Chain the projection is read from">
                <span class="crypto-dot crypto-dot--pulse"></span>
                <span class="procurement-lab__source-name">@SelectedChainAccessor.SelectedChain.ShortName</span>
                <span class="procurement-lab__source-label">Reading projections</span>
            </div>
            @if (_walletAddress != null)
            {
                <div class="procurement-lab__actions">
                    <button class="pl-btn pl-btn--primary" @onclick="CreateTestJob">
                        <span class="pl-btn__glyph">＋</span> Simulate new job
                    </button>
                </div>
            }
        </div>
    </div>

    <section class="procurement-lab__summary" aria-label="Projection summary">
        <div class="state-metric state-metric--agents"><span class="state-metric__value">@(Agents?.Count ?? 0)</span><span class="state-metric__label">Indexed agents</span></div>
        <div class="state-metric state-metric--jobs"><span class="state-metric__value">@(Jobs?.Count ?? 0)</span><span class="state-metric__label">Observed jobs</span></div>
        <div class="state-metric state-metric--terminal"><span class="state-metric__value">@(Jobs?.Count(job => IsTerminal(job.Status)) ?? 0)</span><span class="state-metric__label">Terminal jobs</span></div>
        <div class="state-metric state-metric--wallet">
            @if (_walletAddress is null)
            {
                <span class="state-metric__value">—</span>
            }
            else
            {
                <button type="button" class="pl-copy state-metric__value @(_copiedKey == "wallet" ? "is-copied" : null)" title="Copy @_walletAddress" @onclick='() => Copy("wallet", _walletAddress)'>@ShortAddress(_walletAddress)<span class="pl-copy__flag">Copied</span></button>
            }
            <span class="state-metric__label">Wallet scope</span>
        </div>
    </section>

    @if (_walletAddress is null)
    {
        <section class="projection-empty" role="status">
            <span class="projection-empty__icon">◎</span>
            <div>
                <h2>Connect a wallet to see your procurement state</h2>
                <p>The directory can be public, but job projections are scoped to the authenticated wallet. No local demo address is substituted.</p>
            </div>
        </section>
    }
    else if (_loading)
    {
        <section class="projection-empty projection-empty--loading" role="status"><div class="projection-empty__pulse"></div><p>Loading the selected chain projection…</p></section>
    }
    else
    {
        <div class="procurement-lab__grid">
            <section class="projection-panel">
                <div class="projection-panel__heading"><div><span class="panel-kicker">Identity layer</span><h2>Agent directory</h2></div><span class="panel-count">@(Agents?.Count ?? 0)</span></div>
            @if (Agents == null)
            {
                <p class="panel-note">Loading agents…</p>
            }
            else if (!Agents.Any())
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">⬡</span>
                    <p class="panel-empty__lede">No agents indexed yet.</p>
                    <p class="panel-empty__hint">Run the seeder or register an agent through the escrow contract to populate the identity layer.</p>
                </div>
            }
            else
            {
                <ul class="agent-list">
                    @foreach (var agent in Agents)
                    {
                        <li class="agent-list__item">
                            <span class="agent-avatar" style="--pl-hue:@(agent.AgentId * 47 % 360)">@(agent.AgentId % 100)</span>
                            <div class="agent-list__id">
                                <strong>Agent #@agent.AgentId</strong>
                                <button type="button" class="pl-copy agent-list__addr @(_copiedKey == $"agent-{agent.AgentId}" ? "is-copied" : null)" title="Copy @agent.OwnerAddress" @onclick='() => Copy($"agent-{agent.AgentId}", agent.OwnerAddress)'>@ShortAddress(agent.OwnerAddress)<span class="pl-copy__flag">Copied</span></button>
                            </div>
                            <span class="state-pill @(agent.IsActive ? "state-pill--active" : "state-pill--idle")">
                                <span class="state-pill__dot"></span>@(agent.IsActive ? "Active" : "Inactive")
                            </span>
                        </li>
                    }
                </ul>
            }
            </section>

            <section class="projection-panel projection-panel--jobs">
                <div class="projection-panel__heading"><div><span class="panel-kicker">Escrow projection</span><h2>My procurement state</h2></div><span class="panel-count">@(Jobs?.Count ?? 0)</span></div>
            @if (Jobs == null)
            {
                <p class="panel-note">Loading jobs…</p>
            }
            else if (!Jobs.Any())
            {
                <div class="panel-empty">
                    <span class="panel-empty__icon">◇</span>
                    <p class="panel-empty__lede">No procurement jobs for this wallet.</p>
                    <p class="panel-empty__hint">Simulate a job above to watch it move through the open → funded → submitted → settled escrow lifecycle.</p>
                </div>
            }
            else
            {
                <div class="job-list">
                    @foreach (var job in Jobs)
                    {
                        <article class="job-card">
                            <div class="job-card__topline"><div><span class="job-card__id">JOB @job.JobId.ToString("D4")</span><h3>@StatusTitle(job.Status)</h3></div><span class="state-pill @StatusClass(job.Status)">@job.Status</span></div>
                            <div class="job-card__meta"><span>Budget <strong>@job.Budget.ToString("0.##")</strong></span><span>Chain <strong>@job.ChainKey</strong></span><span>Updated <strong>@job.UpdatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</strong></span></div>
                            <div class="job-flow" aria-label="Job @job.JobId lifecycle">
                                @foreach (var step in LifecycleSteps)
                                {
                                    var state = StepState(job.Status, step.Key);
                                    <div class="job-flow__step @state">
                                        <span class="job-flow__marker">@(state == "complete" ? "✓" : step.Number.ToString())</span>
                                        <span class="job-flow__label">@step.Label</span>
                                    </div>
                                }
                            </div>
                            <dl class="job-card__roles">
                                <div><dt>Client</dt><dd>@RoleAddress(job.JobId, "client", job.ClientAddress)</dd></div>
                                <div><dt>Provider</dt><dd>@RoleAddress(job.JobId, "provider", job.ProviderAddress)</dd></div>
                                <div><dt>Evaluator</dt><dd>@RoleAddress(job.JobId, "evaluator", job.EvaluatorAddress)</dd></div>
                            </dl>
                            <div class="job-card__commitment">
                                <span>Commitment</span>
                                @if (string.IsNullOrWhiteSpace(job.DescriptionCommitment))
                                {
                                    <code>not recorded</code>
                                }
                                else
                                {
                                    <button type="button" class="pl-copy job-card__commitment-code @(_copiedKey == $"job-{job.JobId}-commit" ? "is-copied" : null)" title="Copy @job.DescriptionCommitment" @onclick='() => Copy($"job-{job.JobId}-commit", job.DescriptionCommitment)'><code>@ShortCommitment(job.DescriptionCommitment)</code><span class="pl-copy__flag">Copied</span></button>
                                }
                            </div>
                        
                            <div class="job-card__actions">
                                @if (job.Status == "Open" && string.Equals(_walletAddress, job.ClientAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--fund" @onclick="() => FundJob(job)">Fund job</button>
                                }
                                @if (job.Status == "Funded" && string.Equals(_walletAddress, job.ProviderAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--submit" @onclick="() => SubmitJob(job)">Submit evidence</button>
                                }
                                @if (job.Status == "Submitted" && string.Equals(_walletAddress, job.EvaluatorAddress, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="pl-btn pl-btn--sm pl-btn--complete" @onclick="() => CompleteJob(job)">Complete job</button>
                                    <button class="pl-btn pl-btn--sm pl-btn--reject" @onclick="() => RejectJob(job)">Reject job</button>
                                }
                            </div>

                        </article>
                    }
                </div>
            }
            </section>
        </div>
    }
  </div>
</div>

@code {
    private static readonly (int Number, string Key, string Label)[] LifecycleSteps =
    [ (1, "Open", "Open"), (2, "Funded", "Funded"), (3, "Submitted", "Submitted"), (4, "Terminal", "Settled") ];
    private List<AgentDirectoryEntry>? Agents;
    private List<AgenticJobProjection>? Jobs;
    private string? _walletAddress;
    private bool _loading = true;
    private string? _copiedKey;

    private async Task Copy(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
        catch
        {
            // Clipboard is unavailable outside a secure context; fail quietly.
            return;
        }
        _copiedKey = key;
        StateHasChanged();
        await Task.Delay(1200);
        if (_copiedKey == key)
        {
            _copiedKey = null;
            StateHasChanged();
        }
    }

    private RenderFragment RoleAddress(long jobId, string role, string? address) => builder =>
    {
        if (string.IsNullOrWhiteSpace(address))
        {
            builder.AddContent(0, "Not assigned");
            return;
        }
        var key = $"job-{jobId}-{role}";
        builder.OpenElement(1, "button");
        builder.AddAttribute(2, "type", "button");
        builder.AddAttribute(3, "class", _copiedKey == key ? "pl-copy is-copied" : "pl-copy");
        builder.AddAttribute(4, "title", $"Copy {address}");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => Copy(key, address)));
        builder.AddContent(6, ShortAddress(address));
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "pl-copy__flag");
        builder.AddContent(9, "Copied");
        builder.CloseElement();
        builder.CloseElement();
    };

    private IJSObjectReference? _agenticCommerce;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _agenticCommerce = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/agenticCommerce.js");
        }
    }

    private async Task CreateTestJob()
    {
        if (_agenticCommerce == null || _walletAddress == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        // Provider = me, Evaluator = me, for testing
        await _agenticCommerce.InvokeVoidAsync("createJob", contract, _walletAddress, _walletAddress, "Test agentic commerce job");
        
        // Wait briefly for tx to process and worker to pick it up (in a real app we'd wait for the tx receipt or use polling)
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task FundJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        var token = chain.Deployment.PaymentToken;
        
        // We first need to set budget since it's 0 by default. Let's just set it to 10 for testing.
        await _agenticCommerce.InvokeVoidAsync("setBudget", contract, job.OnChainJobId, 10);
        await _agenticCommerce.InvokeVoidAsync("fundJob", contract, token, job.OnChainJobId, 10);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task SubmitJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("submitEvidence", contract, job.OnChainJobId, "IPFS_HASH_HERE");
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task CompleteJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("completeJob", contract, job.OnChainJobId);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task RejectJob(AgenticJobProjection job)
    {
        if (_agenticCommerce == null) return;
        var chain = SelectedChainAccessor.SelectedChain;
        var contract = chain.Deployment.AgenticEscrow;
        await _agenticCommerce.InvokeVoidAsync("rejectJob", contract, job.OnChainJobId);
        
        await Task.Delay(3000);
        await ReloadJobs();
    }

    private async Task ReloadJobs()
    {
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _walletAddress = authentication.User.FindFirst("wallet_address")?.Value;
        Agents = await JobService.GetAgentsAsync(SelectedChainAccessor.SelectedChainKey);
        if (!string.IsNullOrWhiteSpace(_walletAddress)) Jobs = await JobService.GetJobsAsync(SelectedChainAccessor.SelectedChainKey, _walletAddress);
        _loading = false;
    }

    private static bool IsTerminal(string? status) => status is "Completed" or "Rejected" or "Expired";
    private static string StatusTitle(string? status) => status switch { "Completed" => "Payment released", "Rejected" => "Refunded by evaluator", "Expired" => "Expired / refunded", "Submitted" => "Evidence submitted", "Funded" => "Awaiting delivery", _ => "Open proposal" };
    private static string StatusClass(string? status) => status switch { "Completed" => "state-pill--complete", "Rejected" or "Expired" => "state-pill--attention", "Submitted" => "state-pill--submitted", "Funded" => "state-pill--funded", _ => "state-pill--open" };
    private static string StepState(string? status, string step) {
        var current = status switch { "Funded" => 2, "Submitted" => 3, "Completed" or "Rejected" or "Expired" => 4, _ => 1 };
        var target = step == "Open" ? 1 : step == "Funded" ? 2 : step == "Submitted" ? 3 : 4;
        return target < current ? "complete" : target == current ? "current" : "pending";
    }
    private static string ShortAddress(string? address) => string.IsNullOrWhiteSpace(address) ? "Not assigned" : address.Length >= 12 ? $"{address[..6]}…{address[^4..]}" : address;
    private static string ShortCommitment(string? value) => string.IsNullOrWhiteSpace(value) ? "not recorded" : value.Length > 24 ? $"{value[..12]}…{value[^8..]}" : value;
}
