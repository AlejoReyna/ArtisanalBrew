@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en" style="@InitialDocumentBackground">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="@InitialThemeColor" />
    <base href="/" />
    <!-- Blocking, and deliberately first: applies the stored/OS-preferred
         data-theme attribute to <html> before app.css is fetched, so the CSS
         variable tiers in app.css resolve correctly on the very first paint
         instead of flashing light-then-dark (or vice versa). -->
    <script src="js/theme.js"></script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ThisCafeteria.Web.styles.css"]" />
    <ImportMap />
    <script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"
            }
        }
    </script>
    <link rel="icon" type="image/png" href="images/favicon.png" />
    <!-- In <head>, and deliberately blocking: it marks <html> before the hero markup is
         parsed, so the headline is never painted in full before it types itself out. -->
    <script src="js/heroType.js"></script>
    <!-- Also blocking, for the same reason: it marks <html> before the product grid is
         parsed, so the cards paint collapsed instead of snapping shut a frame later. -->
    <script src="js/productCardBlurb.js"></script>
    <HeadOutlet />
</head>

<body style="@InitialDocumentBackground">
    <Routes />
    <ReconnectModal />
    <IdleTimeoutModal />
    <script src="https://cdn.jsdelivr.net/npm/web3@1.10.0/dist/web3.min.js" defer></script>
    <script src="js/solana-web3.iife.min.js" defer></script>
    <script src="js/delegation-toolkit.iife.min.js" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/cartToast.js"></script>
    <script src="js/publicHeader.js"></script>
    <script src="js/productTransition.js"></script>
    <script src="js/recruiterMotion.js"></script>
    <script src="js/storyTechShowcase.js"></script>
    <script src="js/storyDataPath.js"></script>
    <script src="js/storyGuessType.js"></script>
    <script src="js/journalProgress.js"></script>
    <script src="js/heroWebGL.js"></script>
    <script src="js/chainSelector.js"></script>
    <script>
        window.animationObserver = null;

        window.animateSelector =
            '[data-animate]:not(.is-visible):not(#hero-section *), [data-stagger]:not(.is-visible), .comfy-animate:not(.is-visible), .comfy-animate-image:not(.is-visible)';

        // Everything with [data-animate] starts at opacity:0. An IntersectionObserver
        // only delivers its first callback asynchronously, so on an enhanced navigation
        // the freshly swapped-in page would sit fully transparent for a frame or more —
        // long enough to read as a blank flash of the page background between routes.
        // Reveal whatever is already on screen synchronously; the observer then only has
        // to handle what's below the fold, where a late reveal is the point.
        //
        // `instant` additionally suppresses the 1s fade (see .reveal-instant in app.css).
        // Adding .is-visible alone isn't enough mid-navigation: the element spends most
        // of a second near opacity:0, which looks exactly like the blank flash we're
        // trying to remove. Content already on screen when the route changes should
        // simply be there; the fade is for scrolling into new content.
        window.revealInView = (instant) => {
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

            document.querySelectorAll(window.animateSelector).forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < viewportHeight && rect.bottom > 0) {
                    if (instant) {
                        el.classList.add('reveal-instant');
                    }

                    el.classList.add('is-visible');
                }
            });
        };

        window.initAnimations = () => {
            if (window.animationObserver) {
                window.animationObserver.disconnect();
            }

            const observerOptions = {
                root: null,
                rootMargin: '0px 0px -10% 0px',
                threshold: 0.1
            };

            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            window.animationObserver = observer;

            const animatedElements = document.querySelectorAll(window.animateSelector);

            animatedElements.forEach(el => observer.observe(el));
        };

        window.revealHero = (instant) => {
            document.querySelectorAll('#hero-section [data-animate]').forEach(el => {
                if (instant) {
                    el.classList.add('reveal-instant');
                }

                el.classList.add('is-visible');
            });
        };

        window.revealMutationObserver = null;

        // Enhanced navigation isn't the only time markup gets replaced: when a
        // component goes interactive Blazor swaps out the prerendered nodes, and later
        // re-renders can recreate subtrees wholesale. Either way the fresh nodes come
        // back at opacity:0 because .is-visible only ever lived on the discarded ones,
        // which flashes the bare page background mid-navigation. MutationObserver
        // callbacks are delivered as microtasks — before the next paint — so
        // re-revealing here closes the gap rather than showing a blank frame first.
        window.watchReveals = () => {
            if (window.revealMutationObserver || !('MutationObserver' in window) || !document.body) {
                return;
            }

            const observer = new MutationObserver(records => {
                for (const record of records) {
                    for (const node of record.addedNodes) {
                        if (node.nodeType !== 1) {
                            continue;
                        }

                        if (node.matches(window.animateSelector) || node.querySelector(window.animateSelector)) {
                            window.revealInView(true);
                            // Newly created nodes below the fold aren't known to the
                            // IntersectionObserver, so re-arm it for the next scroll.
                            requestAnimationFrame(window.initAnimations);
                            return;
                        }
                    }
                }
            });

            // Only childList — revealInView mutates classes, and observing attributes
            // would feed that straight back in as a loop.
            observer.observe(document.body, { childList: true, subtree: true });
            window.revealMutationObserver = observer;
        };

        // `instant` is set for route changes, where the fade reads as a flash, and left
        // off for the initial load, where it's the intended entrance.
        window.queueAnimations = (instant) => {
            // Synchronous, before the browser gets a chance to paint the new page.
            window.revealHero(instant);
            window.revealInView(instant);
            window.watchReveals();

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    window.initAnimations();
                    window.revealHero(instant);
                });
            });
        };

        window.watchReveals();

        window.queuePublicHeader = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (typeof window.initPublicHeader === 'function') {
                        window.initPublicHeader();
                    }
                });
            });
        };

        window.queueRecruiterMotion = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (window.recruiterShowcaseMotion) {
                        window.recruiterShowcaseMotion.init();
                    }
                });
            });
        };

        window.queueStoryTechShowcase = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (window.storyTechShowcase) {
                        window.storyTechShowcase.init();
                    }
                });
            });
        };

        window.queueStoryGuessType = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (window.storyGuessType) {
                        window.storyGuessType.init();
                    }
                });
            });
        };

        window.queueHeroWebGL = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (!window.heroWebGL) return;
                    if (document.getElementById('hero-webgl-canvas')) {
                        window.heroWebGL.init('hero-webgl-canvas');
                    } else {
                        window.heroWebGL.destroyAll();
                    }
                });
            });
        };

        window.queueHeroType = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    if (window.heroTypewriter) {
                        window.heroTypewriter.init();
                    }
                });
            });
        };

        // Some mobile browsers (notably iOS Safari under Low Power Mode, or when
        // the <video> wasn't fully buffered the instant the autoplay attribute was
        // evaluated) silently ignore attribute-only autoplay. A muted video is always
        // allowed to be started via script, so retry play() explicitly and again
        // whenever the tab regains visibility.
        window.queueHeroVideo = () => {
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    const video = document.querySelector('.hero-video');
                    if (video && video.paused) {
                        video.play().catch(() => {});
                    }
                });
            });
        };

        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
                window.queueHeroVideo();
            }
        });

        // Wrapped, not passed by reference: the handler would otherwise receive the
        // Event as `instant` and skip the intended entrance fade on a cold load.
        document.addEventListener('DOMContentLoaded', () => window.queueAnimations(false));
        document.addEventListener('DOMContentLoaded', window.queuePublicHeader);
        document.addEventListener('DOMContentLoaded', window.queueRecruiterMotion);
        document.addEventListener('DOMContentLoaded', window.queueStoryTechShowcase);
        document.addEventListener('DOMContentLoaded', window.queueStoryGuessType);
        document.addEventListener('DOMContentLoaded', window.queueHeroWebGL);
        document.addEventListener('DOMContentLoaded', window.queueHeroVideo);
        document.addEventListener('DOMContentLoaded', window.queueHeroType);

        const onEnhancedLoad = () => {
            // Blazor's enhanced navigation replaces <html>'s attributes with
            // whatever the server rendered for the new page — which never
            // includes data-theme, since only client-side JS (theme.js) knows
            // the stored/OS-preferred choice. Confirmed via testing that this
            // silently resets the theme on every route change without this
            // reapply; the initial <head> bootstrap script only covers a full
            // page load, not this SPA-style transition.
            window.artisanalTheme.apply(window.artisanalTheme.getStored());
            window.queueAnimations(true);
            window.queuePublicHeader();
            window.queueRecruiterMotion();
            window.queueStoryTechShowcase();
            window.queueStoryGuessType();
            window.queueHeroWebGL();
            window.queueHeroVideo();
            window.queueHeroType();
        };

        if (window.Blazor && typeof window.Blazor.addEventListener === 'function') {
            window.Blazor.addEventListener('enhancedload', onEnhancedLoad);
        }

        document.addEventListener('enhancedload', onEnhancedLoad);
        document.addEventListener('blazor:enhancedload', onEnhancedLoad);
    </script>
</body>

</html>

@code {
    private string InitialPath =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsHomeRoute => string.IsNullOrEmpty(InitialPath);

    private bool IsStoryRoute =>
        string.Equals(
            InitialPath,
            "story",
            StringComparison.OrdinalIgnoreCase);

    private string InitialThemeColor =>
        IsStoryRoute
            ? "#0f0f11"
            : IsHomeRoute
                ? "#817c78"
                : "#958276";

    // Safari 26 derives its top chrome from the document background instead of
    // reliably honoring a theme-color mutation after the first paint. Emit the
    // hero routes' backgrounds in the initial HTML so their safe areas never
    // start cream.
    private string? InitialDocumentBackground =>
        IsStoryRoute || IsHomeRoute ? $"background-color: {InitialThemeColor};" : null;
}
