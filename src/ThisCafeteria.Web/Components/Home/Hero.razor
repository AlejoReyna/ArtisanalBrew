<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@@100..900&display=swap');

    .font-Outfit {
        font-family: 'Outfit', sans-serif !important;
    }

    .hero-credit {
        position: absolute;
        bottom: clamp(1rem, 2vw, 1.5rem);
        right: clamp(1rem, 2vw, 2rem);
        font-family: var(--font-sans);
        font-size: 0.7rem;
        color: white;
        text-decoration: none;
        opacity: 0.6;
        transition: opacity 200ms ease;
        z-index: 2;
    }

    .hero-credit:hover {
        opacity: 1;
        text-decoration: underline;
    }

    /* --- Hero entrance sequence (see wwwroot/js/heroType.js) ---
       Everything below is gated on .has-hero-type, which heroType.js sets on the root
       element while it parses. No script, no hidden state: the hero is plain markup. */

    /* Words are nowrap boxes so splitting the headline into per-character spans can't
       introduce a break the browser wouldn't have taken anyway. */
    .hero-headline .hero-word {
        display: inline-block;
    }

    .hero-char {
        position: relative;
    }

    .hero-char--space {
        white-space: pre;
    }

    /* Characters are already laid out — only their opacity changes — so the lines below
       the headline never shift as it types. The short fade softens the leading edge
       without smearing at a 26ms cadence. */
    .has-hero-type .hero-headline .hero-char {
        opacity: 0;
        transition: opacity 80ms linear;
    }

    .has-hero-type .hero-headline .hero-char.is-typed {
        opacity: 1;
    }

    .hero-headline.is-instant .hero-char {
        transition: none;
    }

    /* The caret is a pseudo-element on the character being typed, so it tracks the text
       across line wraps for free and costs no layout.
       Insets are measured against the inline box (ascent + descent ≈ 1.32em here), not
       the font size — hence the asymmetric values: the bar runs from just above the cap
       height down to a hair below the baseline, like a text cursor, rather than filling
       the full em box. */
    .has-hero-type .hero-headline .hero-char::after,
    .has-hero-type .hero-headline.is-armed .hero-char--lead::before {
        background: currentColor;
        bottom: 0.2em;
        content: "";
        min-width: 2px;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        top: 0.33em;
        width: 0.05em;
    }

    .has-hero-type .hero-headline .hero-char::after {
        right: -0.1em;
    }

    /* Solid while typing — a caret only blinks when it's waiting for you. */
    .has-hero-type .hero-headline .hero-char.is-cursor::after {
        opacity: 1;
    }

    .has-hero-type .hero-headline.is-armed .hero-char--lead::before {
        animation: hero-caret-blink 1.05s steps(1, end) infinite;
        left: -0.14em;
    }

    .has-hero-type .hero-headline.is-done .hero-char.is-cursor::after {
        opacity: 0;
        transition: opacity 260ms ease;
    }

    @@keyframes hero-caret-blink {
        0%, 45% {
            opacity: 1;
        }

        55%, 100% {
            opacity: 0;
        }
    }

    /* The lede and the credit, in that order, once the headline has landed. */
    .has-hero-type [data-hero-step] {
        filter: blur(6px);
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 620ms cubic-bezier(0.23, 1, 0.32, 1),
                    transform 620ms cubic-bezier(0.23, 1, 0.32, 1),
                    filter 620ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .has-hero-type [data-hero-step].is-revealed {
        filter: blur(0);
        opacity: var(--hero-step-opacity, 1);
        transform: translateY(0);
    }

    .has-hero-type [data-hero-step].is-instant {
        transition: none;
    }

    /* A footnote shouldn't arrive with the same weight as the copy — and this transition
       is the one the hover state inherits, so it stays short. */
    .has-hero-type .hero-credit[data-hero-step] {
        --hero-step-opacity: 0.6;
        filter: none;
        transform: none;
        transition: opacity 260ms ease;
    }

    @@media (prefers-reduced-motion: reduce) {
        .has-hero-type .hero-headline .hero-char {
            transition: opacity 200ms ease;
        }

        .has-hero-type .hero-headline .hero-char::after,
        .has-hero-type .hero-headline.is-armed .hero-char--lead::before {
            display: none;
        }

        .has-hero-type [data-hero-step] {
            filter: none;
            transform: none;
            transition: opacity 300ms ease;
        }
    }
</style>

<section class="hero editorial-hero editorial-hero--coffee" id="hero-section" data-theme-color="#523d26">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/about-wallpaper.jpg" aria-hidden="true">
        <source src="/images/bg_video.mp4" type="video/mp4">
    </video>
    <canvas class="hero-canvas" id="hero-webgl-canvas" aria-hidden="true"></canvas>
    <div class="hero__content">
        <h1 class="hero-headline" data-hero-type>A sanctuary for the <span class="headline-italic">patient brewer.</span></h1>
        <p class="lede font-Outfit" data-hero-step>
            Embrace the slow living movement with seasonal coffee, manual brewing, and pastry made for lingering.
        </p>
    </div>
    <a href="https://www.pexels.com/@@pavel-danilyuk/" target="_blank" rel="noopener noreferrer" class="hero-credit" data-hero-step>
        Video by Pavel Danilyuk
    </a>
</section>
