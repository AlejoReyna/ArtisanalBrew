<section class="pd-section" aria-labelledby="product-discovery-title">
    <div class="pd-shell">
        <div class="pd-robot-column">
            <p class="pd-kicker">MARKET SCOUT // ONLINE</p>

            <div class="pd-thoughts" aria-label="The robot is thinking">
                <span class="pd-thought pd-thought--one">ORIGIN?</span>
                <span class="pd-thought pd-thought--two">LIGHT OR DARK?</span>
                <span class="pd-thought pd-thought--three">ADD TO BAG!</span>
            </div>

            <div class="pd-scene">
                <img src="images/ph-marketplace-robot.png"
                     alt="A pixel robot wearing glasses, seated at a wooden table and browsing coffee on a laptop" />
            </div>

            <p class="pd-scene-caption">
                CURATING A BETTER MORNING
                <span aria-hidden="true">•••</span>
            </p>
        </div>

        <div class="pd-content-column">
            <div class="pd-heading">
                <h2 id="product-discovery-title">Find your next daily ritual.</h2>
            </div>

            <p class="pd-copy">
                The products view brings every small-batch roast, brew tool and
                ceramic into one focused storefront. Filter the collection,
                compare the essentials and move from discovery to checkout
                without losing your place.
            </p>

            <div class="pd-catalog" aria-label="Preview of the products view">
                <div class="pd-catalog__chrome">
                    <span class="pd-catalog__lights" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="pd-catalog__address">ARTISANAL.BREW / PRODUCTS</span>
                    <span class="pd-catalog__signal" aria-hidden="true">▮▮▮</span>
                </div>

                <div class="pd-catalog__toolbar">
                    <div class="pd-catalog__tabs">
                        <span class="is-active">ALL ITEMS</span>
                        <span>BEANS</span>
                        <span>EQUIPMENT</span>
                    </div>
                    <span class="pd-catalog__filter">☷ FILTERS</span>
                </div>

                <div class="pd-products">
                    <article class="pd-product">
                        <div class="pd-product__image pd-product__image--colombia">
                            <img src="images/colombia.webp" alt="" />
                            <span aria-hidden="true">♡</span>
                        </div>
                        <p>SINGLE ORIGIN</p>
                        <h3>Colombia Huila</h3>
                        <div class="pd-product__meta">
                            <b>$28.20</b>
                            <span aria-label="4 out of 5 stars">★★★★<i>★</i></span>
                        </div>
                    </article>

                    <article class="pd-product">
                        <div class="pd-product__image pd-product__image--ethiopia">
                            <img src="images/ethiopia.webp" alt="" />
                            <span aria-hidden="true">♡</span>
                        </div>
                        <p>SINGLE ORIGIN</p>
                        <h3>Ethiopia Yirgacheffe</h3>
                        <div class="pd-product__meta">
                            <b>$29.60</b>
                            <span aria-label="5 out of 5 stars">★★★★★</span>
                        </div>
                    </article>

                    <article class="pd-product pd-product--third">
                        <div class="pd-product__image pd-product__image--chiapas">
                            <img src="images/chiapas.webp" alt="" />
                            <span aria-hidden="true">♡</span>
                        </div>
                        <p>SINGLE ORIGIN</p>
                        <h3>Mexico Chiapas</h3>
                        <div class="pd-product__meta">
                            <b>$25.20</b>
                            <span aria-label="4 out of 5 stars">★★★★<i>★</i></span>
                        </div>
                    </article>
                </div>
            </div>

            <a class="pd-link" href="/products">
                BROWSE THE FULL COLLECTION <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
