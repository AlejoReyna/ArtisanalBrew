@if (_isDeleteAccountModalOpen)
{
    <div class="wallet-modal" role="presentation" @onclick="CloseDeleteAccountModal">
        <section class="wallet-modal__panel"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="delete-account-modal-title"
                 @onclick:stopPropagation="true">
            <div class="wallet-modal__header">
                <div class="wallet-modal__title-group">
                    <h2 id="delete-account-modal-title">Delete your account?</h2>
                </div>
                <button class="wallet-modal__close"
                        type="button"
                        aria-label="Close"
                        disabled="@_isDeletingAccount"
                        @onclick="CloseDeleteAccountModal">
                    ×
                </button>
            </div>

            <p class="wallet-modal__note">
                This permanently deletes your profile, cart, and order history from the database. This
                cannot be undone.
            </p>

            @if (!string.IsNullOrWhiteSpace(_deleteAccountError))
            {
                <p class="wallet-modal__error">@_deleteAccountError</p>
            }

            <div class="delete-account-modal__actions">
                <button type="button"
                        class="delete-account-modal__cancel"
                        disabled="@_isDeletingAccount"
                        @onclick="CloseDeleteAccountModal">
                    Cancel
                </button>
                <button type="button"
                        class="delete-account-modal__confirm"
                        disabled="@_isDeletingAccount"
                        @onclick="ConfirmDeleteAccountAsync">
                    @(_isDeletingAccount ? "Deleting..." : "Delete my account")
                </button>
            </div>
        </section>
    </div>
}

@if (_isWalletModalOpen)
{
    <div class="wallet-modal" role="presentation" @onclick="CloseWalletModal">
        <section class="wallet-modal__panel"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="wallet-modal-title"
                 @onclick:stopPropagation="true">
            <div class="wallet-modal__header">
                <div class="network-selector-wrapper" style="position: absolute; top: 0; left: 0; margin-top: 0;">
                    <button type="button" class="network-selector-btn" @onclick="ToggleNetworkDropdown">
                        <img src="@SelectedChain.IconAsset" width="14" height="14" alt="" style="border-radius: 50%;" />
                        <span class="network-name">@SelectedChain.DisplayName</span>
                        <span class="network-dropdown-icon">▼</span>
                    </button>
                    
                    @if (_isNetworkDropdownOpen)
                    {
                        <div class="network-dropdown-backdrop" @onclick="ToggleNetworkDropdown" style="position: fixed; inset: 0; z-index: 99; cursor: default;"></div>
                        <ul class="network-dropdown-menu">
                            @foreach (var chain in ChainRegistry.All.Where(c => c.Enabled))
                            {
                                <li>
                                    <button type="button" @onclick="() => SelectNetworkAsync(chain.Key)" style="display: flex; align-items: center; gap: 0.4rem;">
                                        <img src="@chain.IconAsset" width="16" height="16" alt="" style="border-radius: 50%;" />
                                        @chain.DisplayName
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                
                <div class="wallet-modal__title-group">
                    <h2 id="wallet-modal-title">Connect your wallet</h2>
                    <hr class="wallet-modal__divider" />
                    <p class="wallet-modal__description">Even this is an open-source project, I encourage to test the site with a temporal hot wallet</p>
                </div>
                <button class="wallet-modal__close"
                        type="button"
                        aria-label="Close wallet selection"
                        @onclick="CloseWalletModal">
                </button>
            </div>

            <div class="wallet-options">
                @if (SelectedChain.Family == ChainFamily.Solana)
                {
                    @if (SelectedChain.Capabilities.WalletLogin)
                    {
                        <button class="wallet-option"
                                type="button"
                                disabled="@_isConnecting"
                                @onclick='() => ConnectWalletAsync("Phantom")'>
                            <span class="wallet-option__icon wallet-option__icon--phantom" aria-hidden="true">
                                <img src="images/phantom.webp" alt="" loading="lazy" />
                            </span>
                        </button>
                    }
                    else
                    {
                        <p class="wallet-modal__note">Install a Solana Wallet Standard wallet to connect to this verified deployment.</p>
                    }
                }
                else
                {
                <button class="wallet-option"
                        type="button"
                        disabled="@_isConnecting"
                        @onclick='() => ConnectWalletAsync("MetaMask")'>
                    <span class="wallet-option__icon wallet-option__icon--metamask" aria-hidden="true">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/3/36/MetaMask_Fox.svg" alt="" loading="lazy" />
                    </span>
                </button>

                <button class="wallet-option"
                        type="button"
                        disabled="@_isConnecting"
                        @onclick='() => ConnectWalletAsync("Phantom")'>
                    <span class="wallet-option__icon wallet-option__icon--phantom" aria-hidden="true">
                        <img src="images/phantom.webp" alt="" loading="lazy" />
                    </span>
                </button>

                <button class="wallet-option"
                        type="button"
                        disabled="@_isConnecting"
                        @onclick='() => ConnectWalletAsync("Coinbase Wallet")'>
                    <span class="wallet-option__icon wallet-option__icon--coinbase" aria-hidden="true">
                        <img src="https://avatars.githubusercontent.com/u/18060234?s=200&amp;v=4" alt="" loading="lazy" />
                    </span>
                </button>

                <button class="wallet-option"
                        type="button"
                        disabled="@_isConnecting"
                        @onclick='() => ConnectWalletAsync("Brave Wallet")'>
                    <span class="wallet-option__icon wallet-option__icon--brave" aria-hidden="true">
                        <img src="images/brave_logo.png" alt="" loading="lazy" />
                    </span>
                </button>


                }
            </div>



            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p class="wallet-modal__status">@_statusMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p class="wallet-modal__error">@_errorMessage</p>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public bool TransparentHeader { get; set; }

    private bool _isNavOpen;
    private int _cartItemCount;
    private CoffeeDashboardModel? _walletSnapshot;
    private ChainDefinition SelectedChain => SelectedChainAccessor.SelectedChain;
    private bool _isLoadingWalletStats;
    private IJSObjectReference? _walletModule;
    private bool _isWalletModalOpen;
    private bool _isUserMenuOpen;
    private bool _isUserMenuRendered;
    private CancellationTokenSource? _userMenuTransitionCancellation;
    private bool _isConnecting;
    private string? _statusMessage;
    private string? _errorMessage;
    private bool _isDeleteAccountModalOpen;
    private bool _isDeletingAccount;
    private string? _deleteAccountError;
    private const int UserMenuTransitionMilliseconds = 360;

    private bool _isNetworkDropdownOpen = false;

    // Deactivated for now: the toggle UI is hidden below (desktop + drawer)
    // while /staking is pinned to a permanent dark default (see app.css). Flip
    // back to true to restore the light/dark/system switch.
    private const bool ThemeToggleEnabled = false;

    // Light/dark/system theme toggle. 'system' means no explicit choice is
    // stored — the CSS prefers-color-scheme tier decides. The actual applied
    // value lives in the `data-theme` attribute on <html>, set synchronously by
    // the blocking script in App.razor's <head> before first paint; this field
    // only mirrors it so the toggle button can show the right icon/label.
    private string _theme = "system";

    private string ThemeToggleLabel => _theme switch
    {
        "dark" => "Theme: Dark (click for Light)",
        "light" => "Theme: Light (click for System)",
        _ => "Theme: System (click for Dark)"
    };

    private async Task CycleThemeAsync()
    {
        _theme = await JsRuntime.InvokeAsync<string>("artisanalTheme.cycle");
    }

    private void ToggleNetworkDropdown()
    {
        _isNetworkDropdownOpen = !_isNetworkDropdownOpen;
    }

    private async Task SelectNetworkAsync(string key)
    {
        _isNetworkDropdownOpen = false;
        StateHasChanged();
        
        if (string.IsNullOrWhiteSpace(key) || !await SelectedChainAccessor.SelectAsync(key)) return;
        
        await JsRuntime.InvokeVoidAsync("artisanalChainSelector.persist", key);
        await HandleChainChangedAsync(SelectedChainAccessor.SelectedChain);
    }

    private string NavMenuCssClass => _isNavOpen ? "nav-links nav-links--open" : "nav-links";

    // StakingLayout opts into the transparent header explicitly. Story uses
    // MainLayout, so its route opts in here and lets the hero artwork continue
    // beneath the same component-owned transparent treatment.
    private bool IsStoryRoute
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relativePath.Split('?', '#')[0].Trim('/');
            return path.Equals("story", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool IsHomeRoute
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relativePath.Split('?', '#')[0].Trim('/');
            return string.IsNullOrEmpty(path);
        }
    }

    private string HeaderCssClass =>
        IsStoryRoute
            ? "public-header public-header--transparent public-header--story"
            : IsHomeRoute || TransparentHeader
                ? "public-header public-header--transparent"
                : "public-header";

    private string UserToggleCssClass => _isUserMenuOpen ? "nav-login active" : "nav-login";

    private string UserMenuBackdropCssClass =>
        _isUserMenuOpen ? "user-menu-backdrop user-menu-backdrop--open" : "user-menu-backdrop";

    private string UserMenuCssClass =>
        _isUserMenuOpen ? "user-menu user-menu--open" : "user-menu";

    private string UserMenuAriaHidden => _isUserMenuOpen ? "false" : "true";

    private string CartAriaLabel =>
        _cartItemCount > 0 ? $"Cart, {_cartItemCount} items" : "Cart";

    private string NavDrawerBackdropCssClass =>
        _isNavOpen ? "nav-drawer-backdrop nav-drawer-backdrop--open" : "nav-drawer-backdrop";

    private string NavDrawerCssClass =>
        _isNavOpen ? "nav-drawer nav-drawer--open" : "nav-drawer";

    private string NavDrawerAriaHidden =>
        _isNavOpen ? "false" : "true";

    private string FormatStakedBalance() =>
        _walletSnapshot is null ? "—" : $"{_walletSnapshot.StakedPaymentTokenBalance:0.####} CAFE";

    private string FormatPendingRewards() =>
        _walletSnapshot?.PendingStakingRewards is { } pendingRewards
            ? $"{pendingRewards:0.####} COFFEE"
            : "—";

    private string GetChainHoverBackground()
    {
        if (SelectedChain.Family == ChainFamily.Solana)
        {
            return "linear-gradient(260deg, #14F195 0%, #9945FF 100%)";
        }
        if (SelectedChain.Key.Contains("bsc", StringComparison.OrdinalIgnoreCase))
        {
            return "#F3BA2F";
        }
        return "#627ee9";
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("NavMenu OnInitializedAsync START");
        CartService.Changed += OnCartChanged;
        DashboardState.Changed += OnWalletDashboardChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _walletSnapshot = DashboardState.Snapshot;
        await CartService.RefreshFromStorageAsync();
        await RefreshCartCountAsync();
        Logger.LogInformation("NavMenu OnInitializedAsync END. CartItemCount={Count}", _cartItemCount);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JsRuntime.InvokeAsync<string>("artisanalTheme.current");
            StateHasChanged();

            // The DOMContentLoaded listener in App.razor calls initPublicHeader too
            // (via queuePublicHeader's double-rAF defer), but on a cold load that can
            // race ahead of the circuit attaching this component, or the rAF pair can
            // simply fail to fire promptly right after navigation — either way it can
            // leave the safe-area strip on the light fallback color instead of the
            // current section's data-theme-color. Call the function directly (not
            // through the rAF-queued wrapper) since OnAfterRenderAsync already runs
            // after this DOM is committed, so there's nothing left to wait for.
            await JsRuntime.InvokeVoidAsync("initPublicHeader");
        }
    }

    private void OnCartChanged() => _ = InvokeAsync(RefreshCartCountAsync);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Blazor Server's interactive routing swaps @Body without a page reload or an
        // "enhancedload" event, so the header's hero/scroll JS (bound once on first load)
        // never reruns and can leave stale inline styles (e.g. navbar-brand color) behind.
        _ = InvokeAsync(async () =>
        {
            await JsRuntime.InvokeVoidAsync("queuePublicHeader");
            StateHasChanged(); // recompute HeaderCssClass for the new route
        });
    }

    private async Task RefreshCartCountAsync()
    {
        _cartItemCount = await CartService.GetItemCountAsync();
        StateHasChanged();
    }

    private async Task ToggleNav()
    {
        _isNavOpen = !_isNavOpen;
        if (_isNavOpen)
        {
            _ = LoadWalletStatsAsync();
            await JsRuntime.InvokeVoidAsync("themeColor.set", "#fbf9f4");
        }
        else
        {
            await JsRuntime.InvokeVoidAsync("themeColor.restore");
        }
    }

    private void OnWalletDashboardChanged()
    {
        _walletSnapshot = DashboardState.Snapshot;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleChainChangedAsync(ChainDefinition chain)
    {
        _walletSnapshot = null;
        await InvokeAsync(StateHasChanged);
        if (_isNavOpen)
        {
            await LoadWalletStatsAsync();
        }
    }

    private async Task LoadWalletStatsAsync()
    {
        if (_isLoadingWalletStats)
        {
            return;
        }

        _isLoadingWalletStats = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var wallet = GetWalletAddress(authState.User);
            if (authState.User.Identity?.IsAuthenticated != true ||
                string.IsNullOrWhiteSpace(wallet) ||
                (SelectedChain.Family == ChainFamily.Evm && (!wallet.StartsWith("0x", StringComparison.OrdinalIgnoreCase) || wallet.Length != 42)) ||
                (SelectedChain.Family == ChainFamily.Solana && !SolanaBase58.IsPublicKey(wallet)))
            {
                return;
            }

            _walletSnapshot = await DashboardState.GetOrRefreshAsync(SelectedChain.Key, SelectedChain.FamilyName, wallet, TimeSpan.FromSeconds(60));
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not load wallet stats for the nav drawer.");
        }
        finally
        {
            _isLoadingWalletStats = false;
        }
    }

    private void CloseNav()
    {
        if (_isNavOpen)
        {
            _isNavOpen = false;
            _ = JsRuntime.InvokeVoidAsync("themeColor.restore");
        }
    }

    private async Task ToggleUserMenu()
    {
        if (_isUserMenuOpen)
        {
            await CloseUserMenuAsync();
            return;
        }

        await OpenUserMenuAsync();
    }

    private async Task OpenUserMenuAsync()
    {
        _userMenuTransitionCancellation?.Cancel();
        _userMenuTransitionCancellation?.Dispose();
        _userMenuTransitionCancellation = null;

        _isNavOpen = false;
        _isUserMenuRendered = true;

        await InvokeAsync(StateHasChanged);
        // Esperamos a que el navegador pinte el menú fuera de la pantalla antes de animarlo hacia adentro
        await Task.Delay(50);

        _isUserMenuOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseUserMenuAsync()
    {
        if (!_isUserMenuRendered)
        {
            return;
        }

        _userMenuTransitionCancellation?.Cancel();
        _userMenuTransitionCancellation?.Dispose();
        _userMenuTransitionCancellation = new CancellationTokenSource();
        var cancellationToken = _userMenuTransitionCancellation.Token;

        _isUserMenuOpen = false;

        try
        {
            await Task.Delay(UserMenuTransitionMilliseconds, cancellationToken);
            _isUserMenuRendered = false;
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OpenWalletModal()
    {
        CloseNav();
        _isUserMenuOpen = false;
        _isUserMenuRendered = false;
        _isWalletModalOpen = true;
        _statusMessage = null;
        _errorMessage = null;
    }

    private void CloseWalletModal()
    {
        if (_isConnecting)
        {
            return;
        }

        _isWalletModalOpen = false;
        _statusMessage = null;
        _errorMessage = null;
    }

    private async Task ConnectWalletAsync(string walletName)
    {
        _isConnecting = true;
        _errorMessage = null;
        _statusMessage = $"Opening {walletName}...";

        try
        {
            if (_walletModule is not null) await _walletModule.DisposeAsync();
            _walletModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", SelectedChain.Family == ChainFamily.Solana ? "/js/solanaWalletAuth.js" : "/js/walletAuth.js");
            var result = await _walletModule.InvokeAsync<WalletLoginResult>("loginWithWallet", walletName);

            if (!result.Success)
            {
                _errorMessage = result.Error ?? "Wallet login could not be completed.";
                _statusMessage = null;
                return;
            }

            _statusMessage = $"Signed in as {ShortAddress(result.Address)}.";
            if (result.StatusStored || result.StatusPublished)
            {
                _statusMessage = result.StatusPublished
                    ? $"Signed in as {ShortAddress(result.Address)}. Status published."
                    : $"Signed in as {ShortAddress(result.Address)}. Status saved.";
            }
            Navigation.NavigateTo(result.RedirectUrl ?? "/", forceLoad: true);
        }
        catch (JSException exception)
        {
            _errorMessage = exception.Message;
            _statusMessage = null;
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private void OpenDeleteAccountModal()
    {
        _isNavOpen = false;
        _isUserMenuOpen = false;
        _isUserMenuRendered = false;
        _isDeleteAccountModalOpen = true;
        _deleteAccountError = null;
    }

    private void CloseDeleteAccountModal()
    {
        if (_isDeletingAccount)
        {
            return;
        }

        _isDeleteAccountModalOpen = false;
        _deleteAccountError = null;
    }

    private async Task ConfirmDeleteAccountAsync()
    {
        _isDeletingAccount = true;
        _deleteAccountError = null;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var applicationUserId = UserManager.GetUserId(authState.User);
            if (string.IsNullOrWhiteSpace(applicationUserId))
            {
                _deleteAccountError = "Your session has expired. Please log in again.";
                return;
            }

            var applicationUser = await UserManager.FindByIdAsync(applicationUserId);
            if (applicationUser is null)
            {
                _deleteAccountError = "Your session has expired. Please log in again.";
                return;
            }

            if (applicationUser.UserProfileId is { } userProfileId)
            {
                await ProfileService.DeleteAccountAsync(userProfileId);
            }

            var deleteResult = await UserManager.DeleteAsync(applicationUser);
            if (!deleteResult.Succeeded)
            {
                _deleteAccountError = string.Join(" ", deleteResult.Errors.Select(error => error.Description));
                return;
            }

            await SignInManager.SignOutAsync();
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not delete the authenticated user's account.");
            _deleteAccountError = "Something went wrong deleting your account. Please try again.";
        }
        finally
        {
            _isDeletingAccount = false;
        }
    }

    private static string ShortAddress(string? address)
    {
        if (string.IsNullOrWhiteSpace(address) || address.Length < 12)
        {
            return address ?? "Wallet";
        }

        return $"{address[..6]}...{address[^4..]}";
    }

    private static string? GetWalletAddress(ClaimsPrincipal? user)
    {
        return user?.FindFirst("wallet_address")?.Value
            ?? user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    public void Dispose()
    {
        CartService.Changed -= OnCartChanged;
        DashboardState.Changed -= OnWalletDashboardChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();

        if (_walletModule is not null)
        {
            try
            {
                await _walletModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone (e.g. a forceLoad navigation), so there's
                // no connection left to send the JS dispose call over.
            }
        }

        _userMenuTransitionCancellation?.Cancel();
        _userMenuTransitionCancellation?.Dispose();
    }

    private sealed class WalletLoginResult
    {
        public bool Success { get; set; }
        public string? Address { get; set; }
        public string? RedirectUrl { get; set; }
        public string? Error { get; set; }
        public bool StatusStored { get; set; }
        public bool StatusPublished { get; set; }
        public string? AwsMessageId { get; set; }
    }
}
