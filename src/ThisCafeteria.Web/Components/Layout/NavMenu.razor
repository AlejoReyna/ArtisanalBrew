@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IShoppingCartService CartService
@inject ILogger<NavMenu> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WalletDashboardState DashboardState
@inject BlockchainNetworkOptions Chain
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IProfileService ProfileService
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Application.Services.Blockchain
@using ThisCafeteria.Infrastructure.Identity
@using ThisCafeteria.Web.Services.Blockchain
@using ThisCafeteria.Web.Services.Cart
@using System.Security.Claims

<header class="@HeaderCssClass">
<nav class="site-nav" aria-label="Primary navigation">
    <a class="navbar-brand" href="">Artisanal Brew</a>

    <button class="navbar-toggler"
            type="button"
            aria-label="Toggle navigation menu"
            aria-expanded="@_isNavOpen"
            @onclick="ToggleNav">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <div class="@NavMenuCssClass">
        <NavLink class="nav-link" href="products" Match="NavLinkMatch.All" @onclick="CloseNav">
            Shop
        </NavLink>

        @* <NavLink class="nav-link" href="journal" @onclick="CloseNav">
            Journal
        </NavLink> *@

        <NavLink class="nav-link" href="staking" @onclick="CloseNav">
            Yield
        </NavLink>

        <NavLink class="nav-link" href="procurement-lab" @onclick="CloseNav">
            Lab
        </NavLink>

        <NavLink class="nav-link nav-link--about" href="story" @onclick="CloseNav">
            About
        </NavLink>
    </div>

    <div class="nav-utilities">
        @if (ThemeToggleEnabled)
        {
            <button class="theme-toggle"
                    type="button"
                    aria-label="@ThemeToggleLabel"
                    title="@ThemeToggleLabel"
                    @onclick="CycleThemeAsync">
                <span class="theme-toggle__icon" aria-hidden="true">
                    @if (_theme == "dark")
                    {
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                    }
                    else if (_theme == "light")
                    {
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    }
                    else
                    {
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 000 18z" fill="currentColor" stroke="none"/></svg>
                    }
                </span>
            </button>
        }
        <AuthorizeView>
            <Authorized>
                <button class="nav-login nav-login--authorized"
                        type="button"
                        aria-label="Open profile"
                        @onclick="@(() => Navigation.NavigateTo("profile"))">
                    <img class="eth-mark" src="@SelectedChain.IconAsset" alt="" aria-hidden="true" width="28" height="28" />
                    <span class="nav-login__text-stack">
                        <span class="nav-login__address">@ShortAddress(GetWalletAddress(context.User))</span>
                        <span class="nav-login__chain" aria-hidden="true">@SelectedChain.ShortName</span>
                    </span>
                </button>
                <a href="cart" class="nav-cart" aria-label="@CartAriaLabel" @onclick="CloseNav">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    @if (_cartItemCount > 0)
                    {
                        <span class="nav-cart__badge">@_cartItemCount</span>
                    }
                </a>
            </Authorized>
            <NotAuthorized>
                <button class="nav-login"
                        type="button"
                        aria-haspopup="dialog"
                        @onclick="OpenWalletModal"
                        style="--chain-hover: @GetChainHoverBackground();">
                    <img class="eth-mark" src="@SelectedChain.IconAsset" alt="" aria-hidden="true" width="27" height="27" />
                    <span class="nav-login__label">Login</span>
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
</header>
        <div class="nav-drawer-backdrop @NavDrawerBackdropCssClass" role="presentation" @onclick="CloseNav"></div>
<aside class="nav-drawer @NavDrawerCssClass" aria-label="Mobile navigation" aria-hidden="@NavDrawerAriaHidden">
    <header class="nav-drawer__header">
        <div class="nav-drawer__wallet">
            <AuthorizeView>
                <Authorized>
                    <img class="eth-mark" src="@SelectedChain.IconAsset" alt="" aria-hidden="true" width="20" height="20" style="margin-right: 4px;" />
                    <span class="crypto-dot crypto-dot--pulse" aria-hidden="true"></span>
                    <span class="nav-drawer__address" title="@GetWalletAddress(context.User)">
                        @ShortAddress(GetWalletAddress(context.User))
                    </span>
                </Authorized>
                <NotAuthorized>
                    <span class="nav-drawer__wordmark">Artisanal Brew</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        <button class="nav-drawer__close" type="button" aria-label="Close menu" @onclick="CloseNav"></button>
    </header>

    <div class="nav-drawer__body">
        <ChainSelector CssClass="nav-drawer__chain-selector" OnChainChanged="HandleChainChangedAsync" />
        <AuthorizeView>
            <Authorized>
                <div class="nav-drawer__stats">
                    <div class="nav-drawer__stat">
                        <span class="nav-drawer__stat-label">Staked</span>
                        <span class="nav-drawer__stat-value">@FormatStakedBalance()</span>
                    </div>
                    <div class="nav-drawer__stat">
                        <span class="nav-drawer__stat-label">Rewards</span>
                        <span class="nav-drawer__stat-value nav-drawer__stat-value--pos">@FormatPendingRewards()</span>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <nav class="nav-drawer__grid" aria-label="Primary sections">
            <NavLink class="nav-drawer__tile" href="products" Match="NavLinkMatch.All" @onclick="CloseNav">
                <span class="nav-drawer__tile-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                </span>
                <span class="nav-drawer__tile-label">Shop</span>
                @if (_cartItemCount > 0)
                {
                    <span class="nav-drawer__tile-badge">@_cartItemCount</span>
                }
            </NavLink>
            @* <NavLink class="nav-drawer__tile" href="journal" @onclick="CloseNav">
                <span class="nav-drawer__tile-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </span>
                <span class="nav-drawer__tile-label">Journal</span>
            </NavLink> *@
            <NavLink class="nav-drawer__tile" href="staking" @onclick="CloseNav">
                <span class="nav-drawer__tile-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
                </span>
                <span class="nav-drawer__tile-label">Yield</span>
            </NavLink>
            <NavLink class="nav-drawer__tile" href="procurement-lab" @onclick="CloseNav">
                <span class="nav-drawer__tile-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                </span>
                <span class="nav-drawer__tile-label">Lab</span>
            </NavLink>
            <NavLink class="nav-drawer__tile" href="story" @onclick="CloseNav">
                <span class="nav-drawer__tile-icon" aria-hidden="true">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </span>
                <span class="nav-drawer__tile-label">About</span>
            </NavLink>
        </nav>
    </div>

    <footer class="nav-drawer__foot">
        <AuthorizeView>
            <Authorized>
                <NavLink href="staking" class="nav-drawer__cta" @onclick="CloseNav">New Stake</NavLink>
                <a href="cart" class="nav-drawer__cta nav-drawer__cta--outline" @onclick="CloseNav">
                    Cart @if (_cartItemCount > 0) { <span>(@_cartItemCount)</span> }
                </a>
                <form method="post" action="/api/wallet-auth/logout" class="nav-drawer__logout">
                    <button type="submit">Disconnect</button>
                </form>
                <div class="nav-drawer__delete-account">
                    <button type="button" @onclick="OpenDeleteAccountModal">Delete Account</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <button class="nav-drawer__cta" type="button" @onclick="OpenWalletModal">Connect Wallet</button>
                <a href="cart" class="nav-drawer__cta nav-drawer__cta--outline" @onclick="CloseNav">Cart</a>
            </NotAuthorized>
        </AuthorizeView>
        @if (ThemeToggleEnabled)
        {
            <button class="nav-drawer__theme-toggle" type="button" @onclick="CycleThemeAsync">
                @ThemeToggleLabel
            </button>
        }
    </footer>
</aside>

