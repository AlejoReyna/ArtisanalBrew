@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>Artisanal Brew Cafeteria</PageTitle>

<Hero />
<Concept />
<Offerings />
<Provenance />
<StakingBand />
<Journal />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.destroy");
        }
        catch
        {
            // JS runtime may already be disconnected during navigation or prerender disposal.
        }
    }
}
