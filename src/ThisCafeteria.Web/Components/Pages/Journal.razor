@page "/journal"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>The Journal | Artisanal Brew</PageTitle>

<div class="journal-page">

    <!-- ==================== HERO ==================== -->
    <section class="journal-hero journal-hero-screen" data-recruiter-section>
        <h1 class="visually-hidden">The Journal — notes from the counter</h1>

        <div class="journal-hero-screen__frame">
            @for (var index = 0; index < JournalCatalog.FeaturedArticles.Count; index++)
            {
                var slide = JournalCatalog.FeaturedArticles[index];
                <div class="journal-hero-screen__slide journal-thumb journal-thumb--@slide.ImageKey"
                     style="animation-delay: @(index * HeroSlideSeconds)s"
                     aria-hidden="true"></div>
            }

            <div class="journal-hero-screen__scrim" aria-hidden="true"></div>

            <div class="journal-hero-screen__content">
                <div class="journal-hero-screen__captions" data-recruiter-animate="lift" data-recruiter-delay="160">
                    @for (var index = 0; index < JournalCatalog.FeaturedArticles.Count; index++)
                    {
                        var article = JournalCatalog.FeaturedArticles[index];
                        <a class="journal-hero-screen__caption"
                           style="animation-delay: @(index * HeroSlideSeconds)s"
                           href="@JournalCatalog.ArticleUrl(article.Slug)">
                            <span class="journal-hero-screen__caption-text">
                                <span class="journal-hero-screen__kicker">Featured</span>
                                <h2>@article.Title</h2>
                                <p>@article.Summary</p>
                                <span class="journal-hero-screen__meta">@article.CategoryLabel · @article.ReadTime</span>
                            </span>
                            <span class="journal-hero-screen__arrow" aria-hidden="true">
                                <svg viewBox="0 0 34 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M0 7H32M32 7L26 1M32 7L26 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FRONT PAGE ==================== -->
    <section class="section journal-news" data-recruiter-section aria-labelledby="journal-news-title">
        <h2 id="journal-news-title" class="journal-news__title" data-recruiter-animate="lift">Recent blog posts</h2>

        <div class="journal-news__grid" data-recruiter-stagger>
            @foreach (var article in JournalCatalog.AllArticles)
            {
                <a class="journal-news__story"
                   href="@JournalCatalog.ArticleUrl(article.Slug)"
                   data-recruiter-animate="lift"
                   aria-label="@($"Read {article.Title}")">
                    <span class="journal-news__image journal-thumb journal-thumb--@article.ImageKey"
                          role="img" aria-label="@article.ImageAriaLabel"></span>
                    <h3>@article.Title</h3>
                    <p>@article.Summary</p>
                    <span class="journal-news__meta">@article.CategoryLabel · @article.ReadTime</span>
                </a>
            }
        </div>

        <div class="journal-news__more">
            <button type="button" class="journal-news__more-btn">Loading more...</button>
        </div>
    </section>

    <!-- ==================== SUBSCRIBE ==================== -->
    <section class="journal-subscribe-band" data-recruiter-section aria-labelledby="join-journal-title">
        <span class="journal-subscribe-band__ring" aria-hidden="true"></span>
        <span class="journal-subscribe-band__ring journal-subscribe-band__ring--outer" aria-hidden="true"></span>

        <div class="journal-subscribe-band__content">
            <p class="eyebrow" data-recruiter-animate="lift">Join the Journal</p>

            <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
                <span class="mask-line"><span class="mask-line__inner">Seasonal notes,</span></span>
                <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">sent with restraint.</em></span></span>
            </h2>

            <p class="journal-subscribe-band__body" data-recruiter-animate="lift" data-recruiter-delay="300">
                Recipes, early releases, and field notes from the brew bar — a few times each season, never more.
            </p>

            <form class="journal-subscribe-band__form" data-recruiter-animate="lift" data-recruiter-delay="440">
                <label class="visually-hidden" for="journal-email">Email address</label>
                <input id="journal-email" name="email" type="email" placeholder="Email address" autocomplete="email" />
                <button type="submit">Subscribe</button>
            </form>

            <p class="journal-subscribe-band__note" data-recruiter-animate="lift" data-recruiter-observe-self>
                We write a few times each season and treat your inbox with the same care as our coffee.
            </p>
        </div>
    </section>

</div>

<style>
    /* ===== Hero ===== */
    .journal-hero-screen {
        background: var(--surface);
        box-sizing: border-box;
        /* .content:has(.journal-page) already zeroes the container's top padding */
        margin: 0 calc(50% - 50vw);
        padding: calc(4.75rem + clamp(1.25rem, 3vw, 2.25rem)) clamp(1rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
        width: 100vw;
    }

    .journal-hero-screen__frame {
        border-radius: clamp(1.25rem, 2.6vw, 2.25rem);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
        margin-inline: auto;
        max-width: 84rem;
        min-height: min(78vh, 44rem);
        overflow: hidden;
        padding: clamp(1.75rem, 4vw, 3rem);
        position: relative;
    }

    .journal-hero-screen__slide {
        animation: journalHeroSlide 28s linear infinite;
        filter: saturate(0.82) contrast(1.08);
        inset: 0;
        opacity: 0;
        position: absolute;
        z-index: -2;
    }

    @@keyframes journalHeroSlide {
        0% { opacity: 0; }
        3.5% { opacity: 1; }
        25% { opacity: 1; }
        28.5% { opacity: 0; }
        100% { opacity: 0; }
    }

    .journal-hero-screen__scrim {
        background:
            linear-gradient(100deg, rgba(20, 16, 14, 0.78) 0%, rgba(20, 16, 14, 0.5) 32%, rgba(20, 16, 14, 0.08) 62%, rgba(20, 16, 14, 0) 78%),
            linear-gradient(180deg, rgba(20, 16, 14, 0) 45%, rgba(20, 16, 14, 0.55) 100%);
        inset: 0;
        position: absolute;
        z-index: -1;
    }

    .journal-hero-screen__content {
        width: 100%;
    }

    .journal-hero-screen__captions {
        display: grid;
    }

    .journal-hero-screen__caption {
        align-items: center;
        animation: journalHeroCaption 28s linear infinite;
        column-gap: clamp(1.5rem, 4vw, 3rem);
        display: flex;
        grid-area: 1 / 1;
        justify-content: space-between;
        opacity: 0;
        text-decoration: none;
        visibility: hidden;
    }

    @@keyframes journalHeroCaption {
        0% { opacity: 0; transform: translateY(0.9rem); visibility: visible; }
        3.5% { opacity: 1; transform: translateY(0); }
        25% { opacity: 1; transform: translateY(0); visibility: visible; }
        28.5% { opacity: 0; transform: translateY(0); visibility: hidden; }
        100% { opacity: 0; visibility: hidden; }
    }

    .journal-hero-screen__caption-text {
        display: flex;
        flex-direction: column;
        max-width: 38rem;
    }

    .journal-hero-screen__kicker {
        color: rgba(255, 253, 249, 0.85);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 0.9rem;
    }

    .journal-hero-screen__caption h2 {
        color: var(--white);
        font-family: var(--font-sans);
        font-size: clamp(1.65rem, 3.2vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.01em;
        line-height: 1.18;
        margin: 0;
    }

    .journal-hero-screen__caption p {
        color: rgba(255, 253, 249, 0.72);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0.9rem 0 0;
        max-width: 34rem;
    }

    .journal-hero-screen__meta {
        color: rgba(255, 253, 249, 0.5);
        font-family: var(--crypto-mono);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        margin-top: 1rem;
        text-transform: uppercase;
    }

    .journal-hero-screen__arrow {
        align-items: center;
        border: 1px solid rgba(255, 253, 249, 0.4);
        border-radius: 50%;
        color: var(--white);
        display: flex;
        flex: none;
        height: clamp(3rem, 4.5vw, 3.75rem);
        justify-content: center;
        transition: background 180ms ease, border-color 180ms ease;
        width: clamp(3rem, 4.5vw, 3.75rem);
    }

    .journal-hero-screen__arrow svg {
        height: 0.85rem;
        width: 1.6rem;
    }

    .journal-hero-screen__caption:hover .journal-hero-screen__arrow {
        background: rgba(255, 253, 249, 0.14);
        border-color: rgba(255, 253, 249, 0.7);
    }

    /* ===== Front page grid ===== */
    .journal-news {
        background: var(--white);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        padding-block: clamp(3rem, 7vw, 5.5rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        width: 100vw;
    }

    .journal-news__title {
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
        font-weight: 800;
        margin: 0 auto clamp(1.75rem, 4vw, 2.75rem);
        max-width: 78rem;
    }

    .journal-news__grid {
        display: grid;
        gap: clamp(1.75rem, 3vw, 2.5rem);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-inline: auto;
        max-width: 78rem;
    }

    .journal-news__story {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 1.25rem;
        color: var(--ink);
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        padding: 1.1rem;
        text-decoration: none;
        transition: border-color 180ms ease, box-shadow 180ms ease;
    }

    .journal-news__story:hover {
        border-color: var(--accent);
        box-shadow: 0 0.75rem 1.75rem rgba(45, 36, 33, 0.08);
    }

    .journal-news__story h3 {
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 1.05rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        line-height: 1.25;
        margin: 0 0 0.6rem;
        transition: color 180ms ease;
    }

    .journal-news__story p {
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        color: var(--muted);
        display: -webkit-box;
        font-family: var(--font-sans);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 0;
        overflow: hidden;
    }

    .journal-news__story:hover h3 {
        color: var(--accent);
    }

    .journal-news__meta {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        margin-top: 0.9rem;
        text-transform: uppercase;
    }

    .journal-news__image {
        aspect-ratio: 3 / 2;
        border-radius: 0.85rem;
        display: block;
        filter: saturate(0.85) contrast(1.06);
        margin-bottom: 1.1rem;
        overflow: hidden;
    }

    .journal-news__more {
        display: flex;
        justify-content: center;
        margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
        max-width: 78rem;
    }

    .journal-news__more-btn {
        background: var(--ink);
        border: 0;
        border-radius: 999px;
        color: var(--white);
        cursor: pointer;
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.75rem 1.75rem;
        transition: opacity 180ms ease;
    }

    .journal-news__more-btn:hover {
        opacity: 0.85;
    }

    /* ===== Subscribe band ===== */
    .journal-subscribe-band {
        background: var(--charcoal);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        overflow: hidden;
        padding-block: clamp(4.5rem, 12vw, 8rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        position: relative;
        width: 100vw;
    }

    .journal-subscribe-band__ring {
        aspect-ratio: 1;
        border: 1.5px solid rgba(255, 253, 249, 0.07);
        border-radius: 50%;
        animation: journalSubscribeRingSpin 90s linear infinite;
        pointer-events: none;
        position: absolute;
        right: -240px;
        top: -240px;
        width: 480px;
    }

    .journal-subscribe-band__ring--outer {
        border-color: rgba(255, 253, 249, 0.04);
        right: -264px;
        top: -264px;
        width: 528px;
    }

    @@keyframes journalSubscribeRingSpin {
        to { transform: rotate(360deg); }
    }

    .journal-subscribe-band__content {
        margin-inline: auto;
        max-width: 36rem;
        position: relative;
        text-align: center;
        z-index: 1;
    }

    .journal-subscribe-band__content h2 {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 7vw, 3.25rem);
        margin: 0;
    }

    .journal-subscribe-band__body {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        line-height: 1.7;
        margin: 1.25rem auto 0;
        max-width: 30rem;
    }

    .journal-subscribe-band__form {
        display: flex;
        margin: clamp(2rem, 5vw, 3rem) auto 0;
        max-width: 28rem;
    }

    .journal-subscribe-band__form input {
        background: rgba(255, 253, 249, 0.06);
        border: 1px solid rgba(255, 253, 249, 0.18);
        border-right: 0;
        color: var(--white);
        flex: 1 1 auto;
        font: inherit;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        min-height: 3.4rem;
        min-width: 0;
        padding: 0 1.1rem;
    }

    .journal-subscribe-band__form input::placeholder {
        color: rgba(255, 253, 249, 0.45);
    }

    .journal-subscribe-band__form input:focus {
        border-color: rgba(255, 253, 249, 0.4);
        outline: none;
    }

    .journal-subscribe-band__form button {
        background: var(--surface);
        border: 1px solid var(--surface);
        color: var(--ink);
        cursor: pointer;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        min-height: 3.4rem;
        padding: 0 1.5rem;
        text-transform: uppercase;
        transition: background 180ms ease, color 180ms ease;
    }

    .journal-subscribe-band__form button:hover {
        background: var(--white);
    }

    .journal-subscribe-band__note {
        color: rgba(255, 253, 249, 0.42);
        font-family: var(--crypto-mono);
        font-size: 0.72rem;
        letter-spacing: 0.03em;
        margin-top: 1.5rem;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 900px) {
        .journal-news__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .journal-news__grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .journal-hero-screen__frame {
            min-height: min(85vh, 38rem);
        }

        .journal-hero-screen__caption {
            align-items: flex-start;
            flex-direction: column;
            row-gap: 1.5rem;
        }

        .journal-hero-screen__caption-text {
            max-width: none;
        }

        .journal-hero-screen__arrow {
            height: 2.75rem;
            width: 2.75rem;
        }
    }

    @@media (max-width: 560px) {
        .journal-subscribe-band__form {
            display: grid;
        }

        .journal-subscribe-band__form input {
            border-right: 1px solid rgba(255, 253, 249, 0.18);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .journal-hero-screen__slide,
        .journal-hero-screen__caption {
            animation: none;
        }

        .journal-hero-screen__slide:first-of-type,
        .journal-hero-screen__caption:first-of-type {
            opacity: 1;
            visibility: visible;
        }

        .journal-subscribe-band__ring {
            animation: none;
            display: none;
        }
    }
</style>

@code {
    // Must equal the journalHeroSlide/journalHeroCaption 28s cycle divided by FeaturedArticles.Count.
    private const int HeroSlideSeconds = 7;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.destroy");
        }
        catch
        {
            // JS runtime may already be disconnected during navigation or prerender disposal.
        }
    }
}
