@page "/journal"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>The Journal | Artisanal Brew</PageTitle>

<div class="journal-page">

    <!-- ==================== HERO ==================== -->
    <section class="journal-hero journal-hero-screen" data-recruiter-section>
        <h1 class="visually-hidden">The Journal — notes from the counter</h1>

        @for (var index = 0; index < JournalCatalog.FeaturedArticles.Count; index++)
        {
            var slide = JournalCatalog.FeaturedArticles[index];
            <div class="journal-hero-screen__slide journal-thumb journal-thumb--@slide.ImageKey"
                 style="animation-delay: @(index * HeroSlideSeconds)s"
                 aria-hidden="true"></div>
        }

        <div class="journal-hero-screen__scrim" aria-hidden="true"></div>

        <div class="journal-hero-screen__content">
            <p class="eyebrow" data-recruiter-animate="lift">The Journal</p>

            <div class="journal-hero-screen__captions" data-recruiter-animate="lift" data-recruiter-delay="160">
                @for (var index = 0; index < JournalCatalog.FeaturedArticles.Count; index++)
                {
                    var article = JournalCatalog.FeaturedArticles[index];
                    <a class="journal-hero-screen__caption"
                       style="animation-delay: @(index * HeroSlideSeconds)s"
                       href="@JournalCatalog.ArticleUrl(article.Slug)">
                        <span class="journal-hero-screen__kicker">@article.CategoryLabel · @article.ReadTime</span>
                        <h2>@article.Title</h2>
                        <p>@article.Summary</p>
                        <span class="journal-hero-screen__cta">Read the note <span aria-hidden="true">&#8599;</span></span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- ==================== FRONT PAGE ==================== -->
    <section class="section journal-news" data-recruiter-section aria-labelledby="journal-news-title">
        <h2 id="journal-news-title" class="visually-hidden">Latest from the Journal</h2>

        @{
            var featureArticle = JournalCatalog.FeaturedArticles[0];
            var leadArticle = JournalCatalog.FeaturedArticles[1];
            var secondaryArticles = JournalCatalog.FeaturedArticles.Skip(2).Take(2).ToList();
        }

        <div class="journal-news__grid" data-recruiter-stagger>
            <a class="journal-news__story journal-news__story--feature"
               href="@JournalCatalog.ArticleUrl(featureArticle.Slug)"
               data-recruiter-animate="lift"
               aria-label="@($"Read {featureArticle.Title}")">
                <span class="journal-news__image journal-news__image--feature journal-thumb journal-thumb--@featureArticle.ImageKey"
                      role="img" aria-label="@featureArticle.ImageAriaLabel"></span>
                <h3>@featureArticle.Title</h3>
                <p>@featureArticle.Summary</p>
                <span class="journal-news__meta">@featureArticle.ReadTime</span>
            </a>

            <a class="journal-news__story journal-news__story--lead"
               href="@JournalCatalog.ArticleUrl(leadArticle.Slug)"
               data-recruiter-animate="lift"
               aria-label="@($"Read {leadArticle.Title}")">
                <span class="journal-news__lead-text">
                    <h3>@leadArticle.Title</h3>
                    <p>@leadArticle.Summary</p>
                    <span class="journal-news__meta">@leadArticle.ReadTime</span>
                </span>
                <span class="journal-news__image journal-thumb journal-thumb--@leadArticle.ImageKey"
                      role="img" aria-label="@leadArticle.ImageAriaLabel"></span>
            </a>

            @foreach (var article in secondaryArticles)
            {
                <a class="journal-news__story journal-news__story--card"
                   href="@JournalCatalog.ArticleUrl(article.Slug)"
                   data-recruiter-animate="lift"
                   aria-label="@($"Read {article.Title}")">
                    <span class="journal-news__image journal-thumb journal-thumb--@article.ImageKey"
                          role="img" aria-label="@article.ImageAriaLabel"></span>
                    <h3>@article.Title</h3>
                    <p>@article.Summary</p>
                    <span class="journal-news__meta">@article.ReadTime</span>
                </a>
            }
        </div>
    </section>

    <!-- ==================== SHORT STORIES ==================== -->
    <section class="section journal-shortlist" data-recruiter-section aria-labelledby="short-stories-title">
        <div class="recruiter-section-heading section-heading">
            <p class="eyebrow" data-recruiter-animate="lift">Short Stories</p>
            <h2 data-recruiter-animate="lift" data-recruiter-delay="120">Brief notes, quickly poured.</h2>
        </div>

        <div class="journal-shortlist__grid" data-recruiter-stagger>
            @foreach (var article in JournalCatalog.ShortStories)
            {
                <article class="journal-shortlist__card" data-recruiter-animate="lift">
                    <div class="@JournalCatalog.StoryImageClass(article.ImageKey) journal-shortlist__image"
                         role="img"
                         aria-label="@article.ImageAriaLabel"></div>
                    <span class="journal-badge">@article.Kicker</span>
                    <h3>@article.Title</h3>
                    <p>@article.Summary</p>
                </article>
            }
        </div>
    </section>

    <!-- ==================== SUBSCRIBE ==================== -->
    <section class="journal-subscribe-band" data-recruiter-section aria-labelledby="join-journal-title">
        <span class="journal-subscribe-band__ring" aria-hidden="true"></span>
        <span class="journal-subscribe-band__ring journal-subscribe-band__ring--outer" aria-hidden="true"></span>

        <div class="journal-subscribe-band__content">
            <p class="eyebrow" data-recruiter-animate="lift">Join the Journal</p>

            <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
                <span class="mask-line"><span class="mask-line__inner">Seasonal notes,</span></span>
                <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">sent with restraint.</em></span></span>
            </h2>

            <p class="journal-subscribe-band__body" data-recruiter-animate="lift" data-recruiter-delay="300">
                Recipes, early releases, and field notes from the brew bar — a few times each season, never more.
            </p>

            <form class="journal-subscribe-band__form" data-recruiter-animate="lift" data-recruiter-delay="440">
                <label class="visually-hidden" for="journal-email">Email address</label>
                <input id="journal-email" name="email" type="email" placeholder="Email address" autocomplete="email" />
                <button type="submit">Subscribe</button>
            </form>

            <p class="journal-subscribe-band__note" data-recruiter-animate="lift" data-recruiter-observe-self>
                We write a few times each season and treat your inbox with the same care as our coffee.
            </p>
        </div>
    </section>

</div>

<style>
    /* ===== Hero ===== */
    .journal-hero-screen {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        isolation: isolate;
        /* .content:has(.journal-page) already zeroes the container's top padding */
        margin: 0 calc(50% - 50vw);
        min-height: 100vh;
        min-height: 100dvh;
        overflow: hidden;
        padding: calc(4.75rem + clamp(1.25rem, 3vw, 3rem)) clamp(1.25rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
        position: relative;
        width: 100vw;
    }

    .journal-hero-screen__slide {
        animation: journalHeroSlide 28s linear infinite;
        filter: saturate(0.82) contrast(1.08);
        inset: 0;
        opacity: 0;
        position: absolute;
        z-index: -2;
    }

    @@keyframes journalHeroSlide {
        0% { opacity: 0; }
        3.5% { opacity: 1; }
        25% { opacity: 1; }
        28.5% { opacity: 0; }
        100% { opacity: 0; }
    }

    .journal-hero-screen__scrim {
        background:
            linear-gradient(180deg, rgba(31, 26, 24, 0.35) 0%, rgba(31, 26, 24, 0.42) 55%, rgba(31, 26, 24, 0.82) 100%);
        inset: 0;
        position: absolute;
        z-index: -1;
    }

    .journal-hero-screen__content {
        margin-inline: auto;
        max-width: 78rem;
        width: 100%;
    }

    .journal-hero-screen__content .eyebrow {
        color: rgba(255, 253, 249, 0.72);
    }

    .journal-hero-screen__captions {
        display: grid;
        margin-top: clamp(1rem, 2vw, 1.5rem);
    }

    .journal-hero-screen__caption {
        animation: journalHeroCaption 28s linear infinite;
        display: flex;
        flex-direction: column;
        grid-area: 1 / 1;
        max-width: 42rem;
        opacity: 0;
        text-decoration: none;
        visibility: hidden;
    }

    @@keyframes journalHeroCaption {
        0% { opacity: 0; transform: translateY(0.9rem); visibility: visible; }
        3.5% { opacity: 1; transform: translateY(0); }
        25% { opacity: 1; transform: translateY(0); visibility: visible; }
        28.5% { opacity: 0; transform: translateY(0); visibility: hidden; }
        100% { opacity: 0; visibility: hidden; }
    }

    .journal-hero-screen__kicker {
        color: rgba(255, 253, 249, 0.6);
        font-family: var(--crypto-mono);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        margin-bottom: 1.1rem;
        text-transform: uppercase;
    }

    .journal-hero-screen__caption h2 {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 6.5vw, 4.75rem);
        line-height: 1.04;
        margin: 0;
    }

    .journal-hero-screen__caption p {
        color: rgba(255, 253, 249, 0.78);
        font-family: var(--font-sans);
        font-size: clamp(1rem, 1.4vw, 1.1rem);
        line-height: 1.65;
        margin: 1.1rem 0 0;
        max-width: 34rem;
    }

    .journal-hero-screen__cta {
        border-bottom: 1px solid rgba(255, 253, 249, 0.45);
        align-self: flex-start;
        color: var(--white);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        margin-top: clamp(1.5rem, 3vw, 2.25rem);
        padding-bottom: 0.35rem;
        text-transform: uppercase;
        transition: border-color 180ms ease;
    }

    .journal-hero-screen__caption:hover .journal-hero-screen__cta {
        border-color: var(--white);
    }

    /* ===== Front page grid ===== */
    .journal-news {
        background: var(--charcoal);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        padding-block: clamp(3rem, 7vw, 5.5rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        width: 100vw;
    }

    .journal-news__grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: auto 1fr;
        margin-inline: auto;
        max-width: 78rem;
    }

    .journal-news__story {
        color: var(--white);
        display: flex;
        flex-direction: column;
        min-width: 0;
        text-decoration: none;
    }

    .journal-news__story h3 {
        color: var(--white);
        font-family: var(--font-sans);
        font-weight: 800;
        letter-spacing: -0.01em;
        line-height: 1.15;
        margin: 0 0 0.65rem;
        transition: color 180ms ease;
    }

    .journal-news__story p {
        color: rgba(255, 253, 249, 0.6);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    .journal-news__story:hover h3 {
        color: rgba(255, 253, 249, 0.75);
    }

    .journal-news__meta {
        color: rgba(255, 253, 249, 0.38);
        font-family: var(--crypto-mono);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        margin-top: 0.9rem;
        text-transform: uppercase;
    }

    .journal-news__image {
        aspect-ratio: 3 / 2;
        border-radius: 0.4rem;
        display: block;
        filter: saturate(0.85) contrast(1.06);
        overflow: hidden;
    }

    .journal-news__image--feature {
        aspect-ratio: 4 / 3;
    }

    .journal-news__story--feature {
        grid-column: 1;
        grid-row: 1 / span 2;
        padding-right: clamp(1.5rem, 3vw, 2.75rem);
    }

    .journal-news__story--feature .journal-news__image {
        margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    }

    .journal-news__story--feature h3 {
        font-size: clamp(1.9rem, 3.4vw, 2.7rem);
        margin-bottom: 0.9rem;
    }

    .journal-news__story--feature p {
        font-size: 1.05rem;
        max-width: 32rem;
    }

    .journal-news__story--lead {
        border-left: 1px solid rgba(255, 253, 249, 0.14);
        column-gap: clamp(1.5rem, 3vw, 2.75rem);
        display: grid;
        grid-column: 2 / span 2;
        grid-row: 1;
        grid-template-columns: 1fr 1fr;
        padding-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    }

    .journal-news__lead-text {
        display: flex;
        flex-direction: column;
        padding-left: clamp(1.5rem, 3vw, 2.75rem);
    }

    .journal-news__story--lead h3 {
        font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    }

    .journal-news__story--card {
        border-left: 1px solid rgba(255, 253, 249, 0.14);
        border-top: 1px solid rgba(255, 253, 249, 0.14);
        grid-row: 2;
        padding-left: clamp(1.5rem, 3vw, 2.75rem);
        padding-right: clamp(1.5rem, 3vw, 2.75rem);
        padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
    }

    .journal-news__story--card:last-child {
        padding-right: 0;
    }

    .journal-news__story--card .journal-news__image {
        margin-bottom: 1.1rem;
    }

    .journal-news__story--card h3 {
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    }

    .journal-news__story--card p {
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        display: -webkit-box;
        overflow: hidden;
    }

    /* ===== Short Stories ===== */
    .journal-shortlist {
        margin-inline: auto;
        max-width: 78rem;
    }

    .journal-shortlist__grid {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .journal-shortlist__card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 1.25rem;
        padding: 1.5rem;
    }

    .journal-shortlist__image {
        aspect-ratio: 1;
        border-radius: 0.85rem;
        filter: saturate(0.85) contrast(1.06);
        margin-bottom: 1.1rem;
    }

    .journal-shortlist__card h3 {
        color: var(--ink);
        font-size: clamp(1.15rem, 1.8vw, 1.4rem);
        line-height: 1.2;
        margin: 0 0 0.5rem;
    }

    .journal-shortlist__card p {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.55;
        margin: 0;
    }

    /* ===== Subscribe band ===== */
    .journal-subscribe-band {
        background: var(--charcoal);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        overflow: hidden;
        padding-block: clamp(4.5rem, 12vw, 8rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        position: relative;
        width: 100vw;
    }

    .journal-subscribe-band__ring {
        aspect-ratio: 1;
        border: 1.5px solid rgba(255, 253, 249, 0.07);
        border-radius: 50%;
        animation: journalSubscribeRingSpin 90s linear infinite;
        pointer-events: none;
        position: absolute;
        right: -240px;
        top: -240px;
        width: 480px;
    }

    .journal-subscribe-band__ring--outer {
        border-color: rgba(255, 253, 249, 0.04);
        right: -264px;
        top: -264px;
        width: 528px;
    }

    @@keyframes journalSubscribeRingSpin {
        to { transform: rotate(360deg); }
    }

    .journal-subscribe-band__content {
        margin-inline: auto;
        max-width: 36rem;
        position: relative;
        text-align: center;
        z-index: 1;
    }

    .journal-subscribe-band__content h2 {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 7vw, 3.25rem);
        margin: 0;
    }

    .journal-subscribe-band__body {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        line-height: 1.7;
        margin: 1.25rem auto 0;
        max-width: 30rem;
    }

    .journal-subscribe-band__form {
        display: flex;
        margin: clamp(2rem, 5vw, 3rem) auto 0;
        max-width: 28rem;
    }

    .journal-subscribe-band__form input {
        background: rgba(255, 253, 249, 0.06);
        border: 1px solid rgba(255, 253, 249, 0.18);
        border-right: 0;
        color: var(--white);
        flex: 1 1 auto;
        font: inherit;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        min-height: 3.4rem;
        min-width: 0;
        padding: 0 1.1rem;
    }

    .journal-subscribe-band__form input::placeholder {
        color: rgba(255, 253, 249, 0.45);
    }

    .journal-subscribe-band__form input:focus {
        border-color: rgba(255, 253, 249, 0.4);
        outline: none;
    }

    .journal-subscribe-band__form button {
        background: var(--surface);
        border: 1px solid var(--surface);
        color: var(--ink);
        cursor: pointer;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        min-height: 3.4rem;
        padding: 0 1.5rem;
        text-transform: uppercase;
        transition: background 180ms ease, color 180ms ease;
    }

    .journal-subscribe-band__form button:hover {
        background: var(--white);
    }

    .journal-subscribe-band__note {
        color: rgba(255, 253, 249, 0.42);
        font-family: var(--crypto-mono);
        font-size: 0.72rem;
        letter-spacing: 0.03em;
        margin-top: 1.5rem;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 900px) {
        .journal-news__grid {
            display: flex;
            flex-direction: column;
            gap: clamp(1.75rem, 5vw, 2.5rem);
        }

        .journal-news__story--feature,
        .journal-news__story--card {
            border-left: none;
            padding-inline: 0;
        }

        .journal-news__story--lead {
            border-left: none;
            grid-template-columns: 1fr;
            padding-bottom: 0;
        }

        .journal-news__lead-text {
            order: 2;
            padding-left: 0;
        }

        .journal-news__story--lead .journal-news__image {
            margin-bottom: 1.1rem;
            order: 1;
        }

        .journal-news__story--card {
            padding-top: clamp(1.75rem, 5vw, 2.5rem);
        }
    }

    @@media (max-width: 760px) {
        .journal-shortlist__grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .journal-subscribe-band__form {
            display: grid;
        }

        .journal-subscribe-band__form input {
            border-right: 1px solid rgba(255, 253, 249, 0.18);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .journal-hero-screen__slide,
        .journal-hero-screen__caption {
            animation: none;
        }

        .journal-hero-screen__slide:first-of-type,
        .journal-hero-screen__caption:first-of-type {
            opacity: 1;
            visibility: visible;
        }

        .journal-subscribe-band__ring {
            animation: none;
            display: none;
        }
    }
</style>

@code {
    // Must equal the journalHeroSlide/journalHeroCaption 28s cycle divided by FeaturedArticles.Count.
    private const int HeroSlideSeconds = 7;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.destroy");
        }
        catch
        {
            // JS runtime may already be disconnected during navigation or prerender disposal.
        }
    }
}
