@page "/products"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IProductService ProductService
@inject ICartMutationClient CartMutationClient
@inject IWebHostEnvironment WebHostEnvironment
@inject ILogger<Products> Logger
@using ThisCafeteria.Domain.Enums
@using ThisCafeteria.Web.Services.Cart

@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>Shop | Artisanal Brew</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="@Assets["css/catalog.css"]" />
    @* Preloaded so the hero never has to fetch cold — avoids a blank flash while the image downloads. *@
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80" />
</HeadContent>

<div class="products-catalog">
    @if (_isLoading)
    {
        <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Shop</p>
            <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink">Loading products.</h1>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-accent">Shop</p>
            <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink">Products could not be loaded.</h1>
            <p class="mt-3 max-w-md text-sm text-mute">@_loadError</p>
        </div>
    }
    else
    {
        <div class="mx-auto max-w-7xl px-4 pb-24 pt-6 sm:px-6 lg:px-8 catalog-shell">
            @* Catalog header bar: breadcrumb trail (home / category / current section) on the left,
               grid/list view toggle and "Sort by" dropdown on the right.
               Commented out — Sort by now lives in FilterSidebar; grid/list view toggle and
               breadcrumb reset are disabled along with it.
            <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between" data-animate="fade-up">
                <nav class="flex items-center gap-2 text-sm text-mute" aria-label="Breadcrumb">
                    <a href="" class="flex items-center gap-2 transition-colors hover:text-ink">
                        <LucideIcon Name="house" Size="14" />
                    </a>
                    <LucideIcon Name="chevron-right" Size="12" CssClass="text-faint" />
                    <button type="button" class="transition-colors hover:text-ink" @onclick="ResetFilters">
                        All categories
                    </button>
                    <LucideIcon Name="chevron-right" Size="12" CssClass="text-faint" />
                    <span class="font-semibold text-ink">@CurrentSectionLabel</span>
                </nav>

                <CatalogToolbar ListView="@_listView"
                                ListViewChanged="value => _listView = value"
                                Chips="@AppliedChips"
                                OnRemoveChip="RemoveChip"
                                Sort="@_sort"
                                SortChanged="value => { _sort = value; _currentPage = 1; }" />
            </div>
            *@

            <TestnetInfoModal />

            <div class="flex flex-col gap-8 lg:flex-row">
                @* Below lg the sidebar leaves the flow and becomes a bottom sheet,
                   opened from the filter bar above the grid — the old stacked layout
                   pushed an entire filter panel ahead of the products on mobile. *@
                <div class="catalog-filter-backdrop @(_filtersOpen ? "is-open" : null)"
                     role="presentation"
                     @onclick="CloseFilters"></div>
                <div class="flex-shrink-0 lg:w-[260px] catalog-filter-sheet @(_filtersOpen ? "is-open" : null)"
                     role="@(_filtersOpen ? "dialog" : null)"
                     aria-modal="@(_filtersOpen ? "true" : null)"
                     aria-label="Product filters">
                    <div class="catalog-filter-sheet__header">
                        <span class="catalog-filter-sheet__grabber" aria-hidden="true"></span>
                        <button type="button" class="catalog-filter-sheet__done" @onclick="CloseFilters">Done</button>
                    </div>
                    <FilterSidebar Sort="@_sort"
                               SortChanged="value => { _sort = value; _currentPage = 1; }"
                               Categories="@CategoryOptions"
                               SelectedCategory="@_selectedCategory"
                               SelectedCategoryChanged="value => { _selectedCategory = value; _currentPage = 1; }"
                               MinPrice="@_minPrice"
                               MinPriceChanged="value => { _minPrice = value; _currentPage = 1; }"
                               MaxPrice="@_maxPrice"
                               MaxPriceChanged="value => { _maxPrice = value; _currentPage = 1; }"
                               PriceFloor="@_priceFloor"
                               PriceCeiling="@_priceCeiling" />
                </div>

                <div class="min-w-0 flex-1 mt-10">
                    <div class="catalog-filter-bar">
                        <button type="button"
                                class="catalog-filter-bar__trigger"
                                aria-haspopup="dialog"
                                aria-expanded="@_filtersOpen"
                                @onclick="OpenFilters">
                            <LucideIcon Name="sliders-horizontal" Size="14" />
                            <span>Filters</span>
                            @if (AppliedChips.Count > 0)
                            {
                                <span class="catalog-filter-bar__count">@AppliedChips.Count</span>
                            }
                        </button>
                        <span class="catalog-filter-bar__section">@CurrentSectionLabel</span>
                    </div>
                    @{
                        var cards = VisibleCards();
                    }

                    @if (cards.Count == 0)
                    {
                        <div class="rounded-2xl bg-white p-10 text-center shadow-sm">
                            <p class="text-sm text-mute">No products match the current filters.</p>
                            <button type="button"
                                    class="mt-4 rounded-full bg-ink px-5 py-2 text-sm text-white transition-colors hover:bg-accent"
                                    @onclick="ResetFilters">
                                Clear filters
                            </button>
                        </div>
                    }
                    else
                    {
                        @* items-start keeps the hover blurb's growth to the card it belongs
                           to: stretched grid items would all match the tallest in the row,
                           so opening one description would drag its neighbours' prices down
                           with it. The cards are a fixed composition and already share a
                           height, so nothing changes at rest. *@
                        <div class="grid items-start gap-6 @(_listView ? "grid-cols-1" : "sm:grid-cols-2 xl:grid-cols-3")"
                             data-animate="fade-up">
                            @for (var i = 0; i < cards.Count; i++)
                            {
                                var card = cards[i];
                                <ProductCard @key="card.Slug"
                                             Card="@card"
                                             Elevated="@(!_listView && cards.Count > 2 && i == 1)"
                                             Horizontal="@_listView"
                                             Adding="@(_addingSlug == card.Slug)"
                                             OnNavigate="NavigateToProduct"
                                             OnAddToCart="AddToCart" />
                            }
                        </div>

                        @if (_totalFilteredCount > _pageSize)
                        {
                            var totalPages = (int)Math.Ceiling((double)_totalFilteredCount / _pageSize);
                            <div class="mt-12 flex justify-center gap-2" data-animate="fade-up">
                                @for (int p = 1; p <= totalPages; p++)
                                {
                                    var pageNum = p;
                                    <button type="button"
                                            class="flex h-10 w-10 items-center justify-center rounded-full border @(pageNum == _currentPage ? "border-accent bg-accent text-white" : "border-line bg-transparent text-ink hover:border-ink") text-sm font-medium transition-colors"
                                            @onclick="() => { _currentPage = pageNum; }">
                                        @pageNum
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyCollection<ProductDto> _products = [];
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 6;
    private int _totalFilteredCount;
    private string? _loadError;
    private string _selectedCategory = string.Empty;
    private decimal _minPrice;
    private decimal _maxPrice;
    private decimal _priceFloor;
    private decimal _priceCeiling;
    private string _sort = CatalogToolbar.SortDefault;
    private bool _listView;
    private bool _filtersOpen;
    private string? _addingSlug;
    private string? _openingSlug;
    private PersistingComponentStateSubscription _subscription;

    private void OpenFilters() => _filtersOpen = true;

    private void CloseFilters() => _filtersOpen = false;

    private string CurrentSectionLabel =>
        string.IsNullOrEmpty(_selectedCategory)
            ? "All items"
            : CatalogProductCardMapper.LabelFor(Enum.Parse<ProductCategory>(_selectedCategory));

    private IReadOnlyList<CatalogCategoryOption> CategoryOptions =>
        _products
            .Where(product => product.IsActive)
            .GroupBy(product => product.Category)
            .OrderBy(group => group.Key.ToString(), StringComparer.Ordinal)
            .Select(group => new CatalogCategoryOption(
                group.Key.ToString(),
                CatalogProductCardMapper.LabelFor(group.Key),
                group.Count()))
            .ToList();

    private IReadOnlyList<CatalogFilterChip> AppliedChips
    {
        get
        {
            var chips = new List<CatalogFilterChip>();

            if (!string.IsNullOrEmpty(_selectedCategory))
            {
                chips.Add(new("category", CurrentSectionLabel));
            }

            if (_minPrice > _priceFloor || _maxPrice < _priceCeiling)
            {
                chips.Add(new("price", $"{_minPrice:0} – {_maxPrice:0} $"));
            }

            return chips;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistProducts);

        if (!ApplicationState.TryTakeFromJson<ProductDto[]>("products", out var products))
        {
            try
            {
                _products = await ProductService.GetProductsAsync();
            }
            catch (Exception exception)
            {
                _loadError = exception.Message;
            }
        }
        else
        {
            _products = products!;
            ApplicationState.TryTakeFromJson<string?>("productsLoadError", out _loadError);
        }

        if (_products.Count > 0)
        {
            _priceFloor = Math.Floor(_products.Min(product => product.Price));
            _priceCeiling = Math.Ceiling(_products.Max(product => product.Price));
            _minPrice = _priceFloor;
            _maxPrice = _priceCeiling;
        }

        _isLoading = false;
    }

    private Task PersistProducts()
    {
        ApplicationState.PersistAsJson("products", _products);
        ApplicationState.PersistAsJson("productsLoadError", _loadError);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("queueAnimations");
        }
    }

    private List<CatalogProductCard> VisibleCards()
    {
        var query = _products
            .Where(product => product.IsActive)
            .Where(product => string.IsNullOrEmpty(_selectedCategory) || product.Category.ToString() == _selectedCategory)
            .Where(product => product.StockQuantity > 0)
            .Where(product => product.Price >= _minPrice && product.Price <= _maxPrice);

        var ordered = _sort switch
        {
            "price-asc" => query.OrderBy(product => product.Price),
            "price-desc" => query.OrderByDescending(product => product.Price),
            "rating" => query
                .OrderByDescending(product => CatalogProductCardMapper.ToCard(product).Rating)
                .ThenBy(product => product.Name, StringComparer.Ordinal),
            _ => query
                .OrderBy(product => product.Category.ToString(), StringComparer.Ordinal)
                .ThenBy(product => product.Name, StringComparer.Ordinal)
        };

        _totalFilteredCount = ordered.Count();

        return ordered
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .Select(product => CatalogProductCardMapper.ToCard(product) with { ImageUrl = ResolveImageUrl(product) })
            .ToList();
    }

    // Seeded rows can point at /images/products/*.jpg assets that are not in wwwroot;
    // the old grid hid those 404s behind CSS gradients, an <img> cannot. Fall back to a
    // remote photo per product so the card always renders its beige image box with content.
    private static readonly string[] FallbackImages =
    [
        "https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1572119865084-43c285814d63?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=800&q=80"
    ];

    private string? ResolveImageUrl(ProductDto product)
    {
        if (!string.IsNullOrWhiteSpace(product.ImageUrl)
            && (product.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                || File.Exists(Path.Combine(
                    WebHostEnvironment.WebRootPath ?? string.Empty,
                    product.ImageUrl.TrimStart('/')))))
        {
            return product.ImageUrl;
        }

        return FallbackImages[product.Slug.Sum(c => c) % FallbackImages.Length];
    }

    private void RemoveChip(string key)
    {
        _currentPage = 1;
        switch (key)
        {
            case "category":
                _selectedCategory = string.Empty;
                break;
            case "price":
                _minPrice = _priceFloor;
                _maxPrice = _priceCeiling;
                break;
        }
    }

    private void ResetFilters()
    {
        _selectedCategory = string.Empty;
        _minPrice = _priceFloor;
        _maxPrice = _priceCeiling;
        _currentPage = 1;
    }

    private async Task NavigateToProduct(string slug)
    {
        if (_openingSlug is not null)
        {
            return;
        }

        _openingSlug = slug;

        try
        {
            await JS.InvokeVoidAsync("productTransition.playFromCard", slug);
        }
        catch (JSException)
        {
        }
        finally
        {
            Navigation.NavigateTo($"/products/{slug}");
        }
    }

    private async Task AddToCart(string slug)
    {
        if (_addingSlug is not null)
        {
            return;
        }

        var product = _products.FirstOrDefault(candidate => candidate.Slug == slug);
        if (product is null)
        {
            return;
        }

        _addingSlug = slug;

        try
        {
            await CartMutationClient.AddAsync(slug, 1);
            await ShowCartToastAsync($"{product.Name} added to cart.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Add to cart failed on shop page. Slug={Slug}, ProductName={ProductName}",
                slug,
                product.Name);
            await ShowCartToastAsync("This product could not be added.", "error");
        }
        finally
        {
            _addingSlug = null;
        }
    }

    private async Task ShowCartToastAsync(string message, string variant = "success")
    {
        try
        {
            await JS.InvokeVoidAsync("cartToast.show", message, variant);
        }
        catch (JSException)
        {
        }
    }
}
