@page "/products"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IProductService ProductService
@inject IShoppingCartService CartService
@inject ICartMutationClient CartMutationClient
@inject ILogger<Products> Logger
@using ThisCafeteria.Domain.Enums
@using ThisCafeteria.Web.Services.Cart

@inject PersistentComponentState ApplicationState
@implements IDisposable

<PageTitle>Shop | Artisanal Brew</PageTitle>

<HeadContent>
    @* Preloaded so switching categories never has to fetch these cold — avoids a blank flash while the image downloads. *@
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80" />
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1200&q=80" />
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=1200&q=80" />
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1572119865084-43c285814d63?auto=format&fit=crop&w=1200&q=80" />
</HeadContent>

<section class="products-shop">
    @if (_isLoading)
    {
        <section class="page-intro" data-animate="fade-up">
            <p class="eyebrow">Shop</p>
            <h1>Loading products.</h1>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <section class="page-intro" data-animate="fade-up">
            <p class="eyebrow">Shop</p>
            <h1>Products could not be loaded.</h1>
            <p class="lede">@_loadError</p>
        </section>
    }
    else
    {
        var visibleProducts = OrderProductsForDisplay(
            displayedSection == AllSection
                ? _products.Where(product => product.IsActive)
                : _products.Where(product => product.IsActive && product.Category.ToString() == displayedSection));

        <header class="products-shop__header products-shop__header--@displayedSection" data-animate="fade-up">
            <h1 class="products-shop__title">@((MarkupString)TitleFor(displayedSection).Replace("&", "<span class=\"products-shop__amp\">&amp;</span>"))</h1>
            <p class="products-shop__lede">@LedeFor(displayedSection)</p>
            <button type="button" class="products-shop__filter" aria-label="Filters">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="4" y1="21" x2="4" y2="14" />
                    <line x1="4" y1="10" x2="4" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12" y2="3" />
                    <line x1="20" y1="21" x2="20" y2="16" />
                    <line x1="20" y1="12" x2="20" y2="3" />
                    <line x1="1" y1="14" x2="7" y2="14" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
                @if (ActiveFilterCount > 0)
                {
                    <span class="products-shop__filter-badge">@ActiveFilterCount</span>
                }
            </button>
        </header>

        <ul class="category-filter" data-animate="fade-up" aria-label="Product categories">
            @foreach (var section in Sections)
            {
                <li class="@(selectedSection == section.Key ? "active" : "")"
                    aria-selected="@(selectedSection == section.Key ? "true" : "false")"
                    role="tab"
                    @onclick="() => SetSectionAsync(section.Key)">
                    @section.Label
                </li>
            }
        </ul>

        <div class="product-grid-wrapper @GetGridWrapperClass()">
            <div @key="displayedSection" class="product-grid stagger-container" data-stagger>
                @foreach (var product in visibleProducts)
                {
                    var quantity = GetQuantity(product.Slug);
                    var isAdding = _addingSlug == product.Slug;

                    <article class="marketplace-card @(_qtyExpanded.Contains(product.Slug) ? "marketplace-card--qty-expanded" : "")"
                             data-animate="fade-up"
                             data-product-card
                             data-product-slug="@product.Slug">
                        <a class="marketplace-card__link"
                           href="@($"products/{product.Slug}")"
                           @onclick:preventDefault="true"
                           @onclick="() => NavigateToProductAsync(product)">
                            <div class="image-frame @ImageClassFor(product.Category)"
                                 style="@BackgroundImage(product.ImageUrl)"
                                 data-product-image>
                                <span class="marketplace-card__wishlist" aria-label="Save for later">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                </span>
                            </div>
                            <div class="marketplace-card__copy">
                                <div class="marketplace-card__title-row">
                                    <h3>@product.Name</h3>
                                    <p class="price">@FormatPrice(product.Price)</p>
                                </div>
                            </div>
                        </a>

                        <div class="marketplace-card__footer">
                            <div class="marketplace-card__actions">
                                <ProductQuantityPicker Quantity="quantity"
                                                       QuantityChanged="@(value => SetQuantity(product.Slug, value))" />
                                <button type="button"
                                        class="button button--dark marketplace-card__add"
                                        disabled="@isAdding"
                                        aria-label="Add @product.Name to cart"
                                        @onclick="() => AddToCartAsync(product, quantity)">
                                    @(isAdding ? "Adding…" : "Add to cart")
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</section>

@code {
    private const string AllSection = "All";

    private static readonly IReadOnlyList<ProductSection> Sections =
    [
        new(AllSection, "All Items"),
        new(ProductCategory.Beans.ToString(), "Single Origin Beans"),
        new(ProductCategory.BrewingEquipment.ToString(), "Brewing Equipment"),
        new(ProductCategory.CeramicsAndGoods.ToString(), "Ceramics & Goods")
    ];

    private IReadOnlyCollection<ProductDto> _products = [];
    private bool _isLoading = true;
    private string? _loadError;
    private string selectedSection = AllSection;
    private string displayedSection = AllSection;
    private string? _gridTransitionClass;
    private bool _isTransitioning;
    private bool shouldRefreshAnimations = true;
    private const int CategoryFadeOutMs = 180;
    private const int CategoryFadeInMs = 340;
    private const int FrameDelayMs = 16;
    private readonly Dictionary<string, int> _quantities = new(StringComparer.Ordinal);
    private readonly HashSet<string> _qtyExpanded = new(StringComparer.Ordinal);
    private string? _addingSlug;
    private string? _openingSlug;
    private PersistingComponentStateSubscription _subscription;

    private int ActiveFilterCount => displayedSection == AllSection ? 0 : 1;

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistProducts);

        if (!ApplicationState.TryTakeFromJson<ProductDto[]>("products", out var products))
        {
            try
            {
                _products = await ProductService.GetProductsAsync();
            }
            catch (Exception exception)
            {
                _loadError = exception.Message;
            }
        }
        else
        {
            _products = products!;
            ApplicationState.TryTakeFromJson<string?>("productsLoadError", out _loadError);
        }

        _isLoading = false;
    }

    private Task PersistProducts()
    {
        ApplicationState.PersistAsJson("products", _products);
        ApplicationState.PersistAsJson("productsLoadError", _loadError);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || shouldRefreshAnimations)
        {
            shouldRefreshAnimations = false;
            await JS.InvokeVoidAsync("queueAnimations");
        }
    }

    private string GetGridWrapperClass()
    {
        return _gridTransitionClass ?? string.Empty;
    }

    private async Task SetSectionAsync(string section)
    {
        if (section == selectedSection || _isTransitioning)
        {
            return;
        }

        selectedSection = section;
        _qtyExpanded.Clear();
        _isTransitioning = true;
        _gridTransitionClass = "is-fading-out";
        StateHasChanged();

        await Task.Delay(CategoryFadeOutMs);

        displayedSection = section;
        shouldRefreshAnimations = true;
        _gridTransitionClass = "is-fading-in";
        StateHasChanged();

        await Task.Delay(FrameDelayMs);

        _gridTransitionClass = null;
        StateHasChanged();

        await Task.Delay(CategoryFadeInMs);

        _isTransitioning = false;
    }

    private int GetQuantity(string slug) =>
        _quantities.TryGetValue(slug, out var quantity) ? quantity : 1;

    private void SetQuantity(string slug, int quantity) =>
        _quantities[slug] = Math.Clamp(quantity, 1, 99);

    private async Task NavigateToProductAsync(ProductDto product)
    {
        if (_openingSlug is not null)
        {
            return;
        }

        _openingSlug = product.Slug;

        try
        {
            await JS.InvokeVoidAsync("productTransition.playFromCard", product.Slug);
        }
        catch (JSException)
        {
        }
        finally
        {
            Navigation.NavigateTo($"/products/{product.Slug}");
        }
    }

    private async Task AddToCartAsync(ProductDto product, int quantity)
    {
        if (_addingSlug is not null)
        {
            return;
        }

        _addingSlug = product.Slug;

        try
        {
            await CartMutationClient.AddAsync(product.Slug, quantity);
            _qtyExpanded.Add(product.Slug);
            var label = quantity == 1
                ? $"{product.Name} added to cart."
                : $"{quantity} × {product.Name} added to cart.";
            await ShowCartToastAsync(label);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Add to cart failed on shop page. Slug={Slug}, Quantity={Quantity}, ProductName={ProductName}",
                product.Slug,
                quantity,
                product.Name);
            await ShowCartToastAsync("This product could not be added.", "error");
        }
        finally
        {
            _addingSlug = null;
        }
    }

    private async Task ShowCartToastAsync(string message, string variant = "success")
    {
        try
        {
            await JS.InvokeVoidAsync("cartToast.show", message, variant);
        }
        catch (JSException)
        {
        }
    }

    private static IEnumerable<ProductDto> OrderProductsForDisplay(IEnumerable<ProductDto> products) =>
        products
            .OrderBy(product => CategorySortOrder(product.Category))
            .ThenBy(product => product.Name, StringComparer.Ordinal);

    private static int CategorySortOrder(ProductCategory category) =>
        category switch
        {
            ProductCategory.Beans => 0,
            ProductCategory.BrewingEquipment => 1,
            ProductCategory.CeramicsAndGoods => 2,
            _ => int.MaxValue
        };

    private static string TitleFor(string section) =>
        section switch
        {
            "Beans" => "Single Origin Beans",
            "BrewingEquipment" => "Brewing Equipment",
            "CeramicsAndGoods" => "Ceramics & Goods",
            _ => "Coffee & Goods"
        };

    private static string LedeFor(string section) =>
        section switch
        {
            "Beans" => "Single-origin lots, roasted in small batches every week.",
            "BrewingEquipment" => "Precision tools for pour-over, espresso, and slow brews.",
            "CeramicsAndGoods" => "Hand-thrown ceramics and goods made for the table.",
            _ => "Small-batch roasts, brew tools, and ceramics for your daily ritual. Free shipping on every order."
        };

    private static string FormatPrice(decimal price) => price.ToString("$#,0.00");

    private static string ImageClassFor(ProductCategory category) =>
        category switch
        {
            ProductCategory.BrewingEquipment => "image-frame--equipment",
            ProductCategory.CeramicsAndGoods => "image-frame--ceramics",
            _ => "image-frame--coldbrew"
        };

    private static string? BackgroundImage(string? imageUrl) =>
        string.IsNullOrWhiteSpace(imageUrl) ? null : $"background-image: url('{imageUrl}');";

    private sealed record ProductSection(string Key, string Label);
}
