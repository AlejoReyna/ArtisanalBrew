    .story-recipe {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-recipe__rail {
        margin-top: clamp(3rem, 7vw, 5rem);
        position: relative;
    }

    .story-recipe__track,
    .story-recipe__fill {
        bottom: 0;
        left: 1.35rem;
        position: absolute;
        top: 0;
        width: 2px;
    }

    .story-recipe__track {
        background: var(--line);
    }

    .story-recipe__fill {
        background: var(--accent);
        transform: scaleY(0);
        transform-origin: top;
    }

    .story-recipe__stations {
        display: grid;
        gap: clamp(2rem, 6vw, 3rem);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .story-recipe__station {
        padding-left: 3rem;
        position: relative;
    }

    .story-recipe__node {
        background: var(--surface);
        border: 1.5px solid var(--line);
        border-radius: 50%;
        height: 12px;
        left: calc(1.35rem - 5px);
        position: absolute;
        top: 0.15rem;
        transition: background 500ms ease, border-color 500ms ease;
        width: 12px;
    }

    .story-recipe__station.is-visible .story-recipe__node {
        background: color-mix(in srgb, var(--accent) 40%, transparent);
        border-color: var(--accent);
    }

    .story-recipe__mono {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .story-recipe__copy {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.2rem;
        line-height: 1.35;
        margin: 0;
    }

    .story-recipe__stack {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        margin-top: clamp(2.5rem, 6vw, 4rem);
        text-align: center;
    }

    /* ===== The Yield (charcoal band) ===== */
    .story-yield {
        background: var(--charcoal);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        overflow: hidden;
        padding-block: clamp(4.5rem, 12vw, 8rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        position: relative;
        width: 100vw;
    }

    .story-yield__ring {
        aspect-ratio: 1;
        border: 1.5px solid rgba(255, 253, 249, 0.07);
        border-radius: 50%;
        animation: storyYieldRingSpin 90s linear infinite;
        pointer-events: none;
        position: absolute;
        right: -240px;
        top: -240px;
        width: 480px;
    }

    .story-yield__ring--outer {
        border-color: rgba(255, 253, 249, 0.04);
        right: -264px;
        top: -264px;
        width: 528px;
    }

    @@keyframes storyYieldRingSpin {
        to { transform: rotate(360deg); }
    }

    .story-yield__content {
        margin-inline: auto;
        max-width: 720px;
        position: relative;
        text-align: center;
        z-index: 1;
    }

    .story-yield__headline {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 9vw, 4rem);
        margin: 0;
    }

    .story-yield__body {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        line-height: 1.7;
        margin: 1.5rem auto 0;
        max-width: 32rem;
    }

    .story-yield__body code {
        background: rgba(255, 253, 249, 0.08);
        border-radius: 4px;
        color: var(--white);
        font-family: var(--crypto-mono);
        font-size: 0.9em;
        padding: 0.1em 0.4em;
    }

    .story-yield__flow {
        display: grid;
        gap: 1.25rem;
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .story-yield__step {
        background: rgba(255, 253, 249, 0.03);
        border: 1px solid rgba(255, 253, 249, 0.12);
        border-radius: 0.85rem;
        padding: 1.5rem;
        text-align: left;
    }

    .story-yield__step-mono {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        margin: 0 0 0.5rem;
    }

    .story-yield__step-copy {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 0;
    }

    .story-yield__stats {
        border-top: 1px solid rgba(255, 253, 249, 0.14);
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .story-yield__stat {
        border-bottom: 1px solid rgba(255, 253, 249, 0.14);
        padding-block: 1.75rem;
    }

    .story-yield__stat-number {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 8vw, 3.5rem);
        line-height: 1;
        margin: 0;
    }

    .story-yield__stat-caption {
        color: rgba(255, 253, 249, 0.5);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        margin: 0.6rem 0 0;
        text-transform: uppercase;
    }

    .story-yield__footnote {
        color: rgba(255, 253, 249, 0.4);
        font-family: var(--crypto-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        margin-top: clamp(2rem, 5vw, 3rem);
        text-transform: uppercase;
    }

    .story-yield__cta {
        margin-top: 1.5rem;
    }

    .story-yield__cta-button {
        background: var(--surface);
        border: none;
        color: var(--ink);
    }

    .story-yield__cta-button:hover {
        background: var(--white);
        color: var(--ink);
    }

    @@media (min-width: 700px) {
        .story-yield__flow {
            grid-template-columns: repeat(3, 1fr);
        }

        .story-yield__stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
        }

        .story-yield__stat {
            border-bottom: none;
            border-right: 1px solid rgba(255, 253, 249, 0.14);
        }

        .story-yield__stat:last-child {
            border-right: none;
        }
    }

    /* ===== The Pour ===== */
    .story-pour {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-pour__log {
        background: var(--charcoal);
        border-radius: 0.85rem;
        margin-top: clamp(3rem, 7vw, 5rem);
        padding: clamp(1.75rem, 4vw, 2.5rem);
    }

    .story-pour__log-line {
        color: rgba(255, 253, 249, 0.55);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        margin: 0;
        padding-block: 0.35rem;
    }

    .story-pour__log-line--done {
        color: var(--white);
    }

    .story-pour__log-line .type-line {
        border-right-color: rgba(255, 253, 249, 0.4);
    }

    .story-pour__estate {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: 1fr;
        margin-top: clamp(3rem, 7vw, 5rem);
    }

    .story-pour__card {
        border: 1px solid var(--line);
        border-radius: 0.85rem;
        padding: 1.5rem;
    }

    .story-pour__card-mono {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .story-pour__card-copy {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.55;
        margin: 0;
    }

    .story-pour__stat {
        align-items: baseline;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-top: clamp(3rem, 6vw, 4rem);
        text-align: center;
    }

    .story-pour__stat-number {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1;
    }

    .story-pour__stat-caption {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @@media (min-width: 700px) {
        .story-pour__estate {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* ===== Manifesto ===== */
    .story-manifesto {
        margin-inline: auto;
        max-width: 40rem;
        padding-block: clamp(3rem, 8vw, 6rem);
        text-align: center;
    }

    .story-manifesto__headline {
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        line-height: 1.05;
    }

    .story-manifesto__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-top: 2.5rem;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 700px) {
        .story-hero {
            min-height: 100svh;
        }

        .story-hero__poster,
        .story-hero__video {
            object-position: 38% center;
        }

        .story-fiction__columns {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .story-hero__video {
            display: none;
            transition: none;
        }

        .story-hero__rule {
            transition: none;
        }

        .story-yield__ring {
            animation: none;
            display: none;
        }

        .story-path__stop {
            opacity: 1;
            transition: none;
        }

        .story-path__node {
            transition: none;
        }

        .story-path__packet {
            display: none;
        }
    }

    @@media (prefers-contrast: more) {
        .story-hero__scrim {
            background: rgba(16, 14, 13, 0.78);
        }
    }
</style>

@code {
