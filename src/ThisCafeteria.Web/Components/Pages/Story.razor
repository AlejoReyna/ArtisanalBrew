@page "/story"
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using ThisCafeteria.Application.DTOs
@using ThisCafeteria.Application.Services
@using ThisCafeteria.Web.Components.Story
@using DatabaseSchemaDto = ThisCafeteria.Application.DTOs.DatabaseSchemaDto
@using SchemaTableDto = ThisCafeteria.Application.DTOs.SchemaTableDto
@inject IJSRuntime JSRuntime
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>This Café Doesn't Exist | Artisanal Brew</PageTitle>

@*
    publicHeader.js paints <body> with this page's theme colour (#0f0f11) so the
    browser chrome matches the header. That leaves the document background near-black
    while --ink/--muted are still light-theme values, which is what made every section
    below the hero dark-on-dark. This backdrop gives the page its own light surface,
    independent of whatever <body> is painted; the hero and the yield band are
    full-bleed and paint over it.
*@
<div class="story-surface" aria-hidden="true"></div>

<!-- ==================== HERO ==================== -->
<section class="page-intro story-hero"
         data-recruiter-section
         data-page-theme-color="#0f0f11"
         data-theme-color="#0f0f11">
    <div class="story-hero__media" aria-hidden="true">
        <img class="story-hero__poster"
             src="/images/story-hero-poster.webp"
             alt=""
             width="1280"
             height="832"
             decoding="async"
             fetchpriority="high" />
        <video class="story-hero__video"
               autoplay
               muted
               loop
               playsinline
               preload="none"
               data-story-hero-video>
            <source data-src="/videos/story-hero-loop.mp4" type="video/mp4" />
        </video>
    </div>
    <span class="story-hero__scrim" aria-hidden="true"></span>

    <div class="story-hero__content">
        <p class="story-hero__guess" aria-hidden="true">
            <span class="story-hero__guess-prefix">&gt;</span>
            <span class="story-hero__guess-text" data-story-guess-text></span><span class="story-hero__guess-cursor"></span>
        </p>

        @* Same 8-bit 3D treatment as the home hero: Press Start 2P letters with
           a hard 2px keyline and a stepped text-shadow extrusion, bobbing in a
           staggered ripple. The aria-label carries the sentence; the decorative
           letters stay out of the a11y tree. *@
        <h1 class="story-hero__headline story-title3d" aria-label="This café doesn't exist.">
            <span aria-hidden="true">
                @{ var letterIndex = 0; }
                @foreach (var line in HeroHeadlineLines)
                {
                    <span class="story-title3d__line">
                        @foreach (var word in line.Split(' '))
                        {
                            <span class="story-title3d__word">
                                @foreach (var letter in word)
                                {
                                    <span class="story-title3d__letter" style="--i: @letterIndex;">@letter</span>
                                    letterIndex++;
                                }
                            </span>
                        }
                    </span>
                }
            </span>
        </h1>

        <p class="lede story-hero__lede" data-recruiter-animate="lift" data-recruiter-delay="320">
            And that's exactly why it's awesome: a real blockchain stack, playing dress-up as a coffee shop.
        </p>

        <a class="story-hero__github" href="https://github.com/AlejoReyna/ArtisanalBrew" target="_blank" rel="noopener noreferrer">
            <svg class="story-hero__github-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span>AlejoReyna/ArtisanalBrew</span>
        </a>
    </div>
</section>

<div class="story-white-run">
<StoryTechShowcase />

<!-- ==================== THE PATH · ONE ORDER, ALL THE WAY DOWN ==================== -->
<section class="story-path" data-recruiter-section>
    <div class="recruiter-section-heading section-heading">
        <p class="eyebrow" data-recruiter-animate="lift">The Path</p>
        <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
            <span class="mask-line"><span class="mask-line__inner">One order,</span></span>
            <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">all the way down.</em></span></span>
        </h2>
        <p class="story-path__intro" data-recruiter-animate="lift" data-recruiter-delay="240">
            The estate above is the map. This is the route one checkout actually takes through it —
            traced from the source, not from the architecture diagram.
        </p>
    </div>

    <div class="story-path__rail" data-path-rail>
        <span class="story-path__track" aria-hidden="true"></span>
        <span class="story-path__fill" data-path-fill aria-hidden="true"></span>
        <span class="story-path__packet" data-path-packet aria-hidden="true"></span>

        <ol class="story-path__stops">
            @for (var i = 0; i < DataPath.Length; i++)
            {
                var stop = DataPath[i];
                <li class="story-path__stop @(stop.IsDeferred ? "is-deferred" : null)" data-path-stop>
                    <span class="story-path__node" aria-hidden="true"></span>
                    <p class="story-path__index">@((i + 1).ToString("00", CultureInfo.InvariantCulture))</p>
                    <p class="story-path__call">@stop.Call</p>
                    <p class="story-path__where">@stop.Where</p>
                    <p class="story-path__copy">@stop.Copy</p>
                    @if (stop.Writes is not null)
                    {
                        <p class="story-path__writes">
                            <span class="story-path__writes-label">writes</span>@stop.Writes
                        </p>
                    }
                </li>
            }
        </ol>
    </div>

    <p class="story-path__note" data-recruiter-animate="lift" data-recruiter-observe-self>
        Stops 01&ndash;05 all run inside the request. Stop 06 is provisioned and listening but nothing
        publishes to it yet &mdash; checkout still writes synchronously, and the queue is the seam for
        the day it shouldn't.
    </p>
</section>

<!-- ==================== THE SCHEMA · THE ENTITY DIAGRAM ==================== -->
<section class="story-schema" data-recruiter-section>
    <div class="recruiter-section-heading section-heading">
        <p class="eyebrow" data-recruiter-animate="lift">The Schema</p>
        <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
            <span class="mask-line"><span class="mask-line__inner">Every table,</span></span>
            <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">on the record.</em></span></span>
        </h2>
        <p class="story-schema__intro" data-recruiter-animate="lift" data-recruiter-delay="240">
            Not a diagram someone drew once and forgot. Everything below is read out of the live
            EF&nbsp;Core model at request time &mdash; if a migration changes the database, this section
            changes with it, whether or not anyone remembers to update the copy.
        </p>
    </div>

    @if (_schema is null)
    {
        <p class="story-schema__empty">
            @(_schemaError ?? "Reading the model…")
        </p>
    }
    else
    {
        <div class="story-schema__stats" data-recruiter-stagger>
            <div class="story-schema__stat" data-recruiter-animate="lift" data-recruiter-observe-self>
                <p class="story-schema__stat-number">@_schema.TableCount</p>
                <p class="story-schema__stat-caption">Tables</p>
            </div>
            <div class="story-schema__stat" data-recruiter-animate="lift" data-recruiter-observe-self>
                <p class="story-schema__stat-number">@_schema.ColumnCount</p>
                <p class="story-schema__stat-caption">Columns</p>
            </div>
            <div class="story-schema__stat" data-recruiter-animate="lift" data-recruiter-observe-self>
                <p class="story-schema__stat-number">@_schema.RelationshipCount</p>
                <p class="story-schema__stat-caption">Foreign keys</p>
            </div>
            <div class="story-schema__stat" data-recruiter-animate="lift" data-recruiter-observe-self>
                <p class="story-schema__stat-number">@_schema.TotalRows.ToString("N0", CultureInfo.InvariantCulture)</p>
                <p class="story-schema__stat-caption">Rows, right now</p>
            </div>
        </div>

        <div class="story-schema__groups" role="tablist" aria-label="Schema groups">
            @foreach (var group in SchemaGroups.Where(candidate => TablesIn(candidate).Count > 0))
            {
                <button type="button"
                        role="tab"
                        class="story-schema__group @(group == _activeGroup ? "is-active" : null)"
                        aria-selected="@(group == _activeGroup ? "true" : "false")"
                        @onclick="() => SelectGroup(group)">
                    @group
                    <span class="story-schema__group-count">@TablesIn(group).Count</span>
                </button>
            }
        </div>

        <div class="story-schema__grid">
            @foreach (var table in TablesIn(_activeGroup))
            {
                var isOpen = _openTable == table.Table;
                <article class="story-schema__table @(isOpen ? "is-open" : null) @(_highlightTable == table.Table ? "is-highlighted" : null)"
                         id="@SchemaAnchorId(table.Table)">
                    <button type="button"
                            class="story-schema__table-head"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            @onclick="() => ToggleTable(table.Table)">
                        <span class="story-schema__table-name">@table.Table</span>
                        <span class="story-schema__table-meta">
                            @table.Columns.Count cols
                            @if (table.Rows is not null)
                            {
                                <span class="story-schema__table-rows">@table.Rows.Value.ToString("N0", CultureInfo.InvariantCulture) rows</span>
                            }
                        </span>
                        <span class="story-schema__table-chevron" aria-hidden="true">@(isOpen ? "−" : "+")</span>
                    </button>

                    @if (isOpen)
                    {
                        <div class="story-schema__columns">
                            @foreach (var column in table.Columns)
                            {
                                <div class="story-schema__column">
                                    <span class="story-schema__column-key">
                                        @if (column.PrimaryKey)
                                        {
                                            <span class="story-schema__badge story-schema__badge--pk" title="Primary key">PK</span>
                                        }
                                        else if (column.ForeignKey)
                                        {
                                            <span class="story-schema__badge story-schema__badge--fk" title="Foreign key">FK</span>
                                        }
                                    </span>
                                    <span class="story-schema__column-name">@column.Name</span>
                                    <span class="story-schema__column-type">
                                        @column.Type@(column.Nullable ? "?" : string.Empty)
                                    </span>
                                </div>
                            }
                        </div>

                        @if (table.References.Count > 0)
                        {
                            <div class="story-schema__refs">
                                @foreach (var reference in table.References)
                                {
                                    <button type="button"
                                            class="story-schema__ref"
                                            @onclick="() => JumpToTable(reference.ToTable)">
                                        @reference.FromColumn <span aria-hidden="true">&rarr;</span> @($"{reference.ToTable}.{reference.ToColumn}")
                                    </button>
                                }
                            </div>
                        }
                    }
                </article>
            }
        </div>

        <div class="story-schema__api" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-schema__api-eyebrow">Check it yourself</p>
            <p class="story-schema__api-copy">
                Everything on this page comes from one public, unauthenticated endpoint. No key, no
                account &mdash; the same JSON that renders the diagram is yours to pull.
            </p>

            <div class="story-schema__api-command">
                <code>curl @SchemaEndpointUrl</code>
                <button type="button" class="story-schema__api-copy-button" @onclick="CopyEndpointAsync">
                    @(_copied ? "Copied" : "Copy")
                </button>
            </div>

            <div class="story-schema__api-links">
                <a class="story-schema__api-link" href="/api/transparency/schema" target="_blank" rel="noopener noreferrer">
                    /api/transparency/schema
                </a>
                <a class="story-schema__api-link" href="/api/transparency/stats" target="_blank" rel="noopener noreferrer">
                    /api/transparency/stats
                </a>
            </div>

            <ul class="story-schema__api-notes">
                @foreach (var note in _schema.Notes)
                {
                    <li>@note</li>
                }
            </ul>
        </div>
    }
</section>

<!-- ==================== THE RECIPE · HOW IT'S BUILT ==================== -->
<section class="story-recipe" data-recruiter-section>
    <div class="recruiter-section-heading section-heading">
        <p class="eyebrow" data-recruiter-animate="lift">The Recipe</p>
        <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
            <span class="mask-line"><span class="mask-line__inner">How it's</span></span>
            <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">built.</em></span></span>
        </h2>
    </div>

    <div class="story-recipe__rail" data-provenance-rail>
        <span class="story-recipe__track" aria-hidden="true"></span>
        <span class="story-recipe__fill" aria-hidden="true"></span>

        <ol class="story-recipe__stations" data-recruiter-stagger>
            <li class="story-recipe__station" data-recruiter-animate="lift" data-recruiter-observe-self>
                <span class="story-recipe__node" aria-hidden="true"></span>
                <p class="story-recipe__mono">01 &middot; DOMAIN</p>
                <p class="story-recipe__copy">Entities and enums — the vocabulary of the café.</p>
            </li>
            <li class="story-recipe__station" data-recruiter-animate="lift" data-recruiter-observe-self>
                <span class="story-recipe__node" aria-hidden="true"></span>
                <p class="story-recipe__mono">02 &middot; APPLICATION</p>
                <p class="story-recipe__copy">Services, DTOs, validation — the recipes.</p>
            </li>
            <li class="story-recipe__station" data-recruiter-animate="lift" data-recruiter-observe-self>
                <span class="story-recipe__node" aria-hidden="true"></span>
                <p class="story-recipe__mono">03 &middot; INFRASTRUCTURE</p>
                <p class="story-recipe__copy">EF Core on PostgreSQL, plus Azure storage, messaging, and email.</p>
            </li>
            <li class="story-recipe__station" data-recruiter-animate="lift" data-recruiter-observe-self>
                <span class="story-recipe__node" aria-hidden="true"></span>
                <p class="story-recipe__mono">04 &middot; WEB</p>
                <p class="story-recipe__copy">Blazor Web App on .NET 10, rendered interactively — the counter.</p>
            </li>
            <li class="story-recipe__station" data-recruiter-animate="lift" data-recruiter-observe-self>
                <span class="story-recipe__node" aria-hidden="true"></span>
                <p class="story-recipe__mono">05 &middot; WORKER</p>
                <p class="story-recipe__copy">A background service consuming order-processing messages — the back room.</p>
            </li>
        </ol>
    </div>

    <p class="story-recipe__stack" data-recruiter-animate="type" data-recruiter-delay="200" data-recruiter-observe-self>
        <span class="type-line">dotnet 10 &middot; blazor server &middot; clean architecture &middot; xunit + testcontainers</span>
    </p>
</section>

<!-- ==================== THE POUR · HOW IT'S DEPLOYED ==================== -->
<section class="story-pour" data-recruiter-section>
    <div class="recruiter-section-heading section-heading">
        <p class="eyebrow" data-recruiter-animate="lift">The Pour</p>
        <h2 data-recruiter-animate="mask-line" data-recruiter-delay="120">
            <span class="mask-line"><span class="mask-line__inner">Served from</span></span>
            <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">the cloud.</em></span></span>
        </h2>
    </div>

    <div class="story-pour__log" aria-label="Deployment sequence">
        <p class="story-pour__log-line" data-recruiter-animate="type" data-recruiter-delay="100">
            <span class="type-line">$ git push origin main</span>
        </p>
        <p class="story-pour__log-line" data-recruiter-animate="type" data-recruiter-delay="700">
            <span class="type-line">&rarr; github actions &middot; docker build</span>
        </p>
        <p class="story-pour__log-line" data-recruiter-animate="type" data-recruiter-delay="1300">
            <span class="type-line">&rarr; push &middot; azure container registry</span>
        </p>
        <p class="story-pour__log-line" data-recruiter-animate="type" data-recruiter-delay="1900">
            <span class="type-line">&rarr; deploy &middot; azure container apps</span>
        </p>
        <p class="story-pour__log-line story-pour__log-line--done" data-recruiter-animate="type" data-recruiter-delay="2500">
            <span class="type-line">&check; live at cafe.alexisreyna.dev</span>
        </p>
    </div>

    <div class="story-pour__estate" data-recruiter-stagger>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Container Apps</p>
            <p class="story-pour__card-copy">Consumption plan, running the Blazor app and the worker.</p>
        </div>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Postgres Flexible Server</p>
            <p class="story-pour__card-copy">The system of record, via EF Core.</p>
        </div>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Service Bus</p>
            <p class="story-pour__card-copy">Order-processing queue, consumed by the Worker.</p>
        </div>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Key Vault</p>
            <p class="story-pour__card-copy">Secrets and connection strings, never in source.</p>
        </div>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Blob Storage</p>
            <p class="story-pour__card-copy">Product imagery and static assets.</p>
        </div>
        <div class="story-pour__card" data-recruiter-animate="lift" data-recruiter-observe-self>
            <p class="story-pour__card-mono">Communication Email</p>
            <p class="story-pour__card-copy">Order confirmations and account emails.</p>
        </div>
    </div>

    <p class="story-pour__stat" data-recruiter-animate="lift" data-recruiter-observe-self>
        <span class="story-pour__stat-number" data-count-to="11">0</span>
        <span class="story-pour__stat-caption">Bicep modules provisioning the estate</span>
    </p>
</section>

<!-- ==================== MANIFESTO CLOSE ==================== -->
<section class="story-manifesto" data-recruiter-section>
    <h2 class="story-manifesto__headline" data-recruiter-animate="mask-line" data-recruiter-delay="120">
        <span class="mask-line"><span class="mask-line__inner">Fictional coffee.</span></span>
        <span class="mask-line"><span class="mask-line__inner"><em class="headline-italic">Real craft.</em></span></span>
    </h2>

    <div class="story-manifesto__actions" data-recruiter-animate="lift" data-recruiter-delay="360">
        <a class="button button--dark" href="products">Shop the beans</a>
        <a class="button button--ghost" href="https://github.com/AlejoReyna/ArtisanalBrew" target="_blank" rel="noopener noreferrer">Read the source</a>
    </div>
</section>
</div>

<style>
    .story-surface {
        background: var(--surface);
        inset: 0;
        pointer-events: none;
        position: fixed;
        z-index: -3;
    }

    .story-white-run {
        background: #fff;
        box-shadow: 0 0 0 100vmax #fff;
        clip-path: inset(0 -100vmax);
        color: #1f1a18;
        min-height: 100svh;
    }

    /* ===== Hero ===== */
    .story-hero {
        align-items: center;
        background: #0f0f11;
        box-sizing: border-box;
        display: grid;
        isolation: isolate;
        margin: calc(clamp(1.25rem, 3vw, 3rem) * -1) calc(50% - 50vw) clamp(4rem, 8vw, 8rem);
        max-width: none;
        min-height: 100svh;
        overflow: hidden;
        padding: clamp(4rem, 10vh, 7rem) clamp(1.25rem, 6vw, 5rem);
        position: relative;
        text-align: center;
        width: 100vw;
    }

    .story-hero__media,
    .story-hero__poster,
    .story-hero__video,
    .story-hero__scrim {
        height: 100%;
        inset: 0;
        position: absolute;
        width: 100%;
    }

    .story-hero__media {
        overflow: hidden;
        z-index: -2;
    }

    .story-hero__poster,
    .story-hero__video {
        display: block;
        object-fit: cover;
        object-position: center;
    }

    .story-hero__video {
        opacity: 0;
        transition: opacity 700ms linear;
    }

    .story-hero__video.is-ready {
        opacity: 1;
    }

    .story-hero__scrim {
        background:
            radial-gradient(circle at 50% 44%, rgba(16, 14, 13, 0.18), rgba(16, 14, 13, 0.56) 76%),
            linear-gradient(180deg, rgba(16, 14, 13, 0.3), rgba(16, 14, 13, 0.58));
        z-index: -1;
    }

    .story-hero__content {
        margin-inline: auto;
        max-width: 46rem;
        position: relative;
        z-index: 1;
    }

    .story-hero__guess {
        align-items: baseline;
        color: rgba(251, 249, 244, 0.74);
        display: flex;
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        gap: 0.4rem;
        justify-content: center;
        letter-spacing: 0.04em;
        margin: 0 0 1.25rem;
        min-height: 1.2em;
    }

    .story-hero__guess-prefix {
        color: rgba(251, 249, 244, 0.5);
    }

    .story-hero__guess-cursor {
        animation: storyHeroGuessCaret 1s step-end infinite;
        background: rgba(251, 249, 244, 0.85);
        display: inline-block;
        height: 1em;
        vertical-align: text-bottom;
        width: 0.5ch;
    }

    @@keyframes storyHeroGuessCaret {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
    }

    .story-hero__headline {
        line-height: 0.98;
    }

    /* 8-bit 3D headline, ported from the home hero (ph-title3d): Press Start
       2P white faces with a 2px near-black keyline, then a stacked hard-edge
       text-shadow stepping down-right as the blocky extrusion, darkening
       toward the back. Letters bob in a staggered stepped ripple. */
    .story-title3d {
        color: #FFFDF9;
        font-family: 'Press Start 2P', var(--crypto-mono);
        font-size: clamp(1.3rem, 5vw, 3.2rem);
        letter-spacing: 0.14em;
        line-height: 1;
        padding-right: 0.45em; /* keeps the last letter's extrusion on-canvas */
    }

    .story-title3d__line {
        display: block;
    }

    .story-title3d__line + .story-title3d__line {
        margin-top: 0.75em;
    }

    .story-title3d__word {
        display: inline-block;
        white-space: nowrap;
    }

    .story-title3d__word + .story-title3d__word {
        margin-left: 1.1em;
    }

    .story-title3d__letter {
        animation: story-title3d-bob 2.6s steps(4, end) infinite;
        animation-delay: calc(var(--i) * 120ms);
        display: inline-block;
        text-shadow:
            -2px -2px 0 #0B0806,
            0 -2px 0 #0B0806,
            2px -2px 0 #0B0806,
            -2px 0 0 #0B0806,
            -2px 2px 0 #0B0806,
            2px 2px 0 #2A1C11,
            4px 4px 0 #2A1C11,
            6px 6px 0 #241810,
            8px 8px 0 #1A110A,
            10px 10px 0 #0B0806;
        will-change: transform;
    }

    @@media (hover: hover) and (pointer: fine) {
        .story-title3d__letter:hover {
            animation: none;
            transform: translate(-2px, -4px);
        }
    }

    @@keyframes story-title3d-bob {
        0%, 100% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(0, -0.22em, 0); }
    }

    .story-hero__lede {
        color: rgba(251, 249, 244, 0.9);
        margin-inline: auto;
    }

    .story-hero__github {
        align-items: center;
        border: 1px solid rgba(251, 249, 244, 0.4);
        border-radius: 999px;
        color: #fbf9f4;
        display: inline-flex;
        font-family: var(--crypto-mono);
        font-size: 0.78rem;
        gap: 0.55rem;
        letter-spacing: 0.02em;
        margin-top: 1.5rem;
        padding: 0.55rem 1.1rem;
        text-decoration: none;
        transition: background 160ms ease, border-color 160ms ease;
    }

    .story-hero__github:hover {
        background: rgba(251, 249, 244, 0.12);
        border-color: rgba(251, 249, 244, 0.7);
    }

    .story-hero__github-icon {
        flex: none;
        height: 1rem;
        width: 1rem;
    }

    /* ===== The Fiction ===== */
    .story-fiction {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-fiction__heading {
        margin-bottom: clamp(2rem, 5vw, 3rem);
        max-width: 40rem;
    }

    .story-fiction__columns {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        grid-template-columns: repeat(2, 1fr);
    }

    .story-fiction__infra {
        margin-top: clamp(3rem, 7vw, 5rem);
    }

    .story-fiction__terminal {
        background: var(--charcoal);
        border-radius: 0.85rem;
        box-shadow: 0 24px 60px -24px rgba(31, 26, 24, 0.45);
        overflow: hidden;
    }

    .story-fiction__terminal-bar {
        align-items: center;
        background: rgba(255, 253, 249, 0.05);
        border-bottom: 1px solid rgba(255, 253, 249, 0.08);
        display: flex;
        gap: 0.45rem;
        padding: 0.85rem 1.1rem;
    }

    .story-fiction__terminal-dot {
        border-radius: 50%;
        flex: none;
        height: 11px;
        width: 11px;
    }

    .story-fiction__terminal-dot--red {
        background: #ff5f56;
    }

    .story-fiction__terminal-dot--yellow {
        background: #ffbd2e;
    }

    .story-fiction__terminal-dot--green {
        background: #27c93f;
    }

    .story-fiction__terminal-title {
        color: rgba(255, 253, 249, 0.45);
        font-family: var(--crypto-mono);
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        margin: 0 0 0 0.5rem;
    }

    .story-fiction__terminal-body {
        padding: clamp(1.5rem, 4vw, 2.5rem);
    }

    .story-fiction__infra-mono {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        margin: 0;
    }

    .story-fiction__infra-mono .type-line {
        border-right-color: rgba(255, 253, 249, 0.4);
    }

    .story-fiction__infra-caption {
        color: rgba(255, 253, 249, 0.4);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        margin: 0.5rem 0 0;
        text-transform: uppercase;
    }

    .story-fiction__infra-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
        margin-top: 1.75rem;
        position: relative;
    }

    .story-fiction__infra-card {
        background: rgba(255, 253, 249, 0.03);
        border: 1px solid rgba(255, 253, 249, 0.12);
        border-radius: 0.75rem;
        box-sizing: border-box;
        overflow: hidden;
        padding: 1.15rem 1.25rem;
    }

    .story-fiction__infra-card.is-dimmed {
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease;
    }

    .story-fiction__infra-card.is-expanded {
        background: var(--charcoal);
        box-shadow: 0 30px 70px -24px rgba(0, 0, 0, 0.55);
        clip-path: none !important;
        filter: none !important;
        opacity: 1 !important;
        transform: none !important;
        z-index: 5;
    }

    .story-fiction__infra-face {
        all: unset;
        box-sizing: border-box;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .story-fiction__infra-card.is-expanded .story-fiction__infra-face {
        display: none;
    }

    .story-fiction__infra-expanded {
        display: none;
    }

    .story-fiction__infra-card.is-expanded .story-fiction__infra-expanded {
        animation: infraExpandedContentIn 320ms cubic-bezier(.16, 1, .3, 1) both;
        animation-delay: 160ms;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow-y: auto;
        width: 100%;
    }

    @@keyframes infraExpandedContentIn {
        from {
            opacity: 0;
            transform: translate3d(0, 10px, 0);
        }
        to {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    .story-fiction__infra-back {
        all: unset;
        align-items: center;
        color: rgba(255, 253, 249, 0.6);
        cursor: pointer;
        display: inline-flex;
        font-family: var(--crypto-mono);
        font-size: 0.8rem;
        gap: 0.4rem;
        letter-spacing: 0.02em;
        margin-bottom: 1.5rem;
        transition: color 200ms ease;
    }

    .story-fiction__infra-back:hover {
        color: var(--white);
    }

    .story-fiction__infra-description {
        color: rgba(255, 253, 249, 0.7);
        font-size: 1rem;
        line-height: 1.75;
        margin: 1rem 0 0;
        max-width: 36rem;
    }

    .story-fiction__infra-expanded .story-fiction__infra-name {
        font-size: 1.4rem;
        margin-top: 1.5rem;
    }

    .story-fiction__infra-card-top {
        align-items: center;
        display: flex;
        gap: 0.5rem;
    }

    .story-fiction__infra-icon {
        flex: none;
        height: 20px;
        width: 20px;
    }

    .story-fiction__infra-dot {
        background: #e5c078;
        border-radius: 50%;
        flex: none;
        height: 7px;
        width: 7px;
    }

    .story-fiction__infra-dot.is-up {
        background: #8fb99b;
    }

    .story-fiction__infra-category {
        color: rgba(255, 253, 249, 0.45);
        font-family: var(--crypto-mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        margin: 0;
        text-transform: uppercase;
    }

    .story-fiction__infra-status {
        color: rgba(255, 253, 249, 0.85);
        font-family: var(--crypto-mono);
        font-size: 10px;
        letter-spacing: 0.04em;
        margin: 0 0 0 auto;
        text-transform: uppercase;
    }

    .story-fiction__infra-name {
        color: var(--white);
        font-family: var(--crypto-mono);
        font-size: 0.95rem;
        margin: 0.65rem 0 0;
    }

    .story-fiction__infra-detail {
        color: rgba(255, 253, 249, 0.55);
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0.35rem 0 0;
    }

    @@media (min-width: 700px) {
        .story-fiction__infra-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* ===== The Path ===== */
    .story-path {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-path__intro {
        color: var(--muted);
        line-height: 1.7;
        margin-top: 1.5rem;
        max-width: 38rem;
    }

    .story-path__rail {
        margin-top: clamp(3rem, 7vw, 5rem);
        position: relative;
    }

    .story-path__track,
    .story-path__fill {
        bottom: 0;
        left: 1.35rem;
        position: absolute;
        top: 0;
        width: 2px;
    }

    .story-path__track {
        background: var(--line);
    }

    .story-path__fill {
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 35%, transparent), var(--accent));
        transform: scaleY(0);
        transform-origin: top;
        will-change: transform;
    }

    .story-path__packet {
        background: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent),
                    0 0 18px 2px color-mix(in srgb, var(--accent) 45%, transparent);
        height: 10px;
        left: calc(1.35rem - 4px);
        opacity: 0;
        position: absolute;
        top: -5px;
        transition: opacity 260ms ease;
        width: 10px;
        will-change: transform;
    }

    .story-path__stops {
        display: grid;
        gap: clamp(2.5rem, 6vw, 3.5rem);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .story-path__stop {
        opacity: 0.45;
        padding-left: 3.25rem;
        position: relative;
        transition: opacity 420ms ease;
    }

    .story-path__stop.is-reached {
        opacity: 1;
    }

    .story-path__node {
        background: var(--surface);
        border: 1.5px solid var(--line);
        border-radius: 50%;
        height: 12px;
        left: calc(1.35rem - 5px);
        position: absolute;
        top: 0.3rem;
        transition: background 420ms ease, border-color 420ms ease, transform 420ms cubic-bezier(.16, 1, .3, 1);
        width: 12px;
    }

    .story-path__stop.is-reached .story-path__node {
        background: var(--accent);
        border-color: var(--accent);
        transform: scale(1.25);
    }

    .story-path__stop.is-deferred .story-path__node {
        background: var(--surface);
        border-style: dashed;
    }

    .story-path__index {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        margin: 0 0 0.4rem;
    }

    .story-path__call {
        color: var(--ink);
        font-family: var(--crypto-mono);
        font-size: 0.95rem;
        line-height: 1.4;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .story-path__stop.is-deferred .story-path__call {
        color: var(--muted);
    }

    .story-path__where {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        margin: 0.45rem 0 0;
        text-transform: uppercase;
    }

    .story-path__copy {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.65;
        margin: 0.75rem 0 0;
        max-width: 34rem;
    }

    .story-path__writes {
        align-items: center;
        color: var(--ink);
        display: inline-flex;
        flex-wrap: wrap;
        font-family: var(--crypto-mono);
        font-size: 0.78rem;
        gap: 0.5rem;
        margin: 0.85rem 0 0;
    }

    .story-path__writes-label {
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 0.12em;
        padding: 0.2rem 0.5rem;
        text-transform: uppercase;
    }

    .story-path__note {
        border-left: 2px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.7;
        margin-top: clamp(2.5rem, 6vw, 4rem);
        max-width: 42rem;
        padding-left: 1.25rem;
    }

    /* ===== The Schema ===== */
    .story-schema {
        margin-inline: auto;
        margin-top: clamp(4rem, 10vw, 7rem);
        max-width: 64rem;
    }

    .story-schema__intro {
        color: var(--muted);
        line-height: 1.7;
        margin-top: 1.5rem;
        max-width: 40rem;
    }

    .story-schema__empty {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        margin-top: 2.5rem;
    }

    .story-schema__stats {
        border-top: 1px solid var(--line);
        display: grid;
        gap: 0;
        grid-template-columns: repeat(2, 1fr);
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .story-schema__stat {
        border-bottom: 1px solid var(--line);
        padding-block: 1.5rem;
    }

    .story-schema__stat-number {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 5vw, 2.6rem);
        line-height: 1;
        margin: 0;
    }

    .story-schema__stat-caption {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        margin: 0.5rem 0 0;
        text-transform: uppercase;
    }

    .story-schema__groups {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: clamp(2rem, 5vw, 3rem);
    }

    .story-schema__group {
        align-items: center;
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--muted);
        cursor: pointer;
        display: inline-flex;
        font-family: var(--crypto-mono);
        font-size: 0.75rem;
        gap: 0.5rem;
        letter-spacing: 0.04em;
        padding: 0.5rem 0.9rem;
        transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
    }

    .story-schema__group:hover {
        border-color: var(--accent);
        color: var(--ink);
    }

    .story-schema__group.is-active {
        background: var(--charcoal);
        border-color: var(--charcoal);
        color: var(--white);
    }

    .story-schema__group-count {
        color: currentColor;
        font-size: 10px;
        opacity: 0.6;
    }

    .story-schema__grid {
        display: grid;
        gap: 0.85rem;
        grid-template-columns: 1fr;
        margin-top: 1.5rem;
    }

    .story-schema__table {
        border: 1px solid var(--line);
        border-radius: 0.7rem;
        overflow: hidden;
        transition: border-color 300ms ease, box-shadow 300ms ease;
    }

    .story-schema__table.is-open {
        border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    }

    .story-schema__table.is-highlighted {
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .story-schema__table-head {
        align-items: center;
        background: transparent;
        border: none;
        color: var(--ink);
        cursor: pointer;
        display: flex;
        font-family: var(--crypto-mono);
        gap: 0.75rem;
        padding: 0.95rem 1.1rem;
        text-align: left;
        width: 100%;
    }

    .story-schema__table-name {
        font-size: 0.9rem;
        overflow-wrap: anywhere;
    }

    .story-schema__table-meta {
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        font-size: 10px;
        gap: 0.75rem;
        letter-spacing: 0.06em;
        margin-left: auto;
        text-transform: uppercase;
    }

    .story-schema__table-rows {
        color: var(--accent);
    }

    .story-schema__table-chevron {
        color: var(--muted);
        flex: none;
        font-size: 1rem;
        line-height: 1;
        width: 0.75rem;
    }

    .story-schema__columns {
        border-top: 1px solid var(--line);
        display: grid;
        gap: 0;
        padding: 0.5rem 0;
    }

    .story-schema__column {
        align-items: baseline;
        display: grid;
        font-family: var(--crypto-mono);
        font-size: 0.78rem;
        gap: 0.75rem;
        grid-template-columns: 2rem 1fr auto;
        padding: 0.4rem 1.1rem;
    }

    .story-schema__column-name {
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .story-schema__column-type {
        color: var(--muted);
        font-size: 0.7rem;
        text-align: right;
    }

    .story-schema__badge {
        border-radius: 3px;
        display: inline-block;
        font-size: 9px;
        letter-spacing: 0.06em;
        padding: 0.1rem 0.3rem;
    }

    .story-schema__badge--pk {
        background: color-mix(in srgb, var(--accent) 22%, transparent);
        color: var(--ink);
    }

    .story-schema__badge--fk {
        border: 1px solid var(--line);
        color: var(--muted);
    }

    .story-schema__refs {
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.85rem 1.1rem;
    }

    .story-schema__ref {
        background: transparent;
        border: 1px dashed var(--line);
        border-radius: 999px;
        color: var(--muted);
        cursor: pointer;
        font-family: var(--crypto-mono);
        font-size: 0.7rem;
        padding: 0.3rem 0.65rem;
        transition: border-color 200ms ease, color 200ms ease;
    }

    .story-schema__ref:hover {
        border-color: var(--accent);
        border-style: solid;
        color: var(--ink);
    }

    .story-schema__api {
        background: var(--charcoal);
        border-radius: 0.85rem;
        margin-top: clamp(2.5rem, 6vw, 4rem);
        padding: clamp(1.75rem, 4vw, 2.5rem);
    }

    .story-schema__api-eyebrow {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        margin: 0;
        text-transform: uppercase;
    }

    .story-schema__api-copy {
        color: rgba(255, 253, 249, 0.7);
        line-height: 1.7;
        margin: 0.85rem 0 0;
        max-width: 36rem;
    }

    .story-schema__api-command {
        align-items: center;
        background: rgba(255, 253, 249, 0.05);
        border: 1px solid rgba(255, 253, 249, 0.12);
        border-radius: 0.5rem;
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 0.75rem 0.75rem 0.75rem 1rem;
    }

    .story-schema__api-command code {
        color: var(--white);
        font-family: var(--crypto-mono);
        font-size: 0.78rem;
        overflow-wrap: anywhere;
    }

    .story-schema__api-copy-button {
        background: rgba(255, 253, 249, 0.1);
        border: none;
        border-radius: 0.35rem;
        color: var(--white);
        cursor: pointer;
        flex: none;
        font-family: var(--crypto-mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        margin-left: auto;
        padding: 0.45rem 0.75rem;
        text-transform: uppercase;
        transition: background 200ms ease;
    }

    .story-schema__api-copy-button:hover {
        background: rgba(255, 253, 249, 0.2);
    }

    .story-schema__api-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin-top: 1.25rem;
    }

    .story-schema__api-link {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 0.78rem;
        text-decoration: none;
        text-underline-offset: 3px;
    }

    .story-schema__api-link:hover {
        text-decoration: underline;
    }

    .story-schema__api-notes {
        color: rgba(255, 253, 249, 0.45);
        font-size: 0.8rem;
        line-height: 1.7;
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
    }

    .story-schema__api-notes li {
        padding-left: 1rem;
        position: relative;
    }

    .story-schema__api-notes li::before {
        content: "·";
        left: 0.25rem;
        position: absolute;
    }

    @@media (min-width: 700px) {
        .story-schema__stats {
            grid-template-columns: repeat(4, 1fr);
        }

        .story-schema__grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .story-schema__table.is-open {
            grid-column: 1 / -1;
        }
    }

    /* ===== The Recipe ===== */
    .story-recipe {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-recipe__rail {
        margin-top: clamp(3rem, 7vw, 5rem);
        position: relative;
    }

    .story-recipe__track,
    .story-recipe__fill {
        bottom: 0;
        left: 1.35rem;
        position: absolute;
        top: 0;
        width: 2px;
    }

    .story-recipe__track {
        background: var(--line);
    }

    .story-recipe__fill {
        background: var(--accent);
        transform: scaleY(0);
        transform-origin: top;
    }

    .story-recipe__stations {
        display: grid;
        gap: clamp(2rem, 6vw, 3rem);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .story-recipe__station {
        padding-left: 3rem;
        position: relative;
    }

    .story-recipe__node {
        background: var(--surface);
        border: 1.5px solid var(--line);
        border-radius: 50%;
        height: 12px;
        left: calc(1.35rem - 5px);
        position: absolute;
        top: 0.15rem;
        transition: background 500ms ease, border-color 500ms ease;
        width: 12px;
    }

    .story-recipe__station.is-visible .story-recipe__node {
        background: color-mix(in srgb, var(--accent) 40%, transparent);
        border-color: var(--accent);
    }

    .story-recipe__mono {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .story-recipe__copy {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.2rem;
        line-height: 1.35;
        margin: 0;
    }

    .story-recipe__stack {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        margin-top: clamp(2.5rem, 6vw, 4rem);
        text-align: center;
    }

    /* ===== The Yield (charcoal band) ===== */
    .story-yield {
        background: var(--charcoal);
        box-sizing: border-box;
        margin-inline: calc(50% - 50vw);
        overflow: hidden;
        padding-block: clamp(4.5rem, 12vw, 8rem);
        padding-inline: clamp(1.25rem, 4vw, 3rem);
        position: relative;
        width: 100vw;
    }

    .story-yield__ring {
        aspect-ratio: 1;
        border: 1.5px solid rgba(255, 253, 249, 0.07);
        border-radius: 50%;
        animation: storyYieldRingSpin 90s linear infinite;
        pointer-events: none;
        position: absolute;
        right: -240px;
        top: -240px;
        width: 480px;
    }

    .story-yield__ring--outer {
        border-color: rgba(255, 253, 249, 0.04);
        right: -264px;
        top: -264px;
        width: 528px;
    }

    @@keyframes storyYieldRingSpin {
        to { transform: rotate(360deg); }
    }

    .story-yield__content {
        margin-inline: auto;
        max-width: 720px;
        position: relative;
        text-align: center;
        z-index: 1;
    }

    .story-yield__headline {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 9vw, 4rem);
        margin: 0;
    }

    .story-yield__body {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        line-height: 1.7;
        margin: 1.5rem auto 0;
        max-width: 32rem;
    }

    .story-yield__body code {
        background: rgba(255, 253, 249, 0.08);
        border-radius: 4px;
        color: var(--white);
        font-family: var(--crypto-mono);
        font-size: 0.9em;
        padding: 0.1em 0.4em;
    }

    .story-yield__flow {
        display: grid;
        gap: 1.25rem;
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .story-yield__step {
        background: rgba(255, 253, 249, 0.03);
        border: 1px solid rgba(255, 253, 249, 0.12);
        border-radius: 0.85rem;
        padding: 1.5rem;
        text-align: left;
    }

    .story-yield__step-mono {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        margin: 0 0 0.5rem;
    }

    .story-yield__step-copy {
        color: rgba(255, 253, 249, 0.65);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 0;
    }

    .story-yield__stats {
        border-top: 1px solid rgba(255, 253, 249, 0.14);
        margin-top: clamp(2.5rem, 6vw, 4rem);
    }

    .story-yield__stat {
        border-bottom: 1px solid rgba(255, 253, 249, 0.14);
        padding-block: 1.75rem;
    }

    .story-yield__stat-number {
        color: var(--white);
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 8vw, 3.5rem);
        line-height: 1;
        margin: 0;
    }

    .story-yield__stat-caption {
        color: rgba(255, 253, 249, 0.5);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        margin: 0.6rem 0 0;
        text-transform: uppercase;
    }

    .story-yield__footnote {
        color: rgba(255, 253, 249, 0.4);
        font-family: var(--crypto-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        margin-top: clamp(2rem, 5vw, 3rem);
        text-transform: uppercase;
    }

    .story-yield__cta {
        margin-top: 1.5rem;
    }

    .story-yield__cta-button {
        background: var(--surface);
        border: none;
        color: var(--ink);
    }

    .story-yield__cta-button:hover {
        background: var(--white);
        color: var(--ink);
    }

    @@media (min-width: 700px) {
        .story-yield__flow {
            grid-template-columns: repeat(3, 1fr);
        }

        .story-yield__stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
        }

        .story-yield__stat {
            border-bottom: none;
            border-right: 1px solid rgba(255, 253, 249, 0.14);
        }

        .story-yield__stat:last-child {
            border-right: none;
        }
    }

    /* ===== The Pour ===== */
    .story-pour {
        margin-inline: auto;
        max-width: 64rem;
    }

    .story-pour__log {
        background: var(--charcoal);
        border-radius: 0.85rem;
        margin-top: clamp(3rem, 7vw, 5rem);
        padding: clamp(1.75rem, 4vw, 2.5rem);
    }

    .story-pour__log-line {
        color: rgba(255, 253, 249, 0.55);
        font-family: var(--crypto-mono);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        margin: 0;
        padding-block: 0.35rem;
    }

    .story-pour__log-line--done {
        color: var(--white);
    }

    .story-pour__log-line .type-line {
        border-right-color: rgba(255, 253, 249, 0.4);
    }

    .story-pour__estate {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: 1fr;
        margin-top: clamp(3rem, 7vw, 5rem);
    }

    .story-pour__card {
        border: 1px solid var(--line);
        border-radius: 0.85rem;
        padding: 1.5rem;
    }

    .story-pour__card-mono {
        color: var(--accent);
        font-family: var(--crypto-mono);
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
    }

    .story-pour__card-copy {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.55;
        margin: 0;
    }

    .story-pour__stat {
        align-items: baseline;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-top: clamp(3rem, 6vw, 4rem);
        text-align: center;
    }

    .story-pour__stat-number {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1;
    }

    .story-pour__stat-caption {
        color: var(--muted);
        font-family: var(--crypto-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @@media (min-width: 700px) {
        .story-pour__estate {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* ===== Manifesto ===== */
    .story-manifesto {
        margin-inline: auto;
        max-width: 40rem;
        padding-block: clamp(3rem, 8vw, 6rem);
        text-align: center;
    }

    .story-manifesto__headline {
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        line-height: 1.05;
    }

    .story-manifesto__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-top: 2.5rem;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 700px) {
        .story-hero {
            min-height: 100svh;
        }

        .story-hero__poster,
        .story-hero__video {
            object-position: 62% center;
        }

        .story-fiction__columns {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .story-hero__video {
            display: none;
            transition: none;
        }

        .story-hero__guess-cursor {
            animation: none;
            opacity: 0;
        }

        .story-title3d__letter {
            animation: none;
            transform: none;
        }

        .story-yield__ring {
            animation: none;
            display: none;
        }

        .story-path__stop {
            opacity: 1;
            transition: none;
        }

        .story-path__node {
            transition: none;
        }

        .story-path__packet {
            display: none;
        }
    }

    @@media (prefers-contrast: more) {
        .story-hero__scrim {
            background: rgba(16, 14, 13, 0.78);
        }
    }
</style>

@code {
    private static readonly string[] HeroHeadlineLines = ["This café", "doesn't exist."];

    // ===== The Path =====
    private sealed record PathStop(string Call, string Where, string Copy, string? Writes, bool IsDeferred = false);

    private static readonly PathStop[] DataPath =
    [
        new("POST /checkout",
            "Blazor Server circuit · Checkout.razor",
            "The wallet pays first. The ETH transfer is polled until Sepolia confirms it — no row is written against an unconfirmed payment.",
            null),

        new("OrderPricingService.Calculate()",
            "Application layer · FluentValidation",
            "The request is validated, the coupon re-quoted server-side, and subtotal, shipping, tax and discount recomputed from scratch. Whatever the browser claimed the total was is discarded.",
            null),

        new("orderRepository.AddAsync()",
            "EF Core · Postgres Flexible Server",
            "The order, its line items, and any coupon redemption are written together — one SaveChanges, one transaction, all of it or none of it.",
            "Orders · OrderItems · CouponRedemptions"),

        new("TransparencyService.CreatePendingRecordsForOrderAsync()",
            "Application layer · SHA-256",
            "Line items are sorted, joined, and hashed into a single order hash. Each item gets a record stamped with the chain id and network, status Pending, waiting to be anchored.",
            "TransparencyRecords"),

        new("ReceiptService.SendReceiptAsync()",
            "QuestPDF · Blob Storage · Communication Services",
            "A PDF is rendered in-process, uploaded to Blob Storage, and emailed through Azure's managed relay.",
            "Receipts"),

        new("order-processing",
            "Service Bus · OrderProcessingWorker",
            "The queue is provisioned and the worker holds an open receiver on it. Nothing publishes to it yet — it is the seam where the synchronous path above gets to become asynchronous.",
            null,
            IsDeferred: true)
    ];

    // ===== The Schema =====
    private static readonly string[] SchemaGroups =
    [
        "Commerce", "Identity & wallets", "Staking", "Settlement", "Agentic commerce", "Other"
    ];

    private DatabaseSchemaDto? _schema;
    private string? _schemaError;
    private string _activeGroup = "Commerce";
    private string? _openTable;
    private string? _highlightTable;
    private bool _copied;

    private string SchemaEndpointUrl => $"{Navigation.BaseUri.TrimEnd('/')}/api/transparency/schema";

    private IReadOnlyList<SchemaTableDto> TablesIn(string group)
        => _schema is null
            ? []
            : _schema.Tables.Where(table => table.Group == group).ToArray();

    private static string SchemaAnchorId(string table) => $"schema-{table.ToLowerInvariant()}";

    private void SelectGroup(string group)
    {
        _activeGroup = group;
        _openTable = null;
    }

    private void ToggleTable(string table)
    {
        _openTable = _openTable == table ? null : table;
        _highlightTable = null;
    }

    /// <summary>Follows a foreign key: switches to the target's group, opens it, and flags it for highlight.</summary>
    private void JumpToTable(string table)
    {
        var target = _schema?.Tables.FirstOrDefault(candidate => candidate.Table == table);
        if (target is null)
        {
            return;
        }

        _activeGroup = target.Group;
        _openTable = target.Table;
        _highlightTable = target.Table;
    }

    private async Task CopyEndpointAsync()
    {
        _copied = await JSRuntime.InvokeAsync<bool>("storyDataPath.copy", $"curl {SchemaEndpointUrl}");
    }

    protected override async Task OnInitializedAsync()
    {
        var schemaService = Services.GetService<IDatabaseSchemaService>();
        if (schemaService is null)
        {
            _schemaError = "No database is configured for this environment, so there is no schema to show.";
            return;
        }

        try
        {
            _schema = await schemaService.GetSchemaAsync();
        }
        catch (Exception)
        {
            _schemaError = "The schema is temporarily unreadable — the endpoint below still answers.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Run after this route's DOM is committed so enhanced navigation
            // cannot initialize the header against the page being replaced.
            await JSRuntime.InvokeVoidAsync("initPublicHeader");
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.init");
            await JSRuntime.InvokeVoidAsync("storyTechShowcase.init");
            await JSRuntime.InvokeVoidAsync("storyDataPath.init");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("recruiterShowcaseMotion.destroy");
            await JSRuntime.InvokeVoidAsync("storyTechShowcase.destroy");
            await JSRuntime.InvokeVoidAsync("storyDataPath.destroy");
        }
        catch
        {
            // JS runtime may already be disconnected during navigation or prerender disposal.
        }
    }
}
