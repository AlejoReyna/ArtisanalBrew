@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<span class="addr-chip">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="addr-chip__label">@Label</span>
    }
    <span class="addr-chip__value" title="@Address">@ShortAddress</span>
    <button type="button"
            class="addr-chip__copy @(_copied ? "addr-chip__copy--done" : null)"
            aria-label="@(_copied ? "Address copied" : "Copy address")"
            @onclick="CopyAsync">
        @if (_copied)
        {
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
        }
        else
        {
            <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
        }
    </button>
    @if (!string.IsNullOrWhiteSpace(ExplorerUrl))
    {
        <a class="addr-chip__explorer"
           href="@ExplorerAddressUrl"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="View address on block explorer">↗</a>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public string Address { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? ExplorerUrl { get; set; }

    private IJSObjectReference? _module;
    private bool _copied;

    private string ShortAddress =>
        string.IsNullOrWhiteSpace(Address) || Address.Length < 10
            ? Address
            : $"{Address[..6]}…{Address[^4..]}";

    private string ExplorerAddressUrl =>
        $"{ExplorerUrl?.TrimEnd('/')}/address/{Address}";

    private async Task CopyAsync()
    {
        try
        {
            _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Shared/AddressChip.razor.js");

            var copied = await _module.InvokeAsync<bool>("copyText", Address);
            if (!copied)
            {
                return;
            }

            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-copy; nothing to update.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit can disconnect before module disposal.
            }
        }
    }
}
