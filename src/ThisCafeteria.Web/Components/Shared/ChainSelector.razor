@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Web.Services.Blockchain
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject IJSRuntime JsRuntime
@implements IDisposable

<div class="chain-selector @(Compact ? "chain-selector--compact" : string.Empty) @CssClass" @onfocusout="CloseDropdown">
    <button type="button" class="chain-selector__control" @onclick="ToggleDropdown" aria-label="Active blockchain network">
        @if (SelectedChainAccessor.SelectedChain != null)
        {
            <div style="display: flex; align-items: center; gap: 8px;">
                <img src="@SelectedChainAccessor.SelectedChain.IconAsset" alt="" class="chain-icon" width="20" height="20" />
                <span>@SelectedChainAccessor.SelectedChain.ShortName</span>
            </div>
        }
        else
        {
            <span>Select Network</span>
        }
    </button>
    
    @if (_isOpen)
    {
        <div class="chain-selector__dropdown">
            @foreach (var chain in ChainRegistry.All.Where(c => c.Enabled))
            {
                <button type="button" class="chain-selector__option @(chain.Key == SelectedChainAccessor.SelectedChainKey ? "selected" : "")" 
                        @onclick="() => SelectChainAsync(chain.Key)">
                    <img src="@chain.IconAsset" alt="" class="chain-icon" width="20" height="20" />
                    <span>@chain.ShortName</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public EventCallback<ChainDefinition> OnChainChanged { get; set; }

    private bool _isOpen;
    
    private void ToggleDropdown() => _isOpen = !_isOpen;
    
    private async Task CloseDropdown() 
    {
        await Task.Delay(150);
        _isOpen = false;
        StateHasChanged();
    }

    protected override void OnInitialized() => SelectedChainAccessor.Changed += OnSelectedChainChanged;

    private void OnSelectedChainChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => SelectedChainAccessor.Changed -= OnSelectedChainChanged;

    private async Task SelectChainAsync(string key)
    {
        if (string.IsNullOrWhiteSpace(key) || !await SelectedChainAccessor.SelectAsync(key)) return;
        await JsRuntime.InvokeVoidAsync("artisanalChainSelector.persist", key);
        await OnChainChanged.InvokeAsync(SelectedChainAccessor.SelectedChain);
        _isOpen = false;
    }
}
