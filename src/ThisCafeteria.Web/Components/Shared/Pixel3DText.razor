    private static IEnumerable<PixelCell> CellsFor(char character)
    {
        if (!Glyphs.TryGetValue(character, out var rows))
        {
            yield break;
        }

        for (var row = 0; row < rows.Length; row++)
        {
            for (var column = 0; column < rows[row].Length; column++)
            {
                if (rows[row][column] == '1')
                {
                    yield return new PixelCell(row + 1, column + 1);
                }
            }
        }
    }

    private static string GlyphStyle(int lineIndex, int glyphIndex)
    {
        var delay = 140 + (lineIndex * 130) + (glyphIndex * 42);
        return $"--glyph-delay:{delay}ms";
    }

    private static IEnumerable<LayeredPixel> PixelsFor(char character)
    {
        foreach (var depth in DepthLayerIndices)
        {
            foreach (var cell in CellsFor(character))
            {
                yield return new LayeredPixel(cell.Row, cell.Column, depth);
            }
        }

        foreach (var cell in CellsFor(character))
        {
            yield return new LayeredPixel(cell.Row, cell.Column, 0);
        }
    }

    private static string PixelClass(LayeredPixel pixel) =>
        pixel.Depth == 0 ? "pixel-title__pixel--face" : "pixel-title__pixel--depth";

    private static string PixelStyle(LayeredPixel pixel)
    {
        if (pixel.Depth == 0)
        {
            return $"grid-row:{pixel.Row};grid-column:{pixel.Column}";
        }

        var depth = pixel.Depth;
        var offset = depth;
        var compactOffset = (depth * 2 + 1) / 3;
        var shade = 22 + ((DepthLayers - depth) * 8);
        return $"grid-row:{pixel.Row};grid-column:{pixel.Column};--layer-offset:{offset}px;--layer-offset-negative:-{offset}px;--layer-offset-compact:{compactOffset}px;--layer-offset-compact-negative:-{compactOffset}px;--layer-shade:rgb({shade} {shade} {shade})";
    }

    private sealed record PixelCell(int Row, int Column);
    private sealed record LayeredPixel(int Row, int Column, int Depth);
}
