<span class="pixel-title" aria-hidden="true">
    <span class="pixel-title__object">
        @for (var lineIndex = 0; lineIndex < Lines.Length; lineIndex++)
        {
            var line = Lines[lineIndex];
            <span class="pixel-title__line">
                @for (var glyphIndex = 0; glyphIndex < line.Length; glyphIndex++)
                {
                    var character = line[glyphIndex];
                    if (char.IsWhiteSpace(character))
                    {
                        <span class="pixel-title__space"></span>
                    }
                    else
                    {
                        <span class="pixel-title__glyph"
                              style="@GlyphStyle(lineIndex, glyphIndex)">
                            <svg class="pixel-title__glyph-art"
                                 viewBox="-0.5 -0.5 6.4 9.4"
                                 preserveAspectRatio="xMidYMid meet"
                                 shape-rendering="crispEdges"
                                 focusable="false">
                                <defs>
                                    <filter id="@OutlineId(lineIndex, glyphIndex)"
                                            x="-1.2"
                                            y="-1.2"
                                            width="8.8"
                                            height="11.8"
                                            filterUnits="userSpaceOnUse"
                                            primitiveUnits="userSpaceOnUse"
                                            color-interpolation-filters="sRGB">
                                        <feMorphology in="SourceAlpha"
                                                      operator="dilate"
                                                      radius="0.17"
                                                      result="expanded" />
                                        <feFlood flood-color="#0b0919"
                                                 result="outline-color" />
                                        <feComposite in="outline-color"
                                                     in2="expanded"
                                                     operator="in"
                                                     result="outline" />
                                        <feMerge>
                                            <feMergeNode in="outline" />
                                            <feMergeNode in="SourceGraphic" />
                                        </feMerge>
                                    </filter>
                                </defs>

                                <g class="pixel-title__depth pixel-title__depth--far"
                                   filter="@OutlineFilter(lineIndex, glyphIndex)"
                                   transform="translate(0.82 0.92)">
                                    @foreach (var cell in CellsFor(character))
                                    {
                                        <rect x="@(cell.Column - 1)"
                                              y="@(cell.Row - 1)"
                                              width="1.02"
                                              height="1.02" />
                                    }
                                </g>

                                <g class="pixel-title__depth pixel-title__depth--middle"
                                   transform="translate(0.56 0.64)">
                                    @foreach (var cell in CellsFor(character))
                                    {
                                        <rect x="@(cell.Column - 1)"
                                              y="@(cell.Row - 1)"
                                              width="1.02"
                                              height="1.02" />
                                    }
                                </g>

                                <g class="pixel-title__depth pixel-title__depth--near"
                                   transform="translate(0.28 0.32)">
                                    @foreach (var cell in CellsFor(character))
                                    {
                                        <rect x="@(cell.Column - 1)"
                                              y="@(cell.Row - 1)"
                                              width="1.02"
                                              height="1.02" />
                                    }
                                </g>

                                <g class="pixel-title__face"
                                   filter="@OutlineFilter(lineIndex, glyphIndex)">
                                    @foreach (var cell in CellsFor(character))
                                    {
                                        <rect x="@(cell.Column - 1)"
                                              y="@(cell.Row - 1)"
                                              width="1.02"
                                              height="1.02" />
                                    }
                                </g>
                            </svg>
                        </span>
                    }
                }
            </span>
        }
    </span>
</span>

