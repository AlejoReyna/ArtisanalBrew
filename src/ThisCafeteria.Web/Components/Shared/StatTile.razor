<article class="stat-tile @(Accent == StatTileAccent.Positive ? "stat-tile--positive" : null)">
    <p class="stat-tile__label">@Label</p>
    @if (Loading)
    {
        <span class="stat-tile__skeleton" aria-hidden="true"></span>
    }
    else
    {
        <p class="stat-tile__value">
            @Value
            @if (!string.IsNullOrWhiteSpace(Suffix))
            {
                <span class="stat-tile__suffix">@Suffix</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <p class="stat-tile__hint">@Hint</p>
        }
    }
</article>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Suffix { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public StatTileAccent Accent { get; set; } = StatTileAccent.None;

    public enum StatTileAccent
    {
        None,
        Positive
    }
}
