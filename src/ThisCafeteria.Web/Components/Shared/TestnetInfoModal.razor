<script type="module" src="@Assets["Components/Shared/TestnetInfoModal.razor.js"]"></script>

<dialog id="testnet-info-modal" data-nosnippet>
    <button type="button" id="testnet-info-close" class="testnet-info-close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18" />
        </svg>
    </button>
    <div class="testnet-info-hero">
        <svg class="testnet-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12v10H4V12"/>
            <path d="M2 7h20v5H2z"/>
            <path d="M12 22V7"/>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
        </svg>
    </div>
    <div class="testnet-info-content">
        <span class="testnet-info-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right: 4px;">
                <path d="M12 1.5 5.25 12.4 12 16.4l6.75-4L12 1.5Z" />
                <path d="M5.25 13.8 12 22.5l6.75-8.7L12 17.8l-6.75-4Z" />
            </svg>
            Sepolia testnet
        </span>
        <h2 class="testnet-info-title">No real crypto needed</h2>
        <p class="testnet-info-copy">
            Every checkout here runs on free Sepolia test ETH — nothing you do in this shop spends real money. Grab some test ETH from the
            <a href="https://cloud.google.com/application/web3/faucet/ethereum/sepolia" target="_blank" rel="noopener noreferrer">Google Cloud</a>,
            <a href="https://www.alchemy.com/faucets/ethereum-sepolia" target="_blank" rel="noopener noreferrer">Alchemy</a> or
            <a href="https://faucet.chainstack.com/sepolia-testnet-faucet" target="_blank" rel="noopener noreferrer">Chainstack</a> faucet if you'd like to check out.
        </p>
        <div class="testnet-info-actions">
            <button type="button" id="testnet-info-dismiss" class="testnet-info-button">Got it</button>
        </div>
    </div>
</dialog>
