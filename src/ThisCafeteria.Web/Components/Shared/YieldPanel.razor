@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using ThisCafeteria.Application.Configuration
@using ThisCafeteria.Application.Services.Blockchain
@using ThisCafeteria.Domain.Entities
@using ThisCafeteria.Infrastructure.Identity
@using ThisCafeteria.Infrastructure.Persistence
@using System.Security.Claims
@using Nethereum.Util
@using ThisCafeteria.Web.Services.Blockchain
@inject ICoffeeWeb3Service Web3Service
@inject ILiquidStakingGateway LiquidGateway
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptions<BlockchainNetworkOptions> ChainOptions
@inject IChainRegistry ChainRegistry
@inject ISelectedChainAccessor SelectedChainAccessor
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IEthUsdPriceService EthUsdPriceService
@inject WalletDashboardState DashboardState
@inject ISolanaFaucetService SolanaFaucet

@if (!_isConnected)
{
    <section class="staking-connect" data-animate="fade-up">
        <div class="staking-connect__desktop">
            <div class="staking-connect__left">
                <img src="/images/coffee-coin.png" class="staking-connect__bg-coin" alt="Coffee Coin" aria-hidden="true" />
                <div class="staking-connect__content">
                    <div class="staking-connect__chain-wrapper">
                        <ChainSelector OnChainChanged="HandleChainChangedAsync" />
                    </div>
                    <h2>Connect your wallet to deposit CAFE, receive stCAFE, and earn COFFEE.</h2>
                    <p class="lede">Sign in with your wallet from the nav bar to use your account automatically, or connect here for an allocation-only session.</p>
                    @if (!string.IsNullOrWhiteSpace(_connectError))
                    {
                        <p class="text-danger">@_connectError</p>
                    }
                    <button type="button" class="button button--dark button--glow" disabled="@_isConnecting" @onclick="ConnectWalletAsync">
                        @(_isConnecting ? "Connecting..." : SelectedChain.Family == ChainFamily.Solana ? "Connect Solana wallet" : "Connect Wallet")
                    </button>
                    @if (OnBackToProfile.HasDelegate)
                    {
                        <button type="button" class="yield-back yield-back--center" @onclick="OnBackToProfile">
                            <span aria-hidden="true">&larr;</span> Back to Profile
                        </button>
                    }
                </div>
            </div>
            <div class="staking-connect__right">
                <div class="staking-connect__faucet">
                    <FaucetPanel NetworkName="@_chain.NetworkName" ExplorerUrl="@_chain.ExplorerUrl" Family="@SelectedChain.Family" />
                </div>
            </div>
        </div>
        
        <div class="staking-connect__mobile">
            <div class="mobile-top-bar">
                <div class="staking-connect__chain-wrapper">
                    <ChainSelector OnChainChanged="HandleChainChangedAsync" />
                </div>
            </div>

            <h2 class="mobile-title">
                Deposit CAFE, earn powered stCAFE tokens
            </h2>
            <p class="mobile-desc">
                To get started, select a faucet below to grab some testnet ETH for gas fees.
            </p>
            
            <div class="mobile-coin"></div>
            
            @if (!string.IsNullOrWhiteSpace(_connectError))
            {
                <p class="text-danger">@_connectError</p>
            }
            <button type="button" class="button button--dark button--glow mobile-connect-btn" disabled="@_isConnecting" @onclick="ConnectWalletAsync">
                @(_isConnecting ? "Connecting..." : SelectedChain.Family == ChainFamily.Solana ? "Connect Solana wallet" : "Connect Wallet")
            </button>
            @if (OnBackToProfile.HasDelegate)
            {
                <button type="button" class="yield-back yield-back--center" @onclick="OnBackToProfile">
                    <span aria-hidden="true">&larr;</span> Back to Profile
                </button>
            }

            <div class="mobile-options-chain">
                <div class="staking-connect__faucet">
                    <FaucetPanel NetworkName="@_chain.NetworkName" ExplorerUrl="@_chain.ExplorerUrl" Family="@SelectedChain.Family" />
                </div>
            </div>
        </div>
    </section>
}
else
{
    <div class="yield-dashboard" data-animate="fade-up">
        <aside class="yield-sidebar" aria-label="Allocation account overview">
            @if (OnBackToProfile.HasDelegate)
            {
                <button type="button" class="yield-back" @onclick="OnBackToProfile">
                    <span aria-hidden="true">&larr;</span> Back to Profile
                </button>
            }

            <section class="yield-sidebar__identity">
                <ChainSelector OnChainChanged="HandleChainChangedAsync" />
                <p class="yield-sidebar__kicker">Account Overview</p>
                <dl class="yield-sidebar__stats">
                    <div>
                        <dt>Wallet Value</dt>
                        <dd class="tabular">@FormatNativeWalletBalance()</dd>
                    </div>
                    <div>
                        <dt>COFFEE Balance</dt>
                        <dd class="tabular">@FormatDashboardAmount(_dashboard.CoffeeCoinBalance)</dd>
                    </div>
                </dl>
                @if (_liquidDashboard.IsConfigured)
                {
                    <p class="yield-sidebar__status">Liquid staking enabled</p>
                }
            </section>

            <nav class="yield-sidebar__nav" aria-label="Allocation sections">
                <ul class="yield-sidebar__list">
                    <li>
                        <a class="yield-sidebar__link yield-sidebar__link--active" href="staking" aria-current="page">
                            <span class="yield-sidebar__label">Allocation Dashboard</span>
                            <span class="yield-sidebar__goto">
                                <span>View section</span>
                                <span aria-hidden="true">→</span>
                            </span>
                        </a>
                    </li>
                    <li>
                        <a class="yield-sidebar__link" href="profile">
                            <span class="yield-sidebar__label">Transaction Logs</span>
                            <span class="yield-sidebar__goto">
                                <span>View section</span>
                                <span aria-hidden="true">→</span>
                            </span>
                        </a>
                    </li>
                    <li>
                        <a class="yield-sidebar__link" href="profile">
                            <span class="yield-sidebar__label">Preferences</span>
                            <span class="yield-sidebar__goto">
                                <span>View section</span>
                                <span aria-hidden="true">→</span>
                            </span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="yield-sidebar__foot">
                <a class="yield-sidebar__new-stake" href="#liquid-staking-title">Deposit CAFE</a>
                
            </div>
        </aside>

        <div class="yield-main">

            <section class="yield-hero">
                <div class="yield-hero-text">
                    <div class="yield-title-row">
                        <h1>Liquid staking</h1>
                        <span class="yield-apr-badge" title="@AprLabel()">@FormatApr() APR</span>
                    </div>
                </div>

                <div class="yield-stat-row" aria-label="Wallet and staking balances">
                    <StatTile Label="stCAFE"
                              Value="@FormatAmount(_liquidDashboard.StCafeBalance)"
                              Suffix="stCAFE"
                              Loading="_isLoading" />
                    <StatTile Label="Pending Rewards"
                              Value="@FormatPendingRewards()"
                              Suffix="@(_dashboard.PendingStakingRewards is null ? null : "COFFEE")"
                              Accent="StatTile.StatTileAccent.Positive"
                              Hint="@(_dashboard.PendingStakingRewards is null ? "Rewards unavailable - RPC read failed." : null)"
                              OnRetry="PendingRewardsRetryCallback"
                              Loading="_isLoading" />
                    <StatTile Label="CAFE Balance"
                              Value="@FormatAmount(_dashboard.PaymentTokenBalance)"
                              Suffix="CAFE"
                              Loading="_isLoading" />
                    <StatTile Label="@($"{_chain.CurrencySymbol} Balance")"
                              Value="@FormatAmount(_dashboard.NativeBalance)"
                              Suffix="@_chain.CurrencySymbol"
                              Hint="@NativeBalanceUsdHint()"
                              Loading="_isLoading" />
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(_dashboardError))
            {
                <div class="yield-error-note">
                    <p>@_dashboardError</p>
                    <button type="button" @onclick="LoadDashboardAsync">Retry</button>
                </div>
            }

            <section class="yield-liquid-summary" aria-labelledby="liquid-staking-title">
                <div>
                    <p class="yield-card-eyebrow">Liquid staking · @SelectedChain.DisplayName</p>
                    <h2 id="liquid-staking-title">CAFE → stCAFE</h2>
                    @if (!string.IsNullOrWhiteSpace(_liquidDashboard.UnavailableReason))
                    {
                        <p class="yield-config-card__body">@_liquidDashboard.UnavailableReason</p>
                    }
                    else
                    {
                        <p class="yield-hero-lede">Transferable stCAFE tracks your CAFE position. Rewards are separately funded in COFFEE.</p>
                    }
                </div>
                <dl class="yield-liquid-summary__stats">
                    <div><dt>CAFE</dt><dd>@FormatAmount(_liquidDashboard.CafeBalance)</dd></div>
                    <div><dt>stCAFE</dt><dd>@FormatAmount(_liquidDashboard.StCafeBalance)</dd></div>
                    <div><dt>Redeemable</dt><dd>@FormatAmount(_liquidDashboard.RedeemableCafe)</dd></div>
                    <div><dt>Pending COFFEE</dt><dd>@FormatAmount(_liquidDashboard.PendingCoffee)</dd></div>
                </dl>
                @if (_liquidDashboard.IsConfigured)
                {
                    <div class="yield-liquid-summary__actions">
                        <input id="liquid-deposit-amount" class="yield-token-input tabular" inputmode="decimal" placeholder="CAFE to deposit" />
                        <button type="button" class="yield-cta-btn yield-cta-btn--dark btn-liquid-deposit">Deposit CAFE</button>
                        <input id="liquid-redeem-amount" class="yield-token-input tabular" inputmode="decimal" placeholder="stCAFE to redeem" />
                        <button type="button" class="yield-cta-btn yield-cta-btn--outline btn-liquid-redeem">Redeem</button>
                        <button type="button" class="yield-cta-btn yield-cta-btn--outline btn-liquid-claim" disabled="@(_liquidDashboard.PendingCoffee <= 0m)">Claim COFFEE</button>
                    </div>
                }
            </section>

            @if (!_liquidDashboard.IsConfigured)
            {
                <div class="yield-config-card">
                    <p class="yield-config-card__eyebrow">Liquid vault unavailable</p>
                    <p class="yield-config-card__body">
                        New legacy deposits are disabled. This chain does not have a configured liquid vault yet.
                        @if (SelectedChain.Capabilities.LegacyExit)
                        {
                            <span>Exit the legacy Sepolia position first, then deposit CAFE into the liquid vault when it is deployed.</span>
                        }
                    </p>
                </div>
            }

            @if (_cafeFaucetConfigured || _isSolanaFaucet)
            {
                <section class="yield-faucet-cafe" aria-label="Test CAFE faucet">
                    <div class="yield-faucet-cafe__body">
                        <p class="yield-faucet-cafe__eyebrow">Need test CAFE?</p>
                        <h2 class="yield-faucet-cafe__title">Claim @FormatAmount(_faucetStatus.ClaimAmount) CAFE</h2>
                        <p class="yield-faucet-cafe__desc">@FaucetStatusLabel()</p>
                    </div>
                    @if (_isSolanaFaucet)
                    {
                        @* Solana faucet mints server-side under the administrator authority; the wallet
                           never signs, so this is a server @onclick rather than a client contract call. *@
                        <button type="button"
                                class="yield-cta-btn yield-cta-btn--dark"
                                disabled="@(_solanaFaucetClaiming || !_faucetStatus.CanClaim)"
                                @onclick="ClaimSolanaFaucetAsync">
                            @(_solanaFaucetClaiming ? "Minting…" : "Claim CAFE")
                        </button>
                        @if (_solanaFaucetError is not null)
                        {
                            <p class="yield-faucet-cafe__desc" role="alert">@_solanaFaucetError</p>
                        }
                        else if (_solanaFaucetMessage is not null)
                        {
                            <p class="yield-faucet-cafe__desc">
                                @_solanaFaucetMessage
                                @if (_solanaFaucetExplorerUrl is not null)
                                {
                                    <a href="@_solanaFaucetExplorerUrl" target="_blank" rel="noopener noreferrer">View transaction</a>
                                }
                            </p>
                        }
                    }
                    else
                    {
                        <button type="button"
                                class="yield-cta-btn yield-cta-btn--dark btn-claim-cafe-faucet"
                                disabled="@(!_faucetStatus.CanClaim)">
                            Claim CAFE
                        </button>
                        @if (_activeTx?.Flow == "cafe-faucet")
                        {
                            <TxStepper Flow="_activeTx" ExplorerUrl="@_chain.ExplorerUrl" OnDismiss="DismissTx" />
                        }
                    }
                </section>
            }

            <details class="yield-faucet" open="@ShouldExpandFaucet">
                <summary class="yield-faucet__summary">
                    <span class="yield-faucet__summary-label">Need test ETH for gas?</span>
                    @if (ShouldExpandFaucet)
                    {
                        <span class="yield-faucet__summary-flag">Balance low</span>
                    }
                    <span class="yield-faucet__summary-chevron" aria-hidden="true">▾</span>
                </summary>
                <FaucetPanel Address="@_dashboard.WalletAddress"
                             NetworkName="@_chain.NetworkName"
                             ExplorerUrl="@_chain.ExplorerUrl"
                             Family="@SelectedChain.Family"
                             Compact="true"
                             OnRefreshRequested="LoadDashboardAsync" />
            </details>

            @if (_stakingConfigured || _legacyExitConfigured)
            {
            <section class="yield-allocation-grid" aria-label="Legacy staking actions">

                <article class="yield-asset-card">
                    <div class="yield-card-visual yield-card-visual--espresso">
                        <span class="yield-card-tag">Stake</span>
                    </div>
                    <div class="yield-card-body">
                        <p class="yield-card-eyebrow">Brewing Pool Deposit</p>
                        <h2>Stake Tokens</h2>
                        <p class="yield-card-desc">Lock payment tokens into the pool to earn freshly roasted COFFEE rewards on your deposit.</p>
                        <p class="yield-card-balance">Available <strong class="tabular">@FormatAmount(_dashboard.PaymentTokenBalance) CAFE</strong></p>
                        <div class="yield-card-footer">
                            <div class="yield-input-group">
                                <input id="stake-amount"
                                       class="yield-token-input tabular"
                                       type="number"
                                       min="0"
                                       step="0.0001"
                                       placeholder="0.0"
                                       disabled="@(!_stakingConfigured)" />
                                <button type="button"
                                        class="yield-max-btn"
                                        data-max="@FormatAmount(_dashboard.PaymentTokenBalance)"
                                        data-target="stake-amount"
                                        disabled="@(!_stakingConfigured)">MAX</button>
                            </div>
                            <button type="button"
                                    class="yield-cta-btn yield-cta-btn--dark btn-stake-token"
                                    disabled="@(!_stakingConfigured)">
                                Confirm Stake
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_stakeInputError))
                        {
                            <p class="yield-input-error">@_stakeInputError</p>
                        }
                        @if (_activeTx?.Flow == "stake")
                        {
                            <TxStepper Flow="_activeTx" ExplorerUrl="@_chain.ExplorerUrl" OnDismiss="DismissTx" />
                        }
                    </div>
                </article>

                <article class="yield-asset-card">
                    <div class="yield-card-visual yield-card-visual--reserve">
                        <span class="yield-card-tag">Unstake</span>
                    </div>
                    <div class="yield-card-body">
                        <p class="yield-card-eyebrow">Principal Withdrawal</p>
                        <h2>Unstake Principal</h2>
                        <p class="yield-card-desc">Withdraw your staked principal back to your wallet whenever you are ready.</p>
                        <p class="yield-card-balance">Staked <strong class="tabular">@FormatAmount(_dashboard.StakedPaymentTokenBalance) CAFE</strong></p>
                        <div class="yield-card-footer">
                            <div class="yield-input-group">
                                <input id="unstake-amount"
                                       class="yield-token-input tabular"
                                       type="number"
                                       min="0"
                                       step="0.0001"
                                       max="@FormatAmount(_dashboard.StakedPaymentTokenBalance)"
                                       placeholder="0.0"
                                       disabled="@(!_legacyExitConfigured || _dashboard.StakedPaymentTokenBalance <= 0m)" />
                                <button type="button"
                                        class="yield-max-btn"
                                        data-max="@FormatAmount(_dashboard.StakedPaymentTokenBalance)"
                                        data-target="unstake-amount"
                                        disabled="@(!_legacyExitConfigured || _dashboard.StakedPaymentTokenBalance <= 0m)">MAX</button>
                            </div>
                            <button type="button"
                                    class="yield-cta-btn yield-cta-btn--outline btn-unstake-token"
                                    disabled="@(!_legacyExitConfigured || _dashboard.StakedPaymentTokenBalance <= 0m)">
                                Unstake Now
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_unstakeInputError))
                        {
                            <p class="yield-input-error">@_unstakeInputError</p>
                        }
                        @if (_activeTx?.Flow == "unstake")
                        {
                            <TxStepper Flow="_activeTx" ExplorerUrl="@_chain.ExplorerUrl" OnDismiss="DismissTx" />
                        }
                    </div>
                </article>

                @if (_dashboard.ClaimSupported)
                {
                    <article class="yield-asset-card">
                        <div class="yield-card-visual yield-card-visual--espresso">
                            <span class="yield-card-tag">Claim</span>
                        </div>
                        <div class="yield-card-body">
                            <p class="yield-card-eyebrow">Reward Payout</p>
                            <h2>Claim Rewards</h2>
                            <p class="yield-card-desc">Send your accrued COFFEE rewards from the pool to your wallet.</p>
                            <p class="yield-card-balance">Pending <strong class="tabular">@FormatPendingRewardsWithSuffix()</strong></p>
                            <div class="yield-card-footer">
                                <button type="button"
                                        class="yield-cta-btn yield-cta-btn--dark btn-claim-token"
                                        data-claim-function="@_dashboard.ClaimFunctionName"
                                        disabled="@(_dashboard.PendingStakingRewards is null or <= 0m)">
                                    Claim Rewards
                                </button>
                            </div>
                            @if (_activeTx?.Flow == "claim")
                            {
                                <TxStepper Flow="_activeTx" ExplorerUrl="@_chain.ExplorerUrl" OnDismiss="DismissTx" />
                            }
                        </div>
                    </article>
                }

            </section>
            }

            <section class="yield-activity" aria-labelledby="yield-activity-title">
                <h2 id="yield-activity-title" class="yield-activity-heading">Recent Activity</h2>
                @if (_stakingLedger.Count == 0)
                {
                    <p class="yield-empty-note">No verified staking transactions are linked to this wallet yet.</p>
                }
                else
                {
                    <div class="yield-activity-list">
                        @foreach (var entry in _stakingLedger)
                        {
                            <div class="yield-activity-row">
                                <div class="yield-activity-icon @(entry.ActionType.Equals("unstake", StringComparison.OrdinalIgnoreCase) ? "yield-activity-icon--out" : "yield-activity-icon--in")">
                                    @if (entry.ActionType.Equals("unstake", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <svg aria-hidden="true" viewBox="0 0 24 24">
                                            <path d="M20 12v10H4V12M22 7H2v5h20V7zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg aria-hidden="true" viewBox="0 0 24 24">
                                            <path d="M12 5v14M5 12h14" />
                                        </svg>
                                    }
                                </div>
                                <div class="yield-activity-meta">
                                    <span class="yield-activity-label">@entry.DisplayName</span>
                                    <time class="yield-activity-time" datetime="@entry.RecordedAtUtc.ToString("O")">
                                        @entry.RecordedAtUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                                    </time>
                                </div>
                                <span class="yield-activity-line"></span>
                                <strong class="yield-activity-amount @(entry.ActionType.Equals("unstake", StringComparison.OrdinalIgnoreCase) ? "yield-activity-amount--neg" : "yield-activity-amount--pos")">
                                    @entry.AmountPrefix@FormatAmount(entry.Amount)
                                </strong>
                                <span class="yield-confirmed-tag">Confirmed</span>
                                @if (!string.IsNullOrWhiteSpace(entry.ExplorerUrl))
                                {
                                    <a class="yield-activity-tx" href="@entry.ExplorerUrl" target="_blank" rel="noopener noreferrer">Tx ↗</a>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback OnBackToProfile { get; set; }

    private const decimal LowGasThresholdEth = 0.005m;

    private CoffeeDashboardModel _dashboard = new();
    private IReadOnlyList<StakingLedgerItem> _stakingLedger = [];
    private BlockchainNetworkOptions _chain = new();
    private ChainDefinition SelectedChain => SelectedChainAccessor.SelectedChain;
    private LiquidStakingDashboard _liquidDashboard = new();
    private bool _isLoading = true;
    private bool _isConnected;
    private bool _isConnecting;
    private bool _stakingConfigured;
    private bool _legacyExitConfigured;
    private bool _cafeFaucetConfigured;
    private bool _isSolanaFaucet;
    private bool _solanaFaucetClaiming;
    private string? _solanaFaucetMessage;
    private string? _solanaFaucetError;
    private string? _solanaFaucetExplorerUrl;
    private CafeFaucetStatus _faucetStatus = new();
    private string? _connectError;
    private string? _dashboardError;
    private decimal? _ethUsdPrice;
    private bool _dashboardLoadStarted;
    private bool _jsInitialized;
    private IJSObjectReference? _stakingModule;
    private IJSObjectReference? _liquidModule;
    private IJSObjectReference? _solanaLiquidModule;
    private DotNetObjectReference<YieldPanel>? _selfRef;
    private TxStepper.Model? _activeTx;
    private string? _stakeInputError;
    private string? _unstakeInputError;



    protected override async Task OnInitializedAsync()
    {
        _chain = ChainOptions.Value;
        ApplySelectedChainConfiguration();

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChangedAsync;
        await ApplyResolvedWalletAsync();
    }

    private async Task ApplyResolvedWalletAsync()
    {
        var wallet = await ResolveWalletAddressAsync();
        var wasConnected = _isConnected;
        _isConnected = !string.IsNullOrWhiteSpace(wallet);
        _dashboard = new CoffeeDashboardModel { WalletAddress = wallet ?? string.Empty };

        if (_isConnected && (!wasConnected || _isLoading))
        {
            _isLoading = true;
            _jsInitialized = false;
        }
        else if (!_isConnected)
        {
            _isLoading = false;
        }
    }

    private async void OnAuthenticationStateChangedAsync(Task<AuthenticationState> authenticationStateTask)
    {
        try
        {
            await authenticationStateTask;
            if (_isConnected)
            {
                return;
            }

            await ApplyResolvedWalletAsync();
            if (_isConnected)
            {
                await InvokeAsync(StateHasChanged);
                await LoadDashboardAsync();
            }
        }
        catch
        {
            // Ignore auth revalidation failures during circuit teardown.
        }
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {


        if (_isConnected && _isLoading && !_dashboardLoadStarted)
        {
            await LoadDashboardAsync();
            return;
        }

        if (!_isConnected || (!_stakingConfigured && !_cafeFaucetConfigured && !_liquidDashboard.IsConfigured) || _jsInitialized)
        {
            return;
        }

        _selfRef ??= DotNetObjectReference.Create(this);

        if (_stakingConfigured || _cafeFaucetConfigured)
        {
            _stakingModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "/js/coffeeStaking.js");

            await _stakingModule.InvokeVoidAsync(
                "initCoffeePurchases",
                new
                {
                    marketplaceWallet = _chain.MarketplaceWallet,
                    paymentTokenContract = _chain.EffectivePaymentTokenContract,
                    stakingPoolContract = _chain.StakingPoolContract,
                    cafeFaucetContract = _chain.CafeFaucetContract,
                    expectedWalletAddress = _dashboard.WalletAddress,
                    stakedTokenBalance = _dashboard.StakedPaymentTokenBalance,
                    chainId = _chain.ChainId,
                    chainIdHex = _chain.ChainIdHex,
                    networkName = _chain.NetworkName,
                    rpcUrl = _chain.RpcUrl,
                    currencyName = _chain.CurrencyName,
                    currencySymbol = _chain.CurrencySymbol,
                    currencyDecimals = _chain.CurrencyDecimals,
                    explorerUrl = _chain.ExplorerUrl
                },
                _selfRef);
        }

        if (SelectedChain.Family == ChainFamily.Evm && _liquidDashboard.IsConfigured)
        {
            _liquidModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/liquidStaking.js");
            await _liquidModule.InvokeVoidAsync("initLiquidStaking", new
            {
                chainKey = SelectedChain.Key,
                chainId = SelectedChain.EvmChainId,
                chainIdHex = SelectedChain.EvmChainIdHex,
                networkName = SelectedChain.DisplayName,
                rpcUrl = SelectedChain.PublicRpcUrl,
                currencyName = SelectedChain.NativeCurrencyName,
                currencySymbol = SelectedChain.NativeCurrencySymbol,
                currencyDecimals = SelectedChain.NativeCurrencyDecimals,
                explorerUrl = SelectedChain.ExplorerTransactionTemplate.Replace("{0}", string.Empty),
                cafeContract = SelectedChain.Deployment.Cafe,
                vaultContract = SelectedChain.Deployment.LiquidVault,
                expectedWalletAddress = _dashboard.WalletAddress
            }, _selfRef);
        }
        else if (SelectedChain.Family == ChainFamily.Solana && _liquidDashboard.IsConfigured)
        {
            _solanaLiquidModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/solanaLiquidStaking.js");
            await _solanaLiquidModule.InvokeVoidAsync("initSolanaLiquidStaking", new
            {
                chainKey = SelectedChain.Key,
                cluster = SelectedChain.SolanaCluster,
                rpcUrl = SelectedChain.PublicRpcUrl,
                program = SelectedChain.Deployment.Program,
                vaultPda = SelectedChain.Deployment.VaultPda,
                cafeMint = SelectedChain.Deployment.Cafe,
                stCafeMint = SelectedChain.Deployment.StCafe,
                coffeeMint = SelectedChain.Deployment.Coffee,
                cafeCustody = SelectedChain.Deployment.CafeCustody,
                coffeeCustody = SelectedChain.Deployment.CoffeeCustody,
                token2022Program = SelectedChain.Deployment.Token2022Program,
                cafeDecimals = SelectedChain.Deployment.CafeDecimals,
                stCafeDecimals = SelectedChain.Deployment.StCafeDecimals,
                coffeeDecimals = SelectedChain.Deployment.CoffeeDecimals,
                expectedWalletAddress = _dashboard.WalletAddress
            }, _selfRef);
        }

        _jsInitialized = true;
    }

    [JSInvokable]
    public async Task OnTxStatusChanged(string flow, string step, string status, string? txHash, string? message)
    {
        if (step == "validate")
        {
            SetInputError(flow, message ?? "Enter a valid amount.");
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (flow is not ("stake" or "unstake" or "claim" or "cafe-faucet" or "deposit" or "redeem"))
        {
            return;
        }

        if (_activeTx is null || _activeTx.Flow != flow || _activeTx.IsFinished)
        {
            _activeTx = TxStepper.Model.Create(flow);
        }

        SetInputError(flow, null);
        _activeTx.Apply(step, status, txHash, message);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnTxCompleted(string flow)
    {
        if (_activeTx?.Flow == flow)
        {
            _activeTx.Completed = true;
        }

        await InvokeAsync(LoadDashboardAsync);
    }

    private void DismissTx()
    {
        _activeTx = null;
    }

    private void SetInputError(string flow, string? message)
    {
        if (flow == "unstake")
        {
            _unstakeInputError = message;
        }
        else if (flow == "stake")
        {
            _stakeInputError = message;
        }
    }

    private async Task LoadDashboardAsync()
    {
        if (string.IsNullOrWhiteSpace(_dashboard.WalletAddress))
        {
            _isLoading = false;
            _dashboardError = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _dashboardLoadStarted = true;
        _isLoading = true;
        _dashboardError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(12));
            var ethUsdPriceTask = EthUsdPriceService.GetEthUsdPriceAsync(timeout.Token);
            var faucetStatusTask = _cafeFaucetConfigured
                ? Web3Service.GetCafeFaucetStatusAsync(_dashboard.WalletAddress, timeout.Token)
                : _isSolanaFaucet
                    ? SolanaFaucet.GetStatusAsync(SelectedChain.Key, _dashboard.WalletAddress, timeout.Token)
                    : Task.FromResult(new CafeFaucetStatus());

            if (SelectedChain.Key == "ethereum-sepolia")
            {
                // Keep the legacy Sepolia reads available during migration.
                _dashboard = await Web3Service.GetDashboardDataAsync(_dashboard.WalletAddress, timeout.Token);
                await LoadStakingLedgerAsync(timeout.Token);
            }
            else
            {
                // Never display Sepolia data under another selected chain.
                _dashboard = new CoffeeDashboardModel { WalletAddress = _dashboard.WalletAddress };
                _stakingLedger = [];
            }

            _liquidDashboard = await LiquidGateway.GetDashboardAsync(SelectedChain.Key, _dashboard.WalletAddress, timeout.Token);
            _ethUsdPrice = await ethUsdPriceTask.WaitAsync(timeout.Token);
            _faucetStatus = await faucetStatusTask.WaitAsync(timeout.Token);
            DashboardState.Publish(SelectedChain.Key, SelectedChain.FamilyName, _dashboard.WalletAddress, _dashboard);
        }
        catch (OperationCanceledException)
        {
            _dashboardError = "The configured RPC request timed out. Check the configured RPC URL and try again.";
        }
        catch (Exception ex)
        {
            _dashboardError = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _dashboardLoadStarted = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleChainChangedAsync(ChainDefinition chain)
    {
        ApplySelectedChainConfiguration();
        _dashboardLoadStarted = false;
        _jsInitialized = false;
        _dashboard = new CoffeeDashboardModel { WalletAddress = _dashboard.WalletAddress };
        await InvokeAsync(StateHasChanged);
        if (_isConnected)
        {
            await LoadDashboardAsync();
        }
    }

    private void ApplySelectedChainConfiguration()
    {
        // The historical singleton configuration is intentionally used only by
        // the legacy Sepolia read/exit path. It must never re-enable new pool
        // deposits after the liquid-vault migration.
        _stakingConfigured = SelectedChain.Key == "ethereum-sepolia" &&
            SelectedChain.Capabilities.LiquidStaking &&
            WalletAddressRules.IsConfiguredAddress(SelectedChain.Deployment.LiquidVault);
        _legacyExitConfigured = SelectedChain.Key == "ethereum-sepolia" && SelectedChain.Capabilities.LegacyExit &&
            WalletAddressRules.IsConfiguredAddress(_chain.StakingPoolContract);

        // The existing EVM faucet adapter (client-side contract call via coffeeStaking.js) is
        // Sepolia-specific until a chain-specific faucet adapter is configured; do not advertise it on
        // other EVM chains.
        _cafeFaucetConfigured = SelectedChain.Key == "ethereum-sepolia" &&
            SelectedChain.Capabilities.Faucet &&
            WalletAddressRules.IsConfiguredAddress(_chain.CafeFaucetContract);

        // The Solana faucet is a server-side authorized mint (no client contract call); the server, not
        // the browser, decides eligibility from the registry capability. Actual claimability still
        // depends on the mint-authority secret being configured, resolved in the status load.
        _isSolanaFaucet = SelectedChain.Family == ChainFamily.Solana && SelectedChain.Capabilities.Faucet;
        _solanaFaucetMessage = null;
        _solanaFaucetError = null;
        _solanaFaucetExplorerUrl = null;
    }

    private async Task<string?> ResolveWalletAddressAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            var fromClaim = principal.FindFirst("wallet_address")?.Value
                ?? TryGetWalletFromPrincipalName(principal);
            if (TryNormalizeSelectedWallet(fromClaim, out var claimWallet))
            {
                SyncWalletSession(claimWallet);
                return claimWallet;
            }

            var user = await UserManager.GetUserAsync(principal);
            if (TryNormalizeSelectedWallet(user?.WalletAddress, out var userWallet))
            {
                SyncWalletSession(userWallet);
                return userWallet;
            }
        }

        var sessionWallet = HttpContextAccessor.HttpContext?.Session.GetString("WalletAddress");
        return TryNormalizeSelectedWallet(sessionWallet, out var normalizedSession)
            ? normalizedSession
            : null;
    }

    private bool TryNormalizeSelectedWallet(string? value, out string wallet)
    {
        if (SelectedChain.Family == ChainFamily.Solana)
        {
            wallet = value?.Trim() ?? string.Empty;
            return SolanaBase58.IsPublicKey(wallet);
        }
        return WalletAddressRules.TryNormalizeWallet(value, out wallet);
    }

    private async Task<bool> IsWalletAuthenticatedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        if (principal.Identity?.IsAuthenticated != true)
        {
            return false;
        }

        var claimWallet = principal.FindFirst("wallet_address")?.Value ?? TryGetWalletFromPrincipalName(principal);
        if (TryNormalizeSelectedWallet(claimWallet, out _))
        {
            return true;
        }

        var user = await UserManager.GetUserAsync(principal);
        return TryNormalizeSelectedWallet(user?.WalletAddress, out _);
    }

    private void SyncWalletSession(string wallet)
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            return;
        }

        var existing = httpContext.Session.GetString("WalletAddress");
        if (string.Equals(existing, wallet, SelectedChain.Family == ChainFamily.Solana ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        httpContext.Session.SetString("WalletAddress", wallet);
    }

    private static string? TryGetWalletFromPrincipalName(ClaimsPrincipal principal)
    {
        var name = principal.Identity?.Name;
        return IsValidEthereumAddress(name) ? name : null;
    }

    private static bool IsValidEthereumAddress(string? address) =>
        !string.IsNullOrWhiteSpace(address) &&
        AddressUtil.Current.IsValidEthereumAddressHexFormat(address);

    private async Task ConnectWalletAsync()
    {
        _isConnecting = true;
        _connectError = null;

        try
        {
            if (SelectedChain.Family == ChainFamily.Solana)
            {
                var solanaModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/solanaWalletAuth.js");
                var login = await solanaModule.InvokeAsync<SolanaLoginResult>("loginWithWallet");
                if (!login.Success) throw new InvalidOperationException(login.Error ?? "Solana wallet login failed.");
                _isConnected = !string.IsNullOrWhiteSpace(login.Address);
                if (_isConnected)
                {
                    _dashboard = new CoffeeDashboardModel { WalletAddress = login.Address! };
                    _jsInitialized = false;
                    await LoadDashboardAsync();
                }
                return;
            }

            _stakingModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "/js/coffeeStaking.js");

            var isWalletAuthenticated = await IsWalletAuthenticatedAsync();
            var wallet = await _stakingModule.InvokeAsync<string>(
                "connectWalletForStaking",
                new
                {
                    chainId = _chain.ChainId,
                    chainIdHex = _chain.ChainIdHex,
                    networkName = _chain.NetworkName,
                    rpcUrl = _chain.RpcUrl,
                    currencyName = _chain.CurrencyName,
                    currencySymbol = _chain.CurrencySymbol,
                    currencyDecimals = _chain.CurrencyDecimals,
                    explorerUrl = _chain.ExplorerUrl,
                    isWalletAuthenticated
                });
            _isConnected = !string.IsNullOrWhiteSpace(wallet);
            if (_isConnected)
            {
                _dashboard = new CoffeeDashboardModel { WalletAddress = wallet };
                _jsInitialized = false;
                await LoadDashboardAsync();
            }
        }
        catch (Exception ex)
        {
            _connectError = ex.Message;
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private sealed record SolanaLoginResult(bool Success, string? Address, string? Error);

    private async Task LoadStakingLedgerAsync(CancellationToken cancellationToken)
    {
        _stakingLedger = [];

        if (string.IsNullOrWhiteSpace(_dashboard.WalletAddress))
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync(cancellationToken);
        _stakingLedger = await dbContext.StakingLedgerEntries
            .AsNoTracking()
            .Where(entry => entry.WalletAddress == _dashboard.WalletAddress)
            .OrderByDescending(entry => entry.RecordedAtUtc)
            .Take(8)
            .Select(entry => new StakingLedgerItem(
                entry.RecordedAtUtc,
                entry.ActionType,
                entry.Amount,
                entry.ExplorerUrl))
            .ToListAsync(cancellationToken);
    }

    private static string ShortAddress(string address) =>
        string.IsNullOrWhiteSpace(address) || address.Length < 10
            ? address
            : $"{address[..6]}...{address[^4..]}";

    private static string FormatAmount(decimal value) => value.ToString("0.####");

    private string FormatDashboardAmount(decimal value, string suffix = "") =>
        _isLoading ? "Syncing..." : $"{FormatAmount(value)}{suffix}";

    private string FormatPendingRewards() => _dashboard.PendingStakingRewards switch
    {
        _ when _isLoading => "Syncing...",
        null => "—",
        var value => FormatAmount(value.Value)
    };

    private string FormatPendingRewardsWithSuffix() => _dashboard.PendingStakingRewards switch
    {
        _ when _isLoading => "Syncing...",
        null => "—",
        var value => $"{FormatAmount(value.Value)} COFFEE"
    };

    private EventCallback PendingRewardsRetryCallback =>
        _dashboard.PendingStakingRewards is null
            ? EventCallback.Factory.Create(this, LoadDashboardAsync)
            : default;

    private string FormatApr() => _isLoading ? "..." : $"+{_dashboard.CurrentApr:0.0}%";

    private string AprLabel() =>
        _isLoading || _dashboard.AprIsContractDerived
            ? "Contract Annual Yield"
            : "Indicative Annual Yield (configured, not contract-enforced)";

    private async Task ClaimSolanaFaucetAsync()
    {
        if (!_isSolanaFaucet || _solanaFaucetClaiming || string.IsNullOrWhiteSpace(_dashboard.WalletAddress))
        {
            return;
        }

        _solanaFaucetClaiming = true;
        _solanaFaucetError = null;
        _solanaFaucetMessage = null;
        _solanaFaucetExplorerUrl = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await SolanaFaucet.ClaimAsync(SelectedChain.Key, _dashboard.WalletAddress);
            if (result.Success)
            {
                _solanaFaucetMessage = $"Minted {FormatAmount(result.Amount)} CAFE to your wallet.";
                _solanaFaucetExplorerUrl = result.ExplorerUrl;
            }
            else
            {
                _solanaFaucetError = result.Error ?? "The CAFE faucet claim could not be completed.";
            }

            _faucetStatus = await SolanaFaucet.GetStatusAsync(SelectedChain.Key, _dashboard.WalletAddress);
        }
        catch (Exception ex)
        {
            _solanaFaucetError = ex.Message;
        }
        finally
        {
            _solanaFaucetClaiming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FaucetStatusLabel()
    {
        if (_isLoading)
        {
            return "Syncing...";
        }

        if (!_faucetStatus.IsConfigured)
        {
            return "Faucet not deployed yet.";
        }

        if (_faucetStatus.FaucetBalance < _faucetStatus.ClaimAmount)
        {
            return "Faucet is empty right now. Check back later.";
        }

        if (_faucetStatus.CanClaim)
        {
            return "Available now — claim straight to your wallet.";
        }

        if (_faucetStatus.NextClaimAtUtc is { } nextClaimAtUtc)
        {
            var remaining = nextClaimAtUtc - DateTime.UtcNow;
            return remaining <= TimeSpan.Zero
                ? "Available now — claim straight to your wallet."
                : $"Next claim in {FormatRemaining(remaining)}.";
        }

        return "Not available right now.";
    }

    private static string FormatRemaining(TimeSpan remaining) =>
        remaining.TotalHours >= 1
            ? $"{(int)remaining.TotalHours}h {remaining.Minutes}m"
            : $"{Math.Max(1, (int)remaining.TotalMinutes)}m";

    private bool ShouldExpandFaucet =>
        !_isLoading && string.IsNullOrWhiteSpace(_dashboardError) && _dashboard.NativeBalance < LowGasThresholdEth;

    private string? NativeBalanceUsdHint()
    {
        if (_ethUsdPrice is null)
        {
            return null;
        }

        var estimatedUsd = _dashboard.NativeBalance * _ethUsdPrice.Value;
        return $"≈ {estimatedUsd:$#,##0.00}";
    }

    private string FormatNativeWalletBalance()
    {
        if (_isLoading)
        {
            return "Syncing...";
        }

        if (_ethUsdPrice is null)
        {
            return $"{FormatAmount(_dashboard.NativeBalance)} {_chain.CurrencySymbol}";
        }

        var estimatedUsd = _dashboard.NativeBalance * _ethUsdPrice.Value;
        return $"{estimatedUsd:$#,##0.00}";
    }

    private sealed record StakingLedgerItem(
        DateTime RecordedAtUtc,
        string ActionType,
        decimal Amount,
        string ExplorerUrl)
    {
        public string DisplayName => ActionType.ToLowerInvariant() switch
        {
            "unstake" => "Unstaked",
            "claim" => "Claimed",
            _ => "Staked"
        };

        public string AmountPrefix => ActionType.Equals("unstake", StringComparison.OrdinalIgnoreCase)
            ? "-"
            : "+";
    }

    public async ValueTask DisposeAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChangedAsync;

        _selfRef?.Dispose();

        if (_stakingModule is not null)
        {
            try
            {
                await _stakingModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit can disconnect before module disposal during hot reload or navigation.
            }
        }

        if (_liquidModule is not null)
        {
            try
            {
                await _liquidModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_solanaLiquidModule is not null)
        {
            try
            {
                await _solanaLiquidModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
