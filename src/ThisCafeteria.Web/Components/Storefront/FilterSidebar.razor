@* Filter sidebar: sort order, category list with counts, price range. *@
<aside class="w-full shrink-0 self-start rounded-2xl bg-white p-5 shadow-sm lg:w-[260px] lg:min-h-[calc(100vh-6rem)]">
    <h2 class="text-lg font-semibold text-ink">Filters</h2>

    <div class="mt-4">
        <label for="filter-sort" class="text-sm text-mute">Sort by:</label>
        <select id="filter-sort"
                class="mt-1.5 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
                value="@Sort"
                @onchange="args => SortChanged.InvokeAsync(args.Value?.ToString() ?? SortDefault)">
            <option value="@SortDefault">Default</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="rating">Top rated</option>
        </select>
    </div>

    <ul class="mt-5 space-y-1 border-t border-line pt-4">
        @foreach (var category in Categories)
        {
            var isSelected = category.Key == SelectedCategory;
            <li>
                <button type="button"
                        class="flex w-full items-center gap-1.5 rounded-lg px-1 py-1.5 text-left text-[13px] transition-colors hover:text-ink @(isSelected ? "font-semibold text-ink" : "text-mute")"
                        aria-expanded="@isSelected"
                        @onclick="() => SelectedCategoryChanged.InvokeAsync(isSelected ? string.Empty : category.Key)">
                    <span class="flex-1 whitespace-nowrap">@category.Label</span>
                    <span class="rounded-full border border-line px-1.5 py-0.5 text-[11px] leading-none text-mute">@category.Count</span>
                    <LucideIcon Name="@(isSelected ? "chevron-down" : "chevron-right")" Size="14" CssClass="text-mute" />
                </button>
            </li>
        }
    </ul>

    <div class="mt-5 border-t border-line pt-4">
        <button type="button"
                class="flex w-full items-center justify-between text-left"
                aria-expanded="@_priceRangeOpen"
                @onclick="() => _priceRangeOpen = !_priceRangeOpen">
            <h3 class="text-sm font-semibold text-ink">Price range</h3>
            <LucideIcon Name="@(_priceRangeOpen ? "chevron-up" : "chevron-down")" Size="14" CssClass="text-mute" />
        </button>

        @if (_priceRangeOpen)
        {
            <div class="mt-4 rounded-xl border border-line bg-sand/40 p-3">
                <div class="flex items-center gap-2">
                    <label class="flex flex-1 items-center gap-1 rounded-lg border border-line bg-white px-2 py-1.5 transition-colors focus-within:border-accent">
                        <span class="text-xs text-faint">$</span>
                        <input type="number"
                               class="w-full min-w-0 bg-transparent text-sm text-ink focus:outline-none"
                               min="@PriceFloor"
                               max="@MaxPrice"
                               value="@MinPrice"
                               @onchange="args => SetMin(args.Value)" />
                    </label>
                    <span class="text-faint">&mdash;</span>
                    <label class="flex flex-1 items-center gap-1 rounded-lg border border-line bg-white px-2 py-1.5 transition-colors focus-within:border-accent">
                        <span class="text-xs text-faint">$</span>
                        <input type="number"
                               class="w-full min-w-0 bg-transparent text-sm text-ink focus:outline-none"
                               min="@MinPrice"
                               max="@PriceCeiling"
                               value="@MaxPrice"
                               @onchange="args => SetMax(args.Value)" />
                    </label>
                </div>

                <div class="relative mt-5 h-5">
                    <div class="absolute left-0 right-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-line"></div>
                    <div class="absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-accent"
                         style="left: @Percent(MinPrice)%; right: @(100 - Percent(MaxPrice))%;"></div>
                    <input type="range"
                           class="catalog-range"
                           min="@PriceFloor"
                           max="@PriceCeiling"
                           step="1"
                           value="@MinPrice"
                           @oninput="args => SetMin(args.Value)" />
                    <input type="range"
                           class="catalog-range"
                           min="@PriceFloor"
                           max="@PriceCeiling"
                           step="1"
                           value="@MaxPrice"
                           @oninput="args => SetMax(args.Value)" />
                </div>

                <div class="mt-2 flex items-center justify-between text-[11px] text-faint">
                    <span>@PriceFloor.ToString("0")</span>
                    <span>@PriceCeiling.ToString("0")</span>
                </div>
            </div>
        }
    </div>
</aside>

@code {
    public const string SortDefault = "default";

    private bool _priceRangeOpen;

    [Parameter] public string Sort { get; set; } = SortDefault;
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public IReadOnlyList<CatalogCategoryOption> Categories { get; set; } = [];
    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedCategoryChanged { get; set; }
    [Parameter] public decimal MinPrice { get; set; }
    [Parameter] public decimal MaxPrice { get; set; }
    [Parameter] public decimal PriceFloor { get; set; }
    [Parameter] public decimal PriceCeiling { get; set; }
    [Parameter] public EventCallback<decimal> MinPriceChanged { get; set; }
    [Parameter] public EventCallback<decimal> MaxPriceChanged { get; set; }

    private Task SetMin(object? raw) =>
        decimal.TryParse(raw?.ToString(), out var value)
            ? MinPriceChanged.InvokeAsync(Math.Min(value, MaxPrice))
            : Task.CompletedTask;

    private Task SetMax(object? raw) =>
        decimal.TryParse(raw?.ToString(), out var value)
            ? MaxPriceChanged.InvokeAsync(Math.Max(value, MinPrice))
            : Task.CompletedTask;

    private double Percent(decimal value) =>
        PriceCeiling <= PriceFloor
            ? 0
            : (double)((value - PriceFloor) / (PriceCeiling - PriceFloor) * 100m);
}
