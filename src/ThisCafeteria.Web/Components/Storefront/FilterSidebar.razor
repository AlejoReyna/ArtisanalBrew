@* Filter sidebar presented as a thermal-paper market receipt. *@
<aside class="receipt-ticket" aria-labelledby="receipt-filter-title">
    <header class="receipt-ticket__header">
        <p class="receipt-ticket__merchant">Artisanal Brew</p>
        <p class="receipt-ticket__meta">Roastery market · Catalog 001</p>
        <div class="receipt-ticket__rule" aria-hidden="true"></div>
        <h2 id="receipt-filter-title" class="receipt-ticket__title">Filter receipt</h2>
        <p class="receipt-ticket__caption">Curate your market selection</p>
    </header>

    <section class="receipt-ticket__section" aria-labelledby="receipt-sort-label">
        <div class="receipt-ticket__columns" aria-hidden="true">
            <span>Item description</span>
            <span>Selection</span>
        </div>
        <div class="receipt-ticket__sort-row">
            <label id="receipt-sort-label" for="filter-sort">Sort order</label>
            <select id="filter-sort"
                    class="receipt-ticket__select"
                    value="@Sort"
                    @onchange="args => SortChanged.InvokeAsync(args.Value?.ToString() ?? SortDefault)">
                <option value="@SortDefault">Default</option>
                <option value="price-asc">Price: low to high</option>
                <option value="price-desc">Price: high to low</option>
                <option value="rating">Top rated</option>
            </select>
        </div>
    </section>

    <section class="receipt-ticket__section" aria-label="Product categories">
        <div class="receipt-ticket__columns receipt-ticket__columns--categories" aria-hidden="true">
            <span>Qty</span>
            <span>Category</span>
            <span>Pick</span>
        </div>
        <ul class="receipt-ticket__categories">
            @foreach (var category in Categories)
            {
                var isSelected = category.Key == SelectedCategory;
                <li>
                    <button type="button"
                            class="receipt-ticket__category @(isSelected ? "is-selected" : null)"
                            aria-pressed="@isSelected"
                            @onclick="() => SelectedCategoryChanged.InvokeAsync(isSelected ? string.Empty : category.Key)">
                        <span class="receipt-ticket__quantity">@category.Count.ToString("00")</span>
                        <span class="receipt-ticket__category-label">@category.Label</span>
                        <span class="receipt-ticket__checkbox" aria-hidden="true">@(isSelected ? "[x]" : "[ ]")</span>
                    </button>
                </li>
            }
        </ul>
    </section>

    <section class="receipt-ticket__section">
        <button type="button"
                class="receipt-ticket__price-toggle"
                aria-expanded="@_priceRangeOpen"
                aria-controls="receipt-price-controls"
                @onclick="() => _priceRangeOpen = !_priceRangeOpen">
            <span>Price range</span>
            <span class="receipt-ticket__price-summary">
                $@MinPrice.ToString("0")–$@MaxPrice.ToString("0")
                <span class="receipt-ticket__toggle-mark @(_priceRangeOpen ? "is-open" : null)" aria-hidden="true">⌄</span>
            </span>
        </button>

        @if (_priceRangeOpen)
        {
            <div id="receipt-price-controls" class="receipt-ticket__price-controls">
                <div class="receipt-ticket__price-inputs">
                    <label>
                        <span>Min $</span>
                        <input type="number"
                               min="@PriceFloor"
                               max="@MaxPrice"
                               value="@MinPrice"
                               aria-label="Minimum price"
                               @onchange="args => SetMin(args.Value)" />
                    </label>
                    <span aria-hidden="true">—</span>
                    <label>
                        <span>Max $</span>
                        <input type="number"
                               min="@MinPrice"
                               max="@PriceCeiling"
                               value="@MaxPrice"
                               aria-label="Maximum price"
                               @onchange="args => SetMax(args.Value)" />
                    </label>
                </div>

                <div class="receipt-ticket__range">
                    <div class="receipt-ticket__range-track"></div>
                    <div class="receipt-ticket__range-fill"
                         style="left: @Percent(MinPrice)%; right: @(100 - Percent(MaxPrice))%;"></div>
                    <input type="range"
                           class="catalog-range receipt-ticket__range-input"
                           min="@PriceFloor"
                           max="@PriceCeiling"
                           step="1"
                           value="@MinPrice"
                           aria-label="Minimum price"
                           @oninput="args => SetMin(args.Value)" />
                    <input type="range"
                           class="catalog-range receipt-ticket__range-input"
                           min="@PriceFloor"
                           max="@PriceCeiling"
                           step="1"
                           value="@MaxPrice"
                           aria-label="Maximum price"
                           @oninput="args => SetMax(args.Value)" />
                </div>

                <div class="receipt-ticket__range-labels" aria-hidden="true">
                    <span>$@PriceFloor.ToString("0")</span>
                    <span>$@PriceCeiling.ToString("0")</span>
                </div>
            </div>
        }
    </section>

    <div class="receipt-ticket__totals" aria-label="Catalog summary">
        <div>
            <span>Departments</span>
            <span>@Categories.Count.ToString("00")</span>
        </div>
        <div>
            <strong>Available items</strong>
            <strong>@AvailableItemCount.ToString("00")</strong>
        </div>
    </div>

    <footer class="receipt-ticket__footer">
        <p>Thank you</p>
        <span>Freshly roasted · thoughtfully made</span>
        <div class="receipt-ticket__barcode" aria-hidden="true"></div>
        <small>* A B 2 0 2 6 0 0 1 *</small>
    </footer>
</aside>

@code {
    public const string SortDefault = "default";

    private bool _priceRangeOpen;

    [Parameter] public string Sort { get; set; } = SortDefault;
    [Parameter] public EventCallback<string> SortChanged { get; set; }
    [Parameter] public IReadOnlyList<CatalogCategoryOption> Categories { get; set; } = [];
    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedCategoryChanged { get; set; }
    [Parameter] public decimal MinPrice { get; set; }
    [Parameter] public decimal MaxPrice { get; set; }
    [Parameter] public decimal PriceFloor { get; set; }
    [Parameter] public decimal PriceCeiling { get; set; }
    [Parameter] public EventCallback<decimal> MinPriceChanged { get; set; }
    [Parameter] public EventCallback<decimal> MaxPriceChanged { get; set; }

    private int AvailableItemCount => Categories.Sum(category => category.Count);

    private Task SetMin(object? raw) =>
        decimal.TryParse(raw?.ToString(), out var value)
            ? MinPriceChanged.InvokeAsync(Math.Min(value, MaxPrice))
            : Task.CompletedTask;

    private Task SetMax(object? raw) =>
        decimal.TryParse(raw?.ToString(), out var value)
            ? MaxPriceChanged.InvokeAsync(Math.Max(value, MinPrice))
            : Task.CompletedTask;

    private double Percent(decimal value) =>
        PriceCeiling <= PriceFloor
            ? 0
            : (double)((value - PriceFloor) / (PriceCeiling - PriceFloor) * 100m);
}
