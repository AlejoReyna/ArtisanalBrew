<section class="story-tech"
         data-story-tech
         data-theme-color="#ffffff"
         aria-labelledby="story-tech-title">
    <div class="story-tech__sticky">
        <div class="story-tech__chrome">
            <p class="story-tech__eyebrow">The working stack</p>
            <p class="story-tech__counter" aria-hidden="true">
                <span data-story-tech-current>01</span>
                <span class="story-tech__counter-rule"></span>
                <span>02</span>
            </p>
        </div>

        <div class="story-tech__titles">
            <div class="story-tech__title story-tech__title--infra" data-story-tech-title="infra">
                <p class="story-tech__kicker">Nine live resources</p>
                <h2 id="story-tech-title">Built in <em>Azure.</em></h2>
                <p>Compute, data, messaging, storage, secrets, and delivery — moving as one estate.</p>
            </div>

            <div class="story-tech__title story-tech__title--bridge" data-story-tech-title="bridge" aria-hidden="true">
                <p class="story-tech__kicker">One system</p>
                <h2>Cloud meets <em>chain.</em></h2>
            </div>

            <div class="story-tech__title story-tech__title--contracts" data-story-tech-title="contracts">
                <p class="story-tech__kicker">Nine on-chain building blocks</p>
                <h2>Written <em>on-chain.</em></h2>
                <p>Staking, rewards, smart accounts, intents, and agentic settlement across public test networks.</p>
            </div>
        </div>

        <div class="story-tech__layer story-tech__layer--infra" data-story-tech-layer="infra" aria-label="Azure infrastructure">
            @foreach (var service in AzureServices)
            {
                <article class="story-tech__card story-tech__card--azure"
                         data-story-tech-card
                         data-x="@service.X"
                         data-y="@service.Y"
                         data-rotate="@service.Rotate">
                    <div class="story-tech__card-top">
                        <span class="story-tech__icon-shell">
                            <img src="@service.IconPath" alt="" loading="lazy" />
                        </span>
                        <span class="story-tech__status @(service.IsHealthy ? "is-up" : "is-idle")">
                            <span aria-hidden="true"></span>
                            @service.Status
                        </span>
                    </div>
                    <p class="story-tech__meta">@service.Category</p>
                    <h3>@service.Name</h3>
                    <p class="story-tech__detail">@service.Detail</p>
                </article>
            }
        </div>

        <div class="story-tech__layer story-tech__layer--contracts" data-story-tech-layer="contracts" aria-label="Smart contracts and programs">
            @foreach (var contract in SmartContracts)
            {
                <a class="story-tech__card story-tech__card--contract"
                   data-story-tech-card
                   data-x="@contract.X"
                   data-y="@contract.Y"
                   data-rotate="@contract.Rotate"
                   href="@contract.ExplorerUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   tabindex="-1"
                   aria-label="@contract.Name on @contract.Network — open in explorer">
                    <div class="story-tech__card-top">
                        <span class="story-tech__chain-mark" aria-hidden="true">@contract.Mark</span>
                        <span class="story-tech__network">@contract.Network</span>
                        <span class="story-tech__external" aria-hidden="true">↗</span>
                    </div>
                    <p class="story-tech__meta">@contract.Standard</p>
                    <h3>@contract.Name</h3>
                    <p class="story-tech__detail">@contract.Purpose</p>
                </a>
            }
        </div>

        <nav class="story-tech__nav" aria-label="Technology showcase">
            <button type="button" class="is-active" data-story-tech-jump="0">
                <span>01</span>
                Azure estate
            </button>
            <span class="story-tech__nav-track" aria-hidden="true">
                <span data-story-tech-progress></span>
            </span>
            <button type="button" data-story-tech-jump="1">
                <span>02</span>
                Smart contracts
            </button>
        </nav>

        <p class="story-tech__scroll-cue" aria-hidden="true">
            <span></span>
            Scroll to trace the stack
        </p>
    </div>
</section>

@code {
